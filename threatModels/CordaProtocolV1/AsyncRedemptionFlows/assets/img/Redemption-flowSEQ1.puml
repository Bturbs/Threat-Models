@startuml 
' REVIEWED_MAIN_2026_05_14: aligned to AsyncRedemptionFlows boundary including batch redemption and matching.
title Async Redemption Flows - Solana Vault Program

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam wrapWidth 260

actor "Investor\n<<signer>>" as I
actor "Curator\n<<Trusted counterparty>>" as C

box "Solana on-chain" #LightBlue
participant "Vault Program" as V
participant "USDC Vault\n(ATA)" as USDC
participant "RedemptionProposal\n(PDA)" as RPROP
participant "Redemption Snapshot\n(PDA)" as RS
participant "InvestmentProposal\n(PDA)" as IPROP
participant "vToken Vault\n(ATA escrow)" as VESC
participant "Investor USDC\n(ATA)" as IUSDC
participant "Fee Recipient\n(ATA)" as FEE
end box

autonumber

== Solana Tx 1 — Investor creates redemption proposal ==

I -> V : <b>create_redemption_proposal(vtoken_amount, proposal_id)\n[[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/create_redemption_proposal.rs create_redemption_proposal]]
activate V

note over V
  CHECK: !vault.redemptions_paused
  CHECK: vtoken_amount > 0
  CHECK: investor_vtoken.amount >= vtoken_amount
  CHECK: whitelist entry exists
end note

note over V
  Oracle is called HERE to estimate expected_usdc_amount\n  (used only for outstanding outbound bookkeeping,\n  NOT the final settlement price).
  expected_usdc_amount = vtokens × live_price
end note

V -> V : Init RedemptionProposal PDA\n[b"redemption", vault, investor, proposal_id]\nstatus = Pending

V -> VESC : transfer_checked(vtoken_amount) to vault escrow ATA
note right of VESC : Investor vTokens moved to escrow\n(not burned at proposal creation)

V -> V : Update vault state
note over V
  add_vtoken_to_redeem(vtoken_amount)
  open_outstanding_outbound(expected_usdc_amount)
  record_last_inbound(now, expected_usdc_amount)
end note

deactivate V

== Optional path A — Curator batch-settles redemptions ==

C -> V : [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/batch_redemption.rs create_redemption_snapshot(snapshot_id)]]
activate V
V -> RS : Create RedemptionSnapshot PDA
deactivate V

C -> V : [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/batch_redemption.rs add_to_snapshot(...)]]
activate V
V -> RS : Accumulate pending and unmatched proposals
V -> RPROP : Read Pending and un-matched proposal amounts
deactivate V

note over C,RS #pink
  THREAT: RD_SNAPSHOT_ADMISSION_RACE

  A proposal admitted with matched_vtokens == 0 can be partially matched
  later before settle_from_snapshot executes.
  Without re-validation at settle time, payout assumptions can drift.
end note

C -> V : [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/batch_redemption.rs seal_snapshot(...)]]
activate V
note over V
  Freezes proposal membership only.
  No price/totals frozen at seal time.
  sealed = true
end note
V -> RS : sealed = true
deactivate V

C -> V : [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/batch_redemption.rs set_redemption_snapshot_totals(total_gross_usdc)]]
activate V
note over V
  Caller supplies total_gross_usdc.
  Program derives implied_price from
  (total_gross_usdc / snapshot.total_vtokens),
  calls oracle-wrapper and enforces
  check_price_tolerance(implied_price, oracle_price).
  On success: freezes vtoken_price, total_gross,
  total_exit_fee, total_usdc_payout and sets priced = true.
end note
V -> RS : priced totals frozen, priced = true
deactivate V

note over C,RS #lightyellow
  One tx per proposal — called N times.
  settle_from_snapshot requires snapshot.priced == true
  and reads frozen totals set in set_redemption_snapshot_totals.
end note
C -> V : [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/batch_redemption.rs settle_from_snapshot(proposal_X)]]
activate V
note over V
  Proportional share =
    proposal.vtoken_amount / snapshot.total_vtokens
  investor_payout = total_usdc_payout × share
  exit_fee_share  = total_exit_fee × share
end note
V -> IUSDC : Transfer proportional investor payout
V -> FEE : Transfer proportional exit fee
V -> VESC : burn_vtokens(vtoken_amount) from escrow
V -> RS : settled_count++, settled_vtokens += vtoken_amount
V -> V : record_last_outbound, close_outstanding_outbound
note right of V : Proposal PDA closed\n(rent returned to curator)
deactivate V

C -> V : [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/batch_redemption.rs finalize_redemption_snapshot()]]
activate V
note over V
  Required after all proposals settled.\n  sub_vtoken_to_redeem(total_vtokens)\n  Closes snapshot PDA (rent to curator).
end note
V -> V : sub_vtoken_to_redeem(snapshot.total_vtokens)
deactivate V

== Optional path B — Curator nets against async investment ==

C -> V : [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/match_deposit_redemption.rs match_deposit_redemption(usdc_amount)]]
activate V
note over V
  Uses live oracle price OR sealed snapshot price.\n  Redeemer gets USDC from usdc_vault immediately.\n  Depositor gets vTokens released from VESC escrow (no mint).\n  USDC bounded by deposit remaining (usdc_amount - netted_usdc).\n  vTokens bounded by redemption remaining.
end note
V -> IPROP : netted_usdc += matched_usdc
V -> RPROP : matched_vtokens += derived_vtokens
note over V #pink
  THREATS:
  - RD_OUTBOUND_DECREMENT_UNIT_MISMATCH
  - RD_OUTBOUND_OUTSTANDING_DOUBLE_DECREMENT

  Matching can decrement outbound bookkeeping using a basis different
  from proposal expected_outbound, creating drift before final settle.
end note
deactivate V

== Optional path C — Curator cancels fully unmatched proposal ==

C -> V : [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/cancel_redemption_proposal.rs cancel_redemption_proposal()]]
activate V
note over V
  Only allowed while matched_vtokens == 0.\n  Returns ALL escrowed vTokens to investor.\n  Closes proposal PDA (rent to curator).
end note
V -> VESC : transfer_checked(vtoken_amount) back to investor
note right of V : Proposal PDA closed\nnot just status = Cancelled
deactivate V

== Solana Tx N — Curator settles unmatched remainder ==

C -> V : <b>settle_redemption(gross_usdc)\n[[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/settle_redemption.rs settle_redemption]]
activate V

note over V
  CHECK: has_one = curator (signer)
  CHECK: !vault.redemptions_paused
  CHECK: proposal.status == Pending
  CHECK: gross_usdc > 0
end note

note over V
  remaining_vtokens = vtoken_amount - matched_vtokens
  Caller supplies gross_usdc.
  Program derives:
    investor_payout, exit_fee, implied_price
  from gross_usdc and remaining_vtokens,
  then enforces check_price_tolerance against
  live oracle-wrapper price.
  CHECK: usdc_vault.amount >= gross_usdc
end note

V -> USDC : transfer_checked(investor_payout)\nVault PDA signs
USDC -> IUSDC : Investor payout
V -> USDC : transfer_checked(exit_fee)
USDC -> FEE : Exit fee (separate transfer)
V -> VESC : burn_vtokens(remaining_vtokens) from escrow
note right of VESC : matched_vtokens already left escrow\nvia match_deposit_redemption — only\nthe unmatched remainder is burned here

V -> V : record_last_outbound(investor_payout)
V -> V : close_outstanding_outbound(remaining_expected)
V -> V : sub_vtoken_to_redeem(remaining_vtokens)
note over V #pink
  THREAT: RD_OUTBOUND_OUTSTANDING_DOUBLE_DECREMENT

  If partial matching already reduced outbound outstanding,
  settle_redemption must close only the true remaining expected amount.
end note
note right of V : Proposal PDA closed\n(rent returned to curator)

deactivate V

note over V, IUSDC
  **FINAL STATE (settle_redemption path)**
  Investor vTokens: remaining_vtokens burned from escrow
  Investor USDC: +investor_payout
  Vault USDC: -(investor_payout + exit_fee)
  Fee Recipient: +exit_fee
  Proposal PDA: closed (rent to curator)
end note

@enduml
