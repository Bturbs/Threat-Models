@startuml
title Web UI Integrations and Third-Party Services

actor "User" as User

box "R3 Owned" #LightBlue
participant "User Browser" as Browser
participant "Web UI (Next.js)" as WebUI
end box

box "R3 Backend" #LightGreen
participant "Backend API" as Backend
end box

box "Third-Party" #LightYellow
participant "AML Screening Service" as AML
participant "KYC IDV Provider" as KYC
participant "Analytics Service" as Analytics
end box

User -> Browser : Use Web UI
Browser -> WebUI : Load app and submit onboarding
WebUI -> Backend : Submit onboarding intent

WebUI -> AML : <b>DF_WEB_UI_TO_AML
AML --> WebUI : <b>DF_AML_TO_WEB_UI

WebUI -> KYC : <b>DF_WEB_UI_TO_KYC
KYC --> WebUI : <b>DF_KYC_TO_WEB_UI

WebUI -> Analytics : <b>DF_WEB_UI_TO_ANALYTICS

WebUI -> Backend : Submit compliance results
Backend --> WebUI : Decision and next action

@enduml
