        <mxCell id="aRGcAFR6JZkqNKQmyqSA-30" value="&lt;b&gt;High&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;fontFamily=Helvetica;" parent="jsRHmFCptj0i6vtfv6NT-4" vertex="1">
