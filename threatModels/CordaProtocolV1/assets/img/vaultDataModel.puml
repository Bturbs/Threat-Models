@startuml vaultDataModel
' REVIEWED_MAIN_2026_05_18: aligned to RBAC fast-forward 63739244; authority replaces admin/curator, RBAC program added.

!pragma layout smetana
top to bottom direction
scale max 2400 width
skinparam wrapWidth 220

!define INSTRUCTION class
!define EVENT class
!define ACCOUNT class
!define PROGRAM class
!define ACTOR class
!define PDA class

hide circles
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor<<Account>> LightBlue
    BackgroundColor<<AssociatedTokenAccount>> LightCyan
    BackgroundColor<<Instruction>> LightYellow
    BackgroundColor<<Event>> LightGreen
    BackgroundColor<<PDA>> LightCoral
    BackgroundColor<<Program>> LightSalmon
    BackgroundColor<<wallet>> LightGray
    BorderColor Black
}

skinparam package {
    BackgroundColor #f9f9f9
    BorderColor #666666
}

' ========================================
' Actors (stickmen)
' ========================================
allowmixing

actor "Admin" as ActorAdmin
actor "Curator" as ActorCurator
actor "Investor" as ActorInvestor
actor "Manager" as ActorManager

ActorAdmin -[hidden]right-> ActorInvestor
ActorInvestor -[hidden]right-> ActorCurator
ActorCurator -[hidden]right-> ActorManager

ActorAdmin -[hidden]down-> AdminWallet
ActorCurator -[hidden]down-> CuratorWallet
ActorInvestor -[hidden]down-> InvestorWallet
ActorManager -[hidden]down-> ManagerWallet

ActorAdmin --> AdminWallet : owns
ActorCurator --> CuratorWallet : owns
ActorInvestor --> InvestorWallet : owns
ActorManager --> ManagerWallet : owns

' ========================================
' Wallets / Actors
' ========================================

ACTOR AdminWallet <<wallet>> {
    + pubkey: Pubkey
    + privateKey: privateKey
    --
    **Owner:** System Program
    **Note:**
    Manages vault configuration,
    whitelist, and pause/resume.
}

ACTOR CuratorWallet <<wallet>> {
    + pubkey: Pubkey
    + privateKey: privateKey
    --
    **Owner:** System Program
    **Note:**
    Settles investments/redemptions,
    manages tokenizer transfers,
    approves/rejects investment proposals.
}

ACTOR InvestorWallet <<wallet>> {
    + pubkey: Pubkey
    + privateKey: privateKey
    --
    **Owner:** System Program
    **Note:**
    Must be whitelisted to receive
    vTokens. Creates investment and
    redemption proposals.
}

ACTOR ManagerWallet <<wallet>> {
    + pubkey: Pubkey
    + privateKey: privateKey
    --
    **Owner:** System Program
    **Note:**
    Manages liquidity pool deposits,
    withdrawals, and rebalancing.
}

' Layout hints: wallets in a single row
AdminWallet -[hidden]right-> InvestorWallet
InvestorWallet -[hidden]right-> CuratorWallet
CuratorWallet -[hidden]right-> ManagerWallet

' ========================================
' Solana On-Chain Accounts
' ========================================

package "Solana On-Chain Accounts" {

    package "Deployed Programs" {

        PROGRAM VaultProgram <<Program>> [[https://github.com/corda/corda-protocol-mvp/tree/main/programs/vault]] {
            + ID: EMDZftqHQgUkj2WB5zGDsGdShWu2GKG8qkhq8AwwSGxa
            --
            **Core Functions:**
            - Investment proposal creation
            - Redemption proposals
            - Settlement with whitelist checks
            - Oracle-wrapper-backed pricing and settlement fees
            - Whitelist management
            - Snapshot/matching settlement flows
            - Pause/resume and emergency stop
        }

        PROGRAM OracleWrapperProgram <<Program>> [[https://github.com/corda/corda-protocol-mvp/tree/main/programs/oracle_wrapper]] {
            + ID: HExrWEj2rBHut6KJjsRSmP1WxWA1BtVRmSf3FmPcJcob
            --
            **Purpose:**
            Wraps the configured price feed.
            Exposes `fetch_price` with feed,
            decimals, and staleness checks.
        }

        PROGRAM RbacProgram <<Program>> [[https://github.com/corda/corda-protocol-mvp/tree/main/programs/rbac]] {
            + ID: 4nuAcGWtRWa6gTN1kc9jEX5u3HmbbnnZZ9u8wW8FKJPs
            --
            **Purpose:**
            Per-instruction RBAC gateway.
            Holds VaultAuthority PDA with
            permissions[64] table. Verifies
            signer then CPIs into Vault
            with PDA authority seeds.
            Fail-closed (default = uncallable).
        }

        ' PROGRAM LiquidityProgramRemoved <<Program>> {
        '     + ID: AYjrCpUAH2iPsyPykFvQhmPMcReotps8mX4moFY2DDkK (legacy)
        '     --
        '     **Purpose:**
        '     Removed liquidity program.
        '     Kept as legacy reference only.
        '     Removed in commit a85d60c5.
        ' }
    }

    "Deployed Programs" -[hidden]down-> "RBAC Program State"

    package "RBAC Program State" {

    PDA VaultAuthority <<PDA>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/rbac/src/state.rs]] {
        + bump: u8
        + _reserved_flags: [u8; 7]
        + vault: Pubkey
        + admin: Pubkey
        + rent_destination: Pubkey
        + _reserved_pubkeys: [Pubkey; 4]
        + permissions: [Pubkey; 64]
        + _reserved: [u8; 32]
        --
        **Seed:** [b"vault_authority", vault.key()]
        **Owner:** RbacProgram
        **Size:** 2312 bytes (zero-copy, pinned layout)
        **Note:** permissions[disc] = allowed signer.
        Default Pubkey::default() = uncallable (fail-closed).
    }

    }

    "RBAC Program State" -[hidden]down-> "Vault Program State"

    package "Vault Program State" {

    PDA Vault <<PDA>> [[https://github.com/corda/corda-protocol-mvp/blob/main/packages/vault-core/src/state/vault.rs]] {
        + vault_id: u64
        + pending_deposit_usdc: u64
        + pending_offboarded_usdc: u64
        + vtoken_to_redeem: u64
        + min_investment: u64
        + last_inbound_*: last-tx markers
        + last_outbound_*: last-tx markers
        + outstanding_inbound_*: monitoring
        + outstanding_outbound_*: monitoring
        + _reserved_u64: [u64; 16]
        + entry_fee_bps: u16
        + exit_fee_bps: u16
        + _reserved_u16: [u16; 8]
        + bump: u8
        + deposits_paused: u8
        + redemptions_paused: u8
        + emergency_stop: u8
        + _reserved_flags: [u8; 16]
        + authority: Pubkey
        + compliance_authority: Pubkey
        + usdc_mint: Pubkey
        + vtoken_mint: Pubkey
        + usdc_vault: Pubkey
        + vtoken_vault: Pubkey
        + fee_recipient: Pubkey
        + offboard_destination: Pubkey
        + oracle_wrapper_program: Pubkey
        + vtoken_oracle_wrapper_config: Pubkey
        + vtoken_price_feed: Pubkey
        + _reserved_pubkeys: [Pubkey; 8]
        + _reserved: [u8; 272]
        --
        **Seed:** [b"vault", vault_id.to_le_bytes()]
        **Owner:** VaultProgram
        **Size:** 1152 bytes (zero-copy, pinned layout)
        **Note:** authority = RBAC VaultAuthority PDA.
        No on-chain AUM/TVL field; price from oracle only.
    }

    PDA VaultWhitelistEntry <<PDA>> [[https://github.com/corda/corda-protocol-mvp/blob/main/packages/vault-core/src/state/whitelist.rs]] {
        --
        **Zero-data marker PDA.**
        Existence = whitelisted. No fields.
        **Seed:** [b"vault_whitelist_entry", vtoken_mint, investor]
        **Owner:** VaultProgram
        **Note:** Created by AddToVtokenWhitelist;
        closed (deleted) by RemoveFromVtokenWhitelist.
    }

    PDA InvestmentProposal <<PDA>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/state/investment_proposal.rs]] {
        + bump: u8
        + vault: Pubkey
        + investor: Pubkey
        + usdc_amount: u64
        + created_at: i64
        + updated_at: i64
        + status: ProposalStatus
        + proposal_id: u64
        + netted_usdc: u64
        + _reserved: Vec<u8>
        --
        **Seed:** [b"investment_proposal", vault, investor, proposal_id]
        **Status:** Pending → Accepted/Rejected → Settled/Cancelled/Expired
        **Owner:** VaultProgram
        **Note:** Requires curator approval
    }

    PDA RedemptionProposal <<PDA>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/state/redemption_proposal.rs]] {
        + bump: u8
        + vault: Pubkey
        + investor: Pubkey
        + vtoken_amount: u64
        + expected_usdc_amount: u64
        + created_at: i64
        + updated_at: i64
        + status: ProposalStatus
        + proposal_id: u64
        + matched_vtokens: u64
        --
        + _reserved: Vec<u8>
        --
        **Seed:** [b"redemption_proposal", vault, investor, proposal_id]
        **Status:** Pending → Cancelled/Settled
        **Owner:** VaultProgram
        **Note:** vTokens escrowed at creation; settled or cancelled later
    }

    PDA DepositSnapshot <<PDA>> [[https://github.com/corda/corda-protocol-mvp/blob/main/packages/vault-core/src/state/deposit_snapshot.rs]] {
        + bump: u8
        + vault: Pubkey
        + snapshot_id: u64
        + vtoken_price: u64
        + total_usdc: u64
        + settled_usdc: u64
        + proposal_count: u16
        + settled_count: u16
        + total_vtokens_to_mint: u64
        + total_entry_fee: u64
        + sealed: bool
        --
        **Seed:** [b"deposit_snapshot", vault, snapshot_id]
        **Owner:** VaultProgram
        **Note:** Batch pricing container for deposits.
        Sealed before settlement; closed at finalize.
        Ensures all proposals in a batch share one price.
    }

    PDA RedemptionSnapshot <<PDA>> [[https://github.com/corda/corda-protocol-mvp/blob/main/packages/vault-core/src/state/redemption_snapshot.rs]] {
        + bump: u8
        + vault: Pubkey
        + snapshot_id: u64
        + vtoken_price: u64
        + supply_at_snapshot: u64
        + usdc_vault_at_snapshot: u64
        + total_vtokens: u64
        + settled_vtokens: u64
        + proposal_count: u16
        + settled_count: u16
        + total_gross: u64
        + total_exit_fee: u64
        + total_usdc_payout: u64
        + sealed: bool
        --
        **Seed:** [b"redemption_snapshot", vault, snapshot_id]
        **Owner:** VaultProgram
        **Note:** Batch pricing container for redemptions.
        Sealed before settlement; closed at finalize.
        Guarantees equal payouts for equal vToken amounts in batch.
    }
    }

    ' "Vault Program State" -[hidden]down-> "Liquidity Pool State (Removed)"
    ' package "Liquidity Pool State (Removed)" {
    ' PDA LiquidityPoolRemoved <<PDA>> {
    '     --
    '     **Status:** Removed in commit a85d60c5
    '     **Legacy Seed:** [b"pool", ...]
    '     **Legacy Owner:** LiquidityProgram
    ' }
    ' }

    "Vault Program State" -[hidden]down-> "Oracle Wrapper State"
    package "Oracle Wrapper State" {

    PDA OracleWrapperConfig <<PDA>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/oracle_wrapper/src/state/oracle_wrapper.rs]] {
        + price_feed: Pubkey
        + admin: Pubkey
        + local_test_mode: bool
        + vault_id: u64
        + staleness_threshold_seconds: i32
        --
        **Seed:** [b"oracle_wrapper", vault_id]
        **Owner:** OracleWrapperProgram
        **Note:** Referenced by Vault.vtoken_oracle_wrapper_config.
        Wraps price feed with staleness checks.
        local_test_mode allows synthetic price injection in tests.
    }

    }

    "Oracle Wrapper State" -[hidden]down-> "Token Mints & Accounts"
    package "Token Mints & Accounts" {

    ACCOUNT VTokenMint <<Account>> [[https://spl.solana.com/token-2022]] {
        + mint_authority: Vault PDA
        + freeze_authority: Vault PDA
        --
        **Note:** vToken mint used for vault shares
    }

    ACCOUNT USDCMint <<Account>> {
        --
        **Purpose:**
        Stablecoin used for investments
        and redemptions.
    }

    VTokenMint -[hidden]right-> USDCMint

    ACCOUNT InvestorVTokenAccount <<AssociatedTokenAccount>> {
        + owner: InvestorWallet
        + mint: VTokenMint
        --
        **Purpose:**
        Investor-held vToken balance.
    }

    ACCOUNT InvestorUSDCAccount <<AssociatedTokenAccount>> {
        + owner: InvestorWallet
        + mint: USDCMint
        --
        **Purpose:**
        Source for investments,
        destination for redemptions.
    }

    InvestorVTokenAccount -[hidden]right-> InvestorUSDCAccount
    InvestorUSDCAccount -[hidden]right-> VaultUSDCAccount

    ACCOUNT VaultUSDCAccount <<AssociatedTokenAccount>> {
        + owner: Vault PDA
        + mint: USDCMint
        --
        **Purpose:**
        Holds vault USDC deposits.
        MemoTransfer extension.
    }
    }

}

' ========================================
' Instructions (grouped by role)
' ========================================

package "Admin Instructions" <<Rectangle>> {
    INSTRUCTION InitializeVault <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/config/initialize_vault.rs]] {
        + authority: Signer
        + params: InitializeVaultParams
        --
        Creates Vault PDA
        Sets authority, fee config, thresholds
        Links mints and token accounts
    }

    INSTRUCTION SetAuthority <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/config/set_authority.rs]] {
        --
        Rotates vault authority.
        Dual-sign: current authority +
        new_authority must both sign.
        Used to hand off to RBAC PDA
        after bootstrap.
    }

    INSTRUCTION AddToVtokenWhitelist <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/acl/whitelist.rs]] {
        + owner: Pubkey
        --
        Creates/updates VaultWhitelistEntry
        Sets whitelisted = true
    }

    INSTRUCTION RemoveFromVtokenWhitelist <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/acl/whitelist.rs]] {
        + owner: Pubkey
        --
        Removes whitelist marker by closing
        VaultWhitelistEntry account.
    }

    INSTRUCTION UpdateVaultConfig <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/config/update_vault_config.rs]] {
        + params: UpdateVaultConfigParams
        --
        Updates curator, thresholds, fees
    }

    INSTRUCTION PauseVault <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/config/pause.rs]] {
        + deposits: bool
        + redemptions: bool
        --
        Pauses deposits and/or redemptions
    }

    INSTRUCTION ResumeVault <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/config/resume.rs]] {
        + deposits: bool
        + redemptions: bool
        --
        Resumes deposits and/or redemptions
    }

    INSTRUCTION FreezeVtokenAccount <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/acl/freeze.rs]] {
        --
        Admin-controlled freeze of a specific
        vToken account. Compliance action;
        does not check whitelist.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION ThawVtokenAccount <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/acl/freeze.rs]] {
        + owner: Pubkey
        --
        Admin-controlled thaw operation
        for previously frozen vToken account.
        Counterpart to FreezeVtokenAccount.
        **Authorization:** Authority (via RBAC)
    }

    ' Layout hints: stack admin instructions vertically
    InitializeVault -[hidden]down-> SetAuthority
    SetAuthority -[hidden]down-> AddToVtokenWhitelist
    AddToVtokenWhitelist -[hidden]down-> RemoveFromVtokenWhitelist
    RemoveFromVtokenWhitelist -[hidden]down-> UpdateVaultConfig
    UpdateVaultConfig -[hidden]down-> PauseVault
    PauseVault -[hidden]down-> ResumeVault
    ResumeVault -[hidden]down-> FreezeVtokenAccount
    FreezeVtokenAccount -[hidden]down-> ThawVtokenAccount
}

package "Investor Instructions" <<Rectangle>> {
    INSTRUCTION CreateInvestmentProposal <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/create_investment_proposal.rs]] {
        + params: CreateProposalParams
        --
        Creates proposal and transfers USDC to vault.
        Requires curator-driven settlement path.
    }

    INSTRUCTION CreateRedemptionProposal <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/create_redemption_proposal.rs]] {
        + params: CreateRedemptionParams
        --
        1. Move investor vTokens to vault escrow
        2. Record expected USDC amount
        3. Track pending redemption shares
        **Constraint:** whitelist_entry.whitelisted
    }

    INSTRUCTION CancelRedemptionProposal <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/cancel_redemption_proposal.rs]] {
        --
        Cancels pending unmatched redemption,
        returns escrowed vTokens to investor,
        and releases outbound bookkeeping.
    }

    ' Layout hints: stack investor instructions vertically
    CreateInvestmentProposal -[hidden]down-> CreateRedemptionProposal
    CreateRedemptionProposal -[hidden]down-> CancelRedemptionProposal
}

package "Curator / Settlement Instructions" <<Rectangle>> {
    INSTRUCTION SettleInvestment <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/settle_investment.rs]] {
        --
        Settles pending investment proposal.
        Mints vTokens to investor at
        settlement NAV.
        **Authorization:** Authority (via RBAC)
        **Critical:** whitelist entry required
    }

    INSTRUCTION RejectInvestment <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/reject_investment.rs]] {
        --
        1. Refund USDC to investor
        2. Set status = Rejected
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION SettleRedemption <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/settle_redemption.rs]] {
        --
        Settles pending redemption:
        computes payout from NAV, burns escrowed
        vTokens, and transfers USDC to investor.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION TransferToTokenizer <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/transfer_to_tokenizer.rs]] {
        --
        Transfer USDC from vault to
        external tokenizer destination.
        Sets proposal status = Accepted.
        Idempotent for Accepted proposals.
        **Authorization:** Authority (via RBAC)
    }

    ' DEPRECATED: auto-invest order feature removed in vault-modularization

    ' Layout hints: stack curator instructions vertically
    SettleInvestment -[hidden]down-> RejectInvestment
    RejectInvestment -[hidden]down-> SettleRedemption
    SettleRedemption -[hidden]down-> TransferToTokenizer
}

package "Batch / Snapshot Instructions" <<Rectangle>> {
    INSTRUCTION CreateDepositSnapshot <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/batch_deposit.rs]] {
        --
        Opens a new DepositSnapshot batch.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION SealDepositSnapshot <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/batch_deposit.rs]] {
        --
        Fetches price via Oracle Wrapper,
        seals snapshot, pre-computes totals.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION AddToDepositSnapshot <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/batch_deposit.rs]] {
        --
        Enrols a pending InvestmentProposal
        into the open snapshot.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION SettleFromDepositSnapshot <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/batch_deposit.rs]] {
        --
        Mints vTokens to investor using
        the sealed snapshot price.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION FinalizeDepositSnapshot <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/batch_deposit.rs]] {
        --
        Validates batch complete,
        closes DepositSnapshot account.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION DiscardDepositSnapshot <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/batch_deposit.rs]] {
        --
        Closes an audit-only deposit snapshot.
        No settled_count check, no vault
        counter changes. Used when batch
        handled via match + per-proposal settle.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION CreateRedemptionSnapshot <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/batch_redemption.rs]] {
        --
        Opens a new RedemptionSnapshot batch.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION SealRedemptionSnapshot <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/batch_redemption.rs]] {
        --
        Fetches price, captures supply and
        vault USDC, seals snapshot.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION AddToRedemptionSnapshot <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/batch_redemption.rs]] {
        --
        Enrols a pending RedemptionProposal
        into the open snapshot.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION SettleFromRedemptionSnapshot <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/batch_redemption.rs]] {
        --
        Burns escrowed vTokens, transfers
        USDC payout to investor from
        sealed snapshot price.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION FinalizeRedemptionSnapshot <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/batch_redemption.rs]] {
        --
        Validates batch complete,
        closes RedemptionSnapshot account.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION DiscardRedemptionSnapshot <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/batch_redemption.rs]] {
        --
        Closes an audit-only redemption
        snapshot. No settled_count check.
        Used when matching handled the
        batch as a pure audit record.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION MatchDepositRedemption <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/match_deposit_redemption.rs]] {
        --
        Nets a redemption against a deposit
        on-chain without off-boarding USDC.
        Transfers vTokens from escrow to
        incoming investor directly.
        **Authorization:** Authority (via RBAC)
    }

    CreateDepositSnapshot -[hidden]down-> SealDepositSnapshot
    SealDepositSnapshot -[hidden]down-> AddToDepositSnapshot
    AddToDepositSnapshot -[hidden]down-> SettleFromDepositSnapshot
    SettleFromDepositSnapshot -[hidden]down-> FinalizeDepositSnapshot
    FinalizeDepositSnapshot -[hidden]down-> DiscardDepositSnapshot
    DiscardDepositSnapshot -[hidden]down-> CreateRedemptionSnapshot
    CreateRedemptionSnapshot -[hidden]down-> SealRedemptionSnapshot
    SealRedemptionSnapshot -[hidden]down-> AddToRedemptionSnapshot
    AddToRedemptionSnapshot -[hidden]down-> SettleFromRedemptionSnapshot
    SettleFromRedemptionSnapshot -[hidden]down-> FinalizeRedemptionSnapshot
    FinalizeRedemptionSnapshot -[hidden]down-> DiscardRedemptionSnapshot
    DiscardRedemptionSnapshot -[hidden]down-> MatchDepositRedemption
}

package "Price / Incident Controls" <<Rectangle>> {
    INSTRUCTION ConfigureOracleWrapper <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/oracle_wrapper/src/instructions/configure.rs]] {
        --
        Initialises or reconfigures the
        OracleWrapper config PDA for a vault.
        Sets price feed address and staleness
        threshold.
        **Authorization:** OracleWrapper admin
    }

    INSTRUCTION FetchPrice <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/oracle_wrapper/src/instructions/get_price.rs]] {
        --
        Reads the configured feed via
        Oracle Wrapper.
        Rejects stale or mismatched
        feed accounts.
    }

    INSTRUCTION EngageEmergencyStop <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/config/engage_emergency_stop.rs]] {
        --
        Freezes vault activity via the
        emergency-stop flag.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION LiftEmergencyStop <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/config/lift_emergency_stop.rs]] {
        --
        Clears the emergency-stop flag
        after investigation.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION UpdateTestPrices <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/oracle_wrapper/src/instructions/update_test_prices.rs]] {
        --
        Writes a synthetic price to the test
        PriceFeed account.
        **Guard:** local_test_mode must be true.
        **Authorization:** OracleWrapper admin only
        **Note:** Test environments only.
    }

    ' Layout hints: stack controls vertically
    ConfigureOracleWrapper -[hidden]down-> FetchPrice
    FetchPrice -[hidden]down-> EngageEmergencyStop
    EngageEmergencyStop -[hidden]down-> LiftEmergencyStop
    LiftEmergencyStop -[hidden]down-> UpdateTestPrices
}

' ========================================
' Relationships: Instructions → State
' ========================================

' --- Admin Instructions ---
InitializeVault --> Vault : creates
InitializeVault --> VaultUSDCAccount : R
InitializeVault --> OracleWrapperProgram : R (config binding)

SetAuthority --> Vault : W (rotate authority)

AddToVtokenWhitelist --> VaultWhitelistEntry : creates
AddToVtokenWhitelist --> Vault : R

RemoveFromVtokenWhitelist --> VaultWhitelistEntry : W (close)
RemoveFromVtokenWhitelist --> Vault : W
RemoveFromVtokenWhitelist --> InvestorVTokenAccount : may-freeze

UpdateVaultConfig --> Vault : W
PauseVault --> Vault : W
ResumeVault --> Vault : W

ThawVtokenAccount --> InvestorVTokenAccount : thaws
FreezeVtokenAccount --> InvestorVTokenAccount : freezes

' --- Investor Instructions ---
CreateInvestmentProposal --> InvestmentProposal : creates
CreateInvestmentProposal --> Vault : W
CreateInvestmentProposal --> VaultWhitelistEntry : R
CreateInvestmentProposal --> InvestorUSDCAccount : W (debit)
CreateInvestmentProposal --> VaultUSDCAccount : W (credit)

CreateRedemptionProposal --> RedemptionProposal : creates
CreateRedemptionProposal --> Vault : W
CreateRedemptionProposal --> VaultWhitelistEntry : R
CreateRedemptionProposal --> InvestorVTokenAccount : W (escrow)

CancelRedemptionProposal --> RedemptionProposal : W (cancel)
CancelRedemptionProposal --> Vault : W
CancelRedemptionProposal --> InvestorVTokenAccount : W (return escrow)

' --- Curator / Settlement Instructions ---
SettleInvestment --> InvestmentProposal : W (settle)
SettleInvestment --> Vault : W
SettleInvestment --> VTokenMint : W (mint)
SettleInvestment --> InvestorVTokenAccount : W (mint)
SettleInvestment --> OracleWrapperProgram : R (fetch price)

RejectInvestment --> InvestmentProposal : W (reject)
RejectInvestment --> InvestorUSDCAccount : W (refund)
RejectInvestment --> VaultUSDCAccount : W (debit)

SettleRedemption --> RedemptionProposal : W (settle)
SettleRedemption --> Vault : W
SettleRedemption --> VTokenMint : W (burn escrow)
SettleRedemption --> InvestorUSDCAccount : W (credit)
SettleRedemption --> VaultUSDCAccount : W (debit)

TransferToTokenizer --> InvestmentProposal : W (accept)
TransferToTokenizer --> VaultUSDCAccount : W (transfer)

' --- Batch / Snapshot Instructions ---
CreateDepositSnapshot --> DepositSnapshot : creates
SealDepositSnapshot --> DepositSnapshot : W (seal)
SealDepositSnapshot --> OracleWrapperProgram : R (fetch price)
AddToDepositSnapshot --> DepositSnapshot : W
AddToDepositSnapshot --> InvestmentProposal : W
SettleFromDepositSnapshot --> DepositSnapshot : W
SettleFromDepositSnapshot --> InvestmentProposal : W (settle)
SettleFromDepositSnapshot --> VTokenMint : W (mint)
SettleFromDepositSnapshot --> InvestorVTokenAccount : W (mint)
FinalizeDepositSnapshot --> DepositSnapshot : W (close)
DiscardDepositSnapshot --> DepositSnapshot : W (close)

CreateRedemptionSnapshot --> RedemptionSnapshot : creates
SealRedemptionSnapshot --> RedemptionSnapshot : W (seal)
SealRedemptionSnapshot --> OracleWrapperProgram : R (fetch price)
AddToRedemptionSnapshot --> RedemptionSnapshot : W
AddToRedemptionSnapshot --> RedemptionProposal : W
SettleFromRedemptionSnapshot --> RedemptionSnapshot : W
SettleFromRedemptionSnapshot --> RedemptionProposal : W (settle)
SettleFromRedemptionSnapshot --> VTokenMint : W (burn)
SettleFromRedemptionSnapshot --> InvestorUSDCAccount : W (credit)
SettleFromRedemptionSnapshot --> VaultUSDCAccount : W (debit)
FinalizeRedemptionSnapshot --> RedemptionSnapshot : W (close)
DiscardRedemptionSnapshot --> RedemptionSnapshot : W (close)

MatchDepositRedemption --> InvestmentProposal : R
MatchDepositRedemption --> RedemptionProposal : W
MatchDepositRedemption --> InvestorVTokenAccount : W (transfer vTokens)
MatchDepositRedemption --> Vault : W

' --- Price / Incident Controls ---
ConfigureOracleWrapper --> OracleWrapperConfig : creates/updates
ConfigureOracleWrapper --> OracleWrapperProgram : W (owns config)
FetchPrice --> OracleWrapperConfig : R
FetchPrice --> OracleWrapperProgram : R (feed)
UpdateTestPrices --> OracleWrapperConfig : R
UpdateTestPrices --> OracleWrapperProgram : W (test price feed)
EngageEmergencyStop --> Vault : W (emergency_stop = 1)
LiftEmergencyStop --> Vault : W (emergency_stop = 0)

' ========================================
' Layout hints
' ========================================

' Instruction packages in a single row
"Admin Instructions" -[hidden]right-> "Investor Instructions"
"Investor Instructions" -[hidden]right-> "Curator / Settlement Instructions"
"Curator / Settlement Instructions" -[hidden]right-> "Batch / Snapshot Instructions"
"Batch / Snapshot Instructions" -[hidden]right-> "Price / Incident Controls"

' Each wallet above its instruction group
AdminWallet -[hidden]down-> "Admin Instructions"
InvestorWallet -[hidden]down-> "Investor Instructions"
CuratorWallet -[hidden]down-> "Curator / Settlement Instructions"
ManagerWallet -[hidden]down-> "Batch / Snapshot Instructions"

' All instructions above Solana accounts
"Admin Instructions" -[hidden]down-> "Solana On-Chain Accounts"
"Investor Instructions" -[hidden]down-> "Solana On-Chain Accounts"
"Curator / Settlement Instructions" -[hidden]down-> "Solana On-Chain Accounts"
"Batch / Snapshot Instructions" -[hidden]down-> "Solana On-Chain Accounts"

' Last instruction in each group pinned above Solana
ThawVtokenAccount -[hidden]down-> VaultProgram
CreateRedemptionProposal -[hidden]down-> VaultProgram
LiftEmergencyStop -[hidden]down-> OracleWrapperProgram

