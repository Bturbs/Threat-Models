    "test": "playwright test",
    "har:config": "threat-model-har-config --har har/demo_investor_registration.har --out har/demo_investor_registration.config.yaml --index-out har/demo_investor_registration.indexHAR.yaml",
    "har:seq": "threat-model-har2seq --har har/demo_investor_registration.har --config har/demo_investor_registration.config.yaml --view sequence --include-source-host-in-label --out har/demo_investor_registration.sequence.puml",
    "har:seq:hosts": "threat-model-har2seq --har har/demo_investor_registration.har --config har/demo_investor_registration.config.yaml --view sequence --include-source-host-in-label --single-call-per-source-host --out har/demo_investor_registration.sourceHostSummary.puml",
    "har:dfd": "threat-model-har2seq --har har/demo_investor_registration.har --config har/demo_investor_registration.config.yaml --view HighLevelDFD --single-call-per-participant --out har/demo_investor_registration.HighLevelDFD.puml",
    "har:diagrams": "npm run har:seq && npm run har:seq:hosts && npm run har:dfd"
  },
