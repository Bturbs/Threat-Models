@startuml
' High Level Hashlock DoS Prevention

!theme plain
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

title High Level: Hashlock DoS Prevention

participant "Party A" as PA
participant "Party B" as PB
participant "Notary\n(Non-Validating, HashLock Aware)" as N

' Define color for hashlock elements
!$HASH_COLOR = "blue"

group Legitimate IOU Creation with Hash Lock
    activate PB
    PB -> PB : 1. Generate <color:$HASH_COLOR>secret</color>
    PB -> PB : 2. Calculate <color:$HASH_COLOR>hash = H(secret)</color>
    deactivate PB

    activate PA
    PA -> PB : 3. Propose IOU, Request Signature & <color:$HASH_COLOR>Hash</color>
    activate PB
    PB -> PB : Verify Proposal
    PB -> PA : 4. Send Signature & <color:$HASH_COLOR>Hash</color>
    deactivate PB
    PA -> PA : 5. Assemble Signed IOU Tx (incl. <color:$HASH_COLOR>hash</color>)
    PA -> N : 6. Request Notarization (Tx incl. <color:$HASH_COLOR>hash</color>)
    activate N
    N -> N : Check Inputs (OK), Sign
    N -> N : **<color:$HASH_COLOR>Store Hash Lock (StateRef -> hash)</color>**
    N --> PA : 7. Confirm IOU Notarized
    N --> PB : 8. Distribute Notarized IOU Tx Confirmation
    deactivate N
    PA -> PA : Record Final IOU State
    deactivate PA
    activate PB
    PB -> PB : Record Final IOU State
    deactivate PB
end group

note across
Time passes...
end note

group DoS Attack Attempt (Blocked by Hash Lock)
    activate PA
    PA -> PA : 1. Craft **Invalid** Tx Consuming IOU\n(**LACKS** <color:$HASH_COLOR>secret</color>)
    note right of PA : Attacker does not know the <color:$HASH_COLOR>secret</color>.

    PA -> N : 2. Request Notarization for Invalid Tx\n(Bypassing Party B, Tx lacks <color:$HASH_COLOR>secret</color>)
    activate N
    N -> N : **<color:$HASH_COLOR>Verify Hash Lock Pre-image (secret)</color>**
    alt <color:$HASH_COLOR>Secret Missing/Invalid</color> in Tx
        N -> N : **Generate Error: <color:$HASH_COLOR>Invalid Hash Lock</color>**
        N --> PA : 3. **Reject Tx: <color:$HASH_COLOR>Invalid Hash Lock</color>**
        note right of PA: Attack **FAILED**. State NOT consumed.
    else <color:$HASH_COLOR>Secret Valid</color> (Not expected for attacker)
        N -> N : Check Conflicts (Double Spend)
        ' ... notary logic ...
    end
    deactivate N
    deactivate PA
end group

note across
Time passes...
end note

group Legitimate Spend (Succeeds with Hash Lock)
    activate PB
    PB -> PB : 1. Decide to spend IOU
    PB -> PA : 2. Propose Spend, Request Signature\n(Spend Tx includes <color:$HASH_COLOR>secret</color>)
    activate PA
    PA -> PA : Verify, Sign Spend Tx
    PA -> PB : 3. Send Signature
    deactivate PA
    PB -> PB : 4. Assemble Valid, Signed Tx (incl. <color:$HASH_COLOR>secret</color>)

    PB -> N : 5. Request Notarization (Valid Tx incl. <color:$HASH_COLOR>secret</color>)
    activate N
    N -> N : **<color:$HASH_COLOR>Verify Hash Lock Pre-image (secret)</color>**
    alt <color:$HASH_COLOR>Secret Valid</color> in Tx
        N -> N : **Check Conflicts (Double Spend)**
        note right of N : Attack failed, so no conflict found. Check PASSES.
        N -> N : Mark StateRef Consumed, Sign Tx
        N --> PB : 6. Confirm Spend Notarized
        N --> PA : 7. Distribute Notarized Spend Tx Conf.
    else <color:$HASH_COLOR>Secret Invalid</color> (Should not happen here)
        N -> N : Generate Error: <color:$HASH_COLOR>Invalid Hash Lock</color>
        N --> PB : 6. Reject Tx: <color:$HASH_COLOR>Invalid Hash Lock</color>
    end
    deactivate N
    PB -> PB : Record Spent State
    deactivate PB
end group

@enduml