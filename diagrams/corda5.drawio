        </mxCell>
        <mxCell id="aRGcAFR6JZkqNKQmyqSA-58" value="&lt;b&gt;Ultimate&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;fontFamily=Helvetica;" parent="jsRHmFCptj0i6vtfv6NT-4" vertex="1">
          <mxGeometry x="-1321" y="5282" width="89" height="34" as="geometry" />
        </mxCell>
        <mxCell id="aRGcAFR6JZkqNKQmyqSA-62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#000000;startArrow=none;startFill=0;endArrow=classic;endFill=1;" parent="jsRHmFCptj0i6vtfv6NT-4" source="aRGcAFR6JZkqNKQmyqSA-61" target="dTZx6aGI7eykMt0Zrxhj-60" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aRGcAFR6JZkqNKQmyqSA-61" value="https://cr.yp.to/snuffle/bruteforce-20050425.pdf Multiple encryption on same data, guessing the &lt;br&gt;key will cost half, if several master keys are rotated over time there will &lt;br&gt;be a continuous degradation of the cost of a brute force attacks on AES 256. Still, the degradation sees not to be exponential,rather logaritmic:&lt;br&gt;from 1 to 2 keys (our most likely example) the degradation is 50% (i bit less to guess, in average)&lt;br&gt;from 1000 to 1001 master encrypted keys the degradation of the additional cyphertext to match in a brute force (trying all the space of keys) will be only 1/1000 or 0,1% circa (10 bits). &lt;br&gt;This si true in the hypothesis that AES is a perfect encryption algorithm (really random output of encrypted message), &lt;br&gt;that is not likely 100% true and cryptoanalists may find an advanage in having the same message encrypted multiple times with different keys, specially if some of the plaintext is known. &lt;br&gt;A possible mitigation would be not to use PKCS#8 (-----BEGIN PRIVATE KEY-----) and only store the truly random part on the private key (https://www.rfc-editor.org/rfc/rfc5915)&lt;br&gt;In general we can say the AES 256 will surely meet 196 bit level encryption etc..." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontFamily=Helvetica;fontColor=#000000;" parent="jsRHmFCptj0i6vtfv6NT-4" vertex="1">
          <mxGeometry x="3646" y="3601" width="1323" height="185" as="geometry" />
        </mxCell>
        <mxCell id="4gJDzPwMsVbXqHGC160j-3" value="secondary records &lt;br&gt;degrades AES resistance to attacks (e.g. brute force)" style="ellipse;whiteSpace=wrap;html=1;labelBackgroundColor=none;strokeColor=#C73500;strokeWidth=7;fontSize=18;fontColor=#FF3333;fillColor=none;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;" parent="jsRHmFCptj0i6vtfv6NT-4" vertex="1">
          <mxGeometry x="1448" y="4098" width="290" height="233" as="geometry" />
        </mxCell>
        <mxCell id="4gJDzPwMsVbXqHGC160j-4" value="+Ledger key" style="points=[[0,0.5,0],[0.24,0,0],[0.5,0.28,0],[0.995,0.475,0],[0.5,0.72,0],[0.24,1,0]];verticalLabelPosition=bottom;sketch=0;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.key;fillColor=#e3c800;strokeColor=#B09500;labelBackgroundColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" parent="jsRHmFCptj0i6vtfv6NT-4" vertex="1">
          <mxGeometry x="489.0000000000001" y="2083" width="50" height="22.5" as="geometry" />
        </mxCell>
        <mxCell id="4gJDzPwMsVbXqHGC160j-5" value="+Wrapping key" style="points=[[0,0.5,0],[0.24,0,0],[0.5,0.28,0],[0.995,0.475,0],[0.5,0.72,0],[0.24,1,0]];verticalLabelPosition=bottom;sketch=0;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.key;fillColor=#b0e3e6;strokeColor=#0e8088;labelBackgroundColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=12;" parent="jsRHmFCptj0i6vtfv6NT-4" vertex="1">
          <mxGeometry x="572.0000000000001" y="2086" width="50" height="22.5" as="geometry" />
        </mxCell>
        <mxCell id="4gJDzPwMsVbXqHGC160j-17" value="secret keys are transiting in the message bus unencrypted during backup" style="ellipse;whiteSpace=wrap;html=1;labelBackgroundColor=none;strokeColor=#C73500;strokeWidth=7;fontSize=18;fontColor=#FF3333;fillColor=none;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;" parent="jsRHmFCptj0i6vtfv6NT-4" vertex="1">
          <mxGeometry x="1120" y="4108" width="290" height="233" as="geometry" />
        </mxCell>
        <mxCell id="4gJDzPwMsVbXqHGC160j-20" value="Lack of entropy leading to malign collision (spoofing)&lt;br&gt;&lt;br&gt;" style="ellipse;whiteSpace=wrap;html=1;labelBackgroundColor=none;strokeColor=#C73500;strokeWidth=7;fontSize=18;fontColor=#FF3333;fillColor=none;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;" parent="jsRHmFCptj0i6vtfv6NT-4" vertex="1">
          <mxGeometry x="-467" y="7673" width="344" height="196" as="geometry" />
        </mxCell>
        <mxCell id="4gJDzPwMsVbXqHGC160j-25" value="still secret VNode priv key in memory, could be mitigated with HSM PCKS11 sessions if supported: sign with temporary key inside HSM" style="ellipse;whiteSpace=wrap;html=1;labelBackgroundColor=none;strokeColor=#C73500;strokeWidth=7;fontSize=18;fontColor=#FF3333;fillColor=none;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;" parent="jsRHmFCptj0i6vtfv6NT-4" vertex="1">
          <mxGeometry x="357" y="4573" width="337" height="295" as="geometry" />
        </mxCell>
        <mxCell id="HOtoMd6kcSFVbsdaHCLa-25" value="notes" style="" parent="0" />
        <mxCell id="4gJDzPwMsVbXqHGC160j-23" value="What is the secondary record?&lt;br&gt;&amp;nbsp;(assumption second encryption of the key for backup purposes, using backup master key)&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=16;fontColor=#000000;fillColor=#e3c800;strokeColor=#B09500;" parent="HOtoMd6kcSFVbsdaHCLa-25" vertex="1">
