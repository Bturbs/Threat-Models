@startuml
title PreCommitVault Browser Session - Traffic Analysis

actor "User" as User

box "Client" #LightBlue
participant "User Browser\n(Firefox 147)" as Browser
end box

box "PreCommitVault Owned" #LightGreen
participant "Azure Container App\n(precommitvault)" as ACA
end box

box "Third-Party" #LightYellow
participant "Auth Provider\n(AWS Cognito)" as Auth
end box

User -> Browser : Use PreCommitVault Web UI

Browser -> ACA : Load application shell
ACA --> Browser : 304 Not Modified - HTML shell

Browser -> Browser : <b>DF_BROWSER_TO_CACHE
Browser --> Browser : <b>DF_CACHE_TO_BROWSER
note right of Browser
  Static assets served from browser cache
  JS bundles, CSS, fonts, images,
  vendor chunks, manifest
end note

Browser -> ACA : <b>DF_BROWSER_TO_ACA_BOOTSTRAP
ACA --> Browser : <b>DF_ACA_TO_BROWSER_BOOTSTRAP
note right of ACA
  Runtime config and primary
  dataset (~1.38 MB)
end note

Browser -> Auth : <b>DF_BROWSER_TO_AUTH_OIDC
Auth --> Browser : <b>DF_AUTH_TO_BROWSER_OIDC
note right of Auth
  OIDC discovery + JWKS
  signing keys
end note

Browser -> ACA : <b>DF_BROWSER_TO_ACA_SESSION
ACA --> Browser : <b>DF_ACA_TO_BROWSER_SESSION
note right of ACA
  Session and user profile
  validation
end note

Browser -> ACA : <b>DF_BROWSER_TO_ACA_HYDRATION
ACA --> Browser : <b>DF_ACA_TO_BROWSER_HYDRATION
note right of ACA
  Full data hydration - vaults,
  hooks, repos, rules, tags,
  search index, icon sprites,
  hook registry
end note

Browser -> ACA : <b>DF_BROWSER_TO_ACA_VAULT_BROWSE
ACA --> Browser : <b>DF_ACA_TO_BROWSER_VAULT_BROWSE
note right of ACA
  4 vault detail views including
  hooks, repos, summaries and
  hook browse results
end note

Browser -> ACA : <b>DF_BROWSER_TO_ACA_STATUS_POLL
ACA --> Browser : <b>DF_ACA_TO_BROWSER_STATUS_POLL
note right of ACA
  Background status polling
  ~10s intervals, state change
  detected on final poll
end note

Browser -> Auth : <b>DF_BROWSER_TO_AUTH_TOKEN_REFRESH
Auth --> Browser : <b>DF_AUTH_TO_BROWSER_TOKEN_REFRESH
note right of Auth
  2x token refresh cycles
  + userInfo re-fetch
end note

Browser -> ACA : <b>DF_BROWSER_TO_ACA_EXPORT
ACA --> Browser : <b>DF_ACA_TO_BROWSER_EXPORT
note right of ACA
  Export request + retry
  detected (419ms -> 791ms)
end note

Browser -> ACA : <b>DF_BROWSER_TO_ACA_ARCHIVE_DOWNLOAD
ACA --> Browser : <b>DF_ACA_TO_BROWSER_ARCHIVE_DOWNLOAD
note right of ACA
  Archive file download
  (~4.17 MB, 854ms)
end note

Browser -> ACA : <b>DF_BROWSER_TO_ACA_FINAL_STATUS
ACA --> Browser : <b>DF_ACA_TO_BROWSER_FINAL_STATUS
note right of ACA
  Post-download status
  confirmation
end note

Browser -> User : Render completed session

@enduml
