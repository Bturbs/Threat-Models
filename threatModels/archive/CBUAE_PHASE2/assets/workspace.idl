resources:
  - id: "14"
    name: "Admin Staff"
    subtitle: "[Person]"
    description: "Admin user managing installation"
    backgroundColor: "#999999"
    color: "#ffffff"

  - id: "3"
    name: "Personal Banking Customer"
    subtitle: "[Person]"
    description: "A customer of the bank, with personal retail wallet."
    backgroundColor: "#08427b"
    color: "#ffffff"

  - id: "5"
    name: "Payee"
    subtitle: "[Person]"
    description: "A customer of the bank, with personal retail wallet."
    backgroundColor: "#08427b"
    color: "#ffffff"

  - id: "1"
    name: "Mobile App"
    subtitle: "[Software System]"
    description: "Provides a limited subset of the retail CDBC functionality to customers via their mobile device."
    backgroundColor: "#438dd5"
    color: "#ffffff"

  - id: "10"
    name: "CB Core Banking"
    subtitle: "[Software System]"
    description: "Core Banking system"
    backgroundColor: "#1168bd"
    color: "#ffffff"

    children:
      - id: "11"
        name: "Flexcube"
        subtitle: "[Container: Oracle Flexcube]"
        description: "Flexcube core banking system"
        backgroundColor: "#438dd5"
        color: "#ffffff"

        children:
          - id: "12"
            name: "Client Public Key"
            subtitle: "[Component: ECDSA 512]"
            description: "Registered client Public Key"
            backgroundColor: "#cccccc"
            color: "#000000"
            icon: "https://static.structurizr.com/themes/amazon-web-services-2023.01.31/Res_AWS-IoT_Certificate_48_Light.png"

  - id: "13"
    name: "POS"
    subtitle: "[Software System]"
    description: "Point of sale"
    backgroundColor: "#999999"
    color: "#ffffff"

  - id: "15"
    name: "DLT Banking System"
    subtitle: "[Software System]"
    description: "Distributed Led gersystem for CDBC"
    backgroundColor: "#1168bd"
    color: "#ffffff"

  - id: "16"
    name: "Notification System"
    subtitle: "[Software System]"
    description: "Notification Notification system."
    backgroundColor: "#1168bd"
    color: "#ffffff"

  - id: "17"
    name: "Retail CDBC System"
    subtitle: "[Software System]"
    description: "Allows customers to view information about their retail wallet, and make payments."
    backgroundColor: "#1168bd"
    color: "#ffffff"

    children:
      - id: "18"
        name: "Banckend for Frontend"
        subtitle: "[Container]"
        backgroundColor: "#438dd5"
        color: "#ffffff"

      - id: "19"
        name: "Single-Page Application"
        subtitle: "[Container: JavaScript and Angular]"
        description: "Provides all of the retail CDBC functionality to customers via their web browser."
        backgroundColor: "#438dd5"
        color: "#ffffff"

      - id: "20"
        name: "Web Application"
        subtitle: "[Container: Java and Spring MVC]"
        description: "Delivers the static content and the retail CDBC single page application."
        backgroundColor: "#438dd5"
        color: "#ffffff"

      - id: "21"
        name: "WalletAPI Application"
        subtitle: "[Container: Java and Spring MVC]"
        description: "Provides retail CDBC functionality via a JSON/HTTPS API."
        backgroundColor: "#438dd5"
        color: "#ffffff"

        children:
          - id: "22"
            name: "Sign In Controller"
            subtitle: "[Component: Spring MVC Rest Controller]"
            description: "Allows users to sign in to the Retail CDBC System."
            backgroundColor: "#85bbf0"
            color: "#000000"

          - id: "23"
            name: "Accounts Summary Controller"
            subtitle: "[Component: Spring MVC Rest Controller]"
            description: "Provides customers with a summary of their retail wallet."
            backgroundColor: "#85bbf0"
            color: "#000000"

          - id: "24"
            name: "Reset Password Controller"
            subtitle: "[Component: Spring MVC Rest Controller]"
            description: "Allows users to reset their passwords with a single use URL."
            backgroundColor: "#85bbf0"
            color: "#000000"

          - id: "25"
            name: "Security Component"
            subtitle: "[Component: Spring Bean]"
            description: "Provides functionality related to signing in, changing passwords, etc."
            backgroundColor: "#85bbf0"
            color: "#000000"

          - id: "26"
            name: "DLT Banking System Facade"
            subtitle: "[Component: Spring Bean]"
            description: "A facade onto the DLT banking system."
            backgroundColor: "#85bbf0"
            color: "#000000"

          - id: "27"
            name: "Notification Component"
            subtitle: "[Component: Spring Bean]"
            description: "Sends Notifications to users."
            backgroundColor: "#85bbf0"
            color: "#000000"

      - id: "28"
        name: "Authentication Bank1"
        subtitle: "[Container: OpenID Connect IDS]"
        description: "Authentication system"
        backgroundColor: "#438dd5"
        color: "#ffffff"

        children:
          - id: "29"
            name: "User Directory"
            subtitle: "[Component]"
            description: "Keycloack DB"
            backgroundColor: "#85bbf0"
            color: "#000000"

      - id: "30"
        name: "Authorization Bank1"
        subtitle: "[Container]"
        description: "Authorization system (claim based)"
        backgroundColor: "#438dd5"
        color: "#ffffff"

        children:
          - id: "31"
            name: "Polici decision service"
            subtitle: "[Component: open policy agent OPA]"
            description: "Open Policy Agent graphql TODO"
            backgroundColor: "#85bbf0"
            color: "#000000"

      - id: "32"
        name: "Database"
        subtitle: "[Container: Postgres Database Schema]"
        description: "Stores user registration TODO"
        backgroundColor: "#438dd5"
        color: "#ffffff"

  - id: "2"
    name: "Mobile App Bank2"
    subtitle: "[Software System]"
    description: "Provides a limited subset of the retail CDBC functionality to customers via their mobile device."
    backgroundColor: "#438dd5"
    color: "#ffffff"

  - id: "33"
    name: "Retail CDBC System Bank 2"
    subtitle: "[Software System]"
    description: "Allows customers to view information about their retail wallet, and make payments."
    backgroundColor: "#1168bd"
    color: "#ffffff"

  - id: "7"
    name: "Central Bank DLT"
    subtitle: "[Software System]"
    description: "Distributed Led gersystem for CDBC"
    backgroundColor: "#1168bd"
    color: "#ffffff"

  - id: "8"
    name: "Notary"
    subtitle: "[Software System]"
    description: "Notarizes and prevents double spending"
    backgroundColor: "#1168bd"
    color: "#ffffff"

  - id: "9"
    name: "mBridge blockChain"
    subtitle: "[Software System]"
    description: "Cross border wholesale CDBC system"
    backgroundColor: "#1168bd"
    color: "#ffffff"

  - id: "74"
