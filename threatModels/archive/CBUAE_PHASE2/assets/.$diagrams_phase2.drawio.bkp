        <mxCell id="qHVov0-bhh_Yzi4WCpuj-54" value="jars,&lt;br&gt;docker images&lt;br&gt;terraform mods&lt;br&gt;&quot;terrraform states&quot; -&amp;gt; what data?" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#e1d5e7;strokeColor=#9673a6;position2=0.47;opacity=70;size=14;position=0.49;" vertex="1" parent="qHVov0-bhh_Yzi4WCpuj-38">
