        <mxCell id="eYsPGyf-eQK6Kq4G8r95-2" value="Note:&lt;br style=&quot;font-size: 14px;&quot;&gt;Auth signed cert needed?" style="rounded=0;whiteSpace=wrap;html=1;labelBackgroundColor=none;strokeColor=#B09500;strokeWidth=1;fontSize=14;fontColor=#000000;fillColor=#e3c800;" parent="eYsPGyf-eQK6Kq4G8r95-1" vertex="1">
