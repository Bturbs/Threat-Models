@startuml investmentSettlement
' REVIEWED_MAIN_2026_05_18: aligned to RBAC fast-forward 63739244; settlement is permissionless entry (authority check internal).
' LEGACY_NOTE_2026_05_13: this diagram may include historical ACL/receipt/tokenizer details pending upstream simplification merge; validate against current code before implementation decisions.
title Investment Proposal Settlement Sequence — With Whitelist Enforcement

actor "Any Caller\n<<permissionless>>" as Caller
actor "Investor" as Investor

box "Vault Program" #LightBlue
participant "Vault\n<<program>>" as VaultProgram
participant "VaultState\n<<PDA>>" as VaultState
participant "Whitelist Entry\n<<PDA>>" as WhitelistEntry
participant "Investment Proposal\n<<PDA>>" as Proposal
participant "Oracle Wrapper\n<<program>>" as OracleWrapper
end box

box "Token Program" #LightYellow
participant "Token-2022\n<<program>>" as TokenProgram
participant "vToken Mint" as VTokenMint
end box

box "Investor Owned" #pink
participant "Investor vToken\n<<account>>" as InvestorVToken
end box

box "ACL Gate" #LightGreen
participant "ACL Gate\n<<program>>" as AclGate
participant "FLAG_ACCOUNT\n<<PDA>>" as FlagAccount
participant "MINT_CONFIG\n<<PDA>>" as MintConfig
end box

=== SETTLEMENT OPERATION: Curator settlement of pending investment proposal ==

Caller -> VaultProgram : <b>DF_INVESTMENT_SETTLEMENT\n[[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/settle_investment.rs settle_investment]]

note over VaultProgram
  CHECK 1: Deposits Not Paused
end note
VaultProgram -> VaultState : [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/settle_investment.rs constraint: deposits_open]]
alt Deposits Paused
  VaultProgram --> Caller : ❌ VaultError::DepositsPaused
end

note over VaultProgram
  CHECK 2: Proposal Status
end note
VaultProgram -> Proposal : read status
VaultProgram -> VaultProgram : check status == Pending || Accepted
alt Invalid Proposal Status
  VaultProgram --> Caller : ❌ VaultError::ProposalAlreadyProcessed
end

note over VaultProgram
  STEP 1: Resolve settlement price
end note
VaultProgram -> VaultProgram : [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/settle_investment.rs settlement math]]
note right of VaultProgram
  Settlement reads the current
  oracle-wrapper-backed price and applies
  the configured entry fee.
end note

note over VaultProgram
  CHECK 3: Calculate vTokens Based on Price
end note
VaultProgram -> OracleWrapper : [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/oracle_wrapper/src/instructions/get_price.rs fetch_price]]
VaultProgram -> Proposal : read usdc_amount
VaultProgram -> VaultProgram : [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/settle_investment.rs compute investor_vtokens]]
note right of VaultProgram
  vtoken_amount = 
    net_usdc / live_price
end note

note over VaultProgram, Proposal
  CHECK 4: Resolve netted vs offboarded amount
end note
VaultProgram -> Proposal : read netted_usdc
VaultProgram -> VaultState : read pending_offboarded_usdc
VaultProgram -> VaultProgram : compute net_usdc and mint amount

note over VaultProgram, InvestorVToken
  STEP 2: Thaw Investor's vToken Account
  (Only if currently frozen)
end note

alt investor_vtoken.is_frozen()

  note over VaultProgram, WhitelistEntry
    ⚠️ CRITICAL SECURITY CHECK ⚠️
    Validate Investor Whitelist via remaining_accounts
  end note

  VaultProgram -> VaultProgram : require remaining_accounts.len() >= 13
  VaultProgram -> VaultProgram : [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/settle_investment.rs validate proposal + investor accounts]]
  note right of VaultProgram
    Validates:
    - token_acl_program key
    - authority == vault PDA
    - vtoken_mint, investor_vtoken, investor keys
    - mint_config PDA derivation
    - flag_account PDA derivation
    - thaw_extra_account_metas PDA
    - whitelist_entry PDA derivation
  end note

  VaultProgram -> WhitelistEntry : [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/settle_investment.rs whitelist checks at proposal creation path]]
  VaultProgram -> WhitelistEntry : check whitelisted == true
  alt Investor Not Whitelisted
    VaultProgram --> Caller : ❌ VaultError::NotWhitelisted
    note over VaultProgram
      **Security Enforcement:**
      Transaction reverts if investor
      has not completed KYC/AML
    end note
  end

  VaultProgram -> AclGate : [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/acl/thaw_vtoken_account.rs thaw flow]]

  note over AclGate
    ACL Gate validates whitelist
    before allowing thaw
  end note

  AclGate -> WhitelistEntry : validate whitelist_entry PDA
  AclGate -> WhitelistEntry : check owner == investor
  AclGate -> WhitelistEntry : check mint == vtoken_mint
  AclGate -> WhitelistEntry : check whitelisted == true
  alt Not Whitelisted in ACL Check
    AclGate --> VaultProgram : ❌ GateError::NotWhitelisted
  end

  AclGate -> FlagAccount : validate permissionless flag
  AclGate -> TokenProgram : thaw_account(investor_vtoken)
  TokenProgram -> InvestorVToken : set frozen = false

  AclGate --> VaultProgram : ✅ Thaw successful

end

note over VaultProgram, InvestorVToken
  STEP 3: Mint vTokens to Investor
end note

VaultProgram -> TokenProgram : [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/settle_investment.rs mint_to(investor_vtokens)]]
TokenProgram -> VTokenMint : mint vtoken_amount
TokenProgram -> InvestorVToken : credit vtoken_amount
note right of InvestorVToken
  Investor receives vTokens
  representing vault shares
end note

note over VaultProgram
  STEP 4: Update Vault State
end note
VaultProgram -> VaultState : pending_deposit_usdc -= settled_usdc
VaultProgram -> VaultState : pending_offboarded_usdc -= offboarded_share
VaultProgram -> Proposal : status = Settled
VaultProgram -> Proposal : updated_at = now

VaultProgram --> Caller : ✅ Settlement successful

note over WhitelistEntry, InvestorVToken
  **Post-Settlement Security:**
  1. Investor's vToken account is thawed
  2. vTokens are subject to transfer hook
  3. If removed from whitelist later,
     account will be frozen again
  4. Proposal state is finalized on-chain
end note

@enduml
