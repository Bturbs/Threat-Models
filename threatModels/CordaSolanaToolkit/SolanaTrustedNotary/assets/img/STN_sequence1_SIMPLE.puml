@startuml

title Simplified Solana Trusted Notary Sequence Diagram

autonumber “<b>(N##)”
note over CP,CNN
Program deployed and initialized by R3 (single admin) prior to notarisation.
end note
box "Corda Participant" #pink 
actor CordaParticipant as CP
end box

box "Corda Notary Node" #LightGreen
participant "Corda Notary Node" as CNN
end box

box "Solana Cluster" #lightblue
participant "Solana Notary Program" as SNP
database "Solana Cluster (PDA Storage)" as SC
end box

CP -> CNN: <color green>**DF_STN_SUBMIT_REQUEST**</color> \n Submit notarisation request
CNN -> CNN: <color green>**DF_STN_VALIDATE_REQUEST**</color> \n Validate request

alt Request Invalid
    CNN -> CP: <color brown>**DF_STN_RETURN_FAILURE**</color> \n Return failure
else Request Valid
    CNN -> SNP: <color green>**DF_STN_INVOKE_COMMIT**</color> \n Invoke commit instruction
    SNP -> SC: <color green>**DF_STN_PROCESS_TRANSACTION**</color> \n Process transaction
    alt Double Spend Detected
        SNP -> CNN: <color brown>**DF_STN_RETURN_FAILURE**</color> \n Return failure
        CNN -> CP: <color brown>**DF_STN_NOTIFY_RESULT**</color> \n Notify failure
    else Transaction Successful
        SNP -> SC: <color green>**DF_STN_UPDATE_SOL_STATES**</color> \n Update state
        SNP -> CNN: <color green>**DF_STN_RETURN_SUCCESS**</color> \n Return success
        CNN -> CP: <color green>**DF_STN_NOTIFY_RESULT**</color> \n Notify success
    end
end

@enduml
        SNP -> SC: <color green>**DF_STN_CREATE_OUTPUT_ACCOUNT**</color> \n Create and initialize output account with transaction data
        SNP -> SNP: <color green>**DF_STN_PROCESS_INPUTS_REFERENCES**</color> \n Process inputs and references

        loop For each group in inputs and references
            SNP -> SC: <color green>**DF_STN_RETRIEVE_STATE_ACCOUNT**</color> \n Retrieve or create state account
            loop For each input index
                SNP -> SC: <color green>**DF_STN_CHECK_UNSPENT_BIT**</color> \n Verify bit is set (unspent)
                alt Unspent Bit is not set (DOUBLE SPEND)
                    SNP -> CNN: <color brown>**DF_STN_RETURN_FAILURE**</color> \n Return failure (Already consumed)
                    CNN -> CP: <color brown>**DF_STN_NOTIFY_RESULT**</color> \n Notify notarisation result (Already consumed)
                    break
                    end
                else Unspent Bit is set (FIRST SPEND)
                    SNP -> SC: <color green>**DF_STN_CLEAR_UNSPENT_BIT**</color> \n Clear bit (mark as spent)
                 
                end
            loop For each reference index
                SNP -> SC: <color green>**DF_STN_VERIFY_REFERENCE_BIT**</color> \n Verify bit is set (valid reference)
     
            end
        end

        SNP -> SC: <color green>**DF_STN_UPDATE_SOL_STATES**</color> \n Update stateRefs (Mark input states as spent, output states as unspent)
        SNP -> CNN: <color green>**DF_STN_RETURN_SUCCESS**</color> \n Return TX SUCCESS
        CNN -> CP: <color green>**DF_STN_NOTIFY_RESULT**</color> \n Notify notarisation result (SUCCESS)
    end
end

@enduml
