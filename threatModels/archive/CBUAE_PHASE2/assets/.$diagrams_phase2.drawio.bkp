        <mxCell id="3p2xxRXgxORGXaqv88Nc-17" value="&lt;div&gt;&lt;b&gt;Threat DoS:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Per request orchestrated/slower authorization verification&amp;nbsp;&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;opacity=60;horizontal=1;" parent="4WZXP__eG7i2tE0GjdjS-21" vertex="1">
