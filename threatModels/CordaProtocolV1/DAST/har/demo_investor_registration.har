ields\":{\"number\":\"DNI number\"}},\"col_gov_nuip_doc\":{\"name\":\"NUIP\",\"instructions\":\"Enter your full name and NUIP number. NUIP is unique personal identification number, composed of 10 digits. You can find NUIP number on your ID card (Cedula)\",\"fields\":{\"number\":\"NUIP\"}},\"col_gov_nuip\":{\"name\":\"NUIP\",\"instructions\":\"Enter your NUIP number and date of birth. NUIP is unique personal identification number, composed of 10 digits. You can find NUIP number on your ID card (Cedula)\",\"fields\":{\"number\":\"NUIP\"}},\"col_gov_runt_ani\":{\"name\":\"NUIP\",\"instructions\":\"You can find the NUIP printed on your National ID card or Passport document. It is a unique personal identification number that consists of 7-10 digits.\",\"fields\":{\"number\":\"NUIP\"}},\"arg_gov_id\":{\"name\":\"DNI number\",\"instructions\":\"Enter your DNI number and date of birth. DNI number is a unique personal identifier composed of 8 digits. You can find the DNI number on your DNI card or passport\",\"fields\":{\"number\":\"DNI number\",\"dob\":\"Date of birth\"}},\"per_gov_dni\":{\"name\":\"DNI\",\"instructions\":\"Enter your DNI number. DNI is a unique personal identifier composed of 8 digits. You can find the DNI number on your DNI card or passport\",\"fields\":{\"number\":\"DNI\",\"dob\":\"Date of birth\"}},\"per_gov_tin\":{\"name\":\"DNI\",\"instructions\":\"Enter your DNI number. DNI is a unique personal identifier composed of 8 digits. You can find the DNI number on your DNI card or passport\",\"fields\":{\"number\":\"DNI\",\"dob\":\"Date of birth\"}},\"mex_gov_rfc\":{\"name\":\"RFC\",\"instructions\":\"Enter your RFC number. RFC is a unique tax identifier composed of 13 digits and letters. You can obtain your RFC from SAT\",\"fields\":{\"number\":\"RFC\"}},\"mex_gov_curp_ekyc\":{\"name\":\"CURP number\",\"instructions\":\"You can find the CURP number printed on any valid identity document. CURP number is a unique personal identifier that consists of 18 digits and letters.\",\"fields\":{\"number\":\"CURP number\"}},\"mex_gov_curp\":{\"name\":\"CURP number\",\"instructions\":\"You can find the CURP number printed on any valid identity document. CURP number is a unique personal identifier that consists of 18 digits and letters.\",\"fields\":{\"additionalNumber\":\"CURP number\"}},\"bra_gov_cpf\":{\"name\":\"CPF number\",\"instructions\":\"You can find the CPF number printed on a valid National ID card, Driver's license, or Residence permit document. CPF number is a unique personal identifier that consists of 11 digits.\",\"fields\":{\"tin\":\"CPF number\"}},\"bra_crd_id\":{\"name\":\"CPF number\",\"instructions\":\"You can find the CPF number printed on a valid National ID card, Driver's license, or Residence permit document. CPF number is a unique personal identifier that consists of 11 digits.\",\"fields\":{\"tin\":\"CPF number\"}},\"bra_crd_cpf_prem\":{\"name\":\"CPF number\",\"instructions\":\"You can find the CPF number printed on a valid National ID card, Driver's license, or Residence permit document. CPF number is a unique personal identifier that consists of 11 digits.\",\"fields\":{\"tin\":\"CPF number\"}},\"aus_gov_dvs\":{\"name\":\"Passport\"},\"aus_gov_dvs__aus__passport\":{\"name\":\"Passport\",\"fields\":{\"number\":\"Passport number\"}},\"aus_gov_dvs__aus__drivers\":{\"name\":\"Drivers license\",\"fields\":{\"number\":\"Driver's license number\",\"additionalNumber\":\"Driver's card number\"}},\"aus_gov_dvs_visa\":{\"name\":\"Passport\",\"fields\":{\"number\":\"Foreign passport number\"}},\"idn_gov_nik\":{\"name\":\"NIK number\",\"instructions\":\"You can find the NIK number printed on your National ID card (KTP). NIK number is a unique personal identifier that consists of 16 digits.\",\"fields\":{\"firstName\":\"Full name\",\"tin\":\"NIK number\"}},\"fra_pst_eid\":{\"name\":\"Verification via L'Identité Numérique\",\"instructions\":\"Log in to your La Poste L'identité Numérique account to complete the identity verification process.\"},\"uzb_gov_id\":{\"name\":\"National ID / Passport number\",\"instructions\":\"Enter your National ID Card or Passport document number.\",\"fields\":{\"number\":\"National ID or Passport number\",\"firstName\":\"Given name\",\"lastName\":\"Surname\"}},\"uzb_gov_pinfl\":{\"name\":\"Personal identification number (PINFL)\",\"instructions\":\"You can find your PINFL on the National ID Card or Passport. PINFL is a unique personal identification number that consists of 14 digits.\",\"fields\":{\"tin\":\"Personal identification number (PINFL)\",\"firstName\":\"Given name\",\"lastName\":\"Surname\"}},\"ind_gov_aadhaar_digi\":{\"name\":\"Aadhaar via Digilocker\",\"instructions\":\"Log in to your DigiLocker account to complete the identity verification process.\\\\n\\\\nPlease note that accessing the DigiLocker platform requires an Indian network connection. If you are conducting the process from another location, please select a different verification method.\"},\"usa_gov_ssn\":{\"name\":\"Social security number (SSN)\",\"instructions\":\"You can obtain your SSN from the Social Security Administration.\"},\"nld_crd_idin\":{\"name\":\"iDIN\",\"instructions\":\"Login to your bank account to complete the identity verification process\",\"submitData\":\"Log in to your bank account\"},\"gbr_crd_bank\":{\"name\":\"Online banking\",\"instructions\":\"Please select a preferred banking platform to verify your information through a standard login process.\",\"submitData\":\"Continue\"},\"intl_crd_pennydrop\":{\"name\":\"Penny drop\",\"instructions\":\"Please select a preferred banking platform to verify your information by making a quick nominal payment. Payment processing may take up to a day, depending on your bank. It will be refunded to you within 48 hours.\",\"submitData\":\"Proceed\"},\"arg_int_dni\":{\"name\":\"DEMO\",\"instructions\":\"DEMO provider for testing purposes only.\\\\n\\\\n All inputs GREEN except: \\\\n\\\\n1. *****001 - DB is down\\\\n2. *****002 - Not found in DB\\\\n3. *****003 - No photo in DB\\\\n4. *****004 - External face match RED\\\\n5. *****005 - External face match FAILED\\\\n6. *****006 - External face match retry\\\\n7. *****007 - Provided doc expired\\\\n\\\\n\",\"fields\":{\"number\":\"DNI\"}},\"nor_bankid_nbid_bid\":{\"name\":\"BankID\",\"instructions\":\"Login to the BankID platform by entering your National identification number (NIN) and unique authentication credentials.\",\"submitData\":\"Continue\"},\"dnk_bankid_mitid\":{\"name\":\"MitID\",\"instructions\":\"Log in to the MitID platform by entering your authentication credentials and Personal identification (CPR) number.\",\"submitData\":\"Login\"},\"intl_prp_residency_1x1\":{\"instructions\":\"Enter your personal information and address details\",\"name\":\"Address verification\"},\"intl_prp_residency_2x2\":{\"instructions\":\"Enter your personal information and address details\",\"name\":\"Address verification\"},\"intl_prp_residency_2x2__aus__tax_payer_number_doc\":{\"instructions\":\"Enter your personal information and address details\",\"name\":\"Address verification\"},\"intl_prp_residency_2x2__aus__passport\":{\"instructions\":\"Enter your personal information and address details\",\"name\":\"Address verification (Passport)\",\"fields\":{\"number\":\"Passport number\"}},\"intl_prp_residency_2x2__aus__drivers\":{\"instructions\":\"Enter your personal information and address details\",\"name\":\"Address verification (Drivers)\",\"fields\":{\"number\":\"Driver's license number\",\"additionalNumber\":\"Driver's card number\"}},\"intl_prp_residency_2x2__aus__visa\":{\"instructions\":\"Enter your personal information and address details\",\"name\":\"Address verification (Visa)\",\"fields\":{\"number\":\"Foreign passport number\"}},\"gbr_prp_residency_1x1\":{\"instructions\":\"Enter your personal information and address details\",\"name\":\"Address verification\"},\"gbr_prp_residency_2x2\":{\"instructions\":\"Enter your personal information and address details\",\"name\":\"Address verification\"},\"eu_crd_ob\":{\"name\":\"Online banking\",\"instructions\":\"Login to your bank account\",\"fields\":{\"europe_crd_ob_bank_id\":\"Bank\"},\"placeholders\":{\"europe_crd_ob_bank_id\":\"Select your bank\"}},\"gbr_gov_evisa\":{\"name\":\"eVisa\",\"instructions\":\"**Generating a Share Code**\\\\n\\\\n1. Make sure you have created an [account on the UKVI platform](https://www.gov.uk/update-uk-visas-immigration-account-details/update-your-ukvi-account) to access your eVisa.\\\\nNote: British and Irish citizens should continue the onboarding using another verification method.\\\\n\\\\n2. To successfully complete the verification process, generate a Share Code by selecting the **\\\\\"To prove my immigration status for anything else\\\\\"** option on the UK Home Office platform.\\\\n\\\\n3. Please follow the steps [here](https://view-immigration-status.service.gov.uk/get-share-code) to generate a share code correctly.\\\\n\\\\nBy clicking Continue you agree to share all personal information linked to your eVisa record, managed by the UK Visas and Immigration (UKVI) Department under the Home Office, for the purpose of identity verification.\",\"fields\":{\"number\":\"Share Code\",\"dob\":\"Birth date\"}},\"can_crd_idv\":{\"name\":\"Non-Doc Identity Verification\",\"fields\":{\"state\":\"Province\",\"street\":\"Street\",\"flatNumber\":\"Apartment number\",\"postCode\":\"Postal code\",\"buildingNumber\":\"Civic number\"}},\"sau_gov_poa\":{\"name\":\"Saudi Postal Service\",\"instructions\":\"**Find your Proof number by following the steps below:**\\\\n\\\\n1. [Log in to your SPL account,](https://accounts.splonline.com.sa/ar/Account/Login?ReturnUrl=%2Fconnect%2Fauthorize%2Fcallback%3Fredirect_uri%3Dhttps%253A%252F%252Feservices.splonline.com.sa%252Fcallback%26client_id%3Dextrsure%26response_type%3Dcode%26state%3DIGBGpNqFK0%26scope%3Dopenid%2520email%2520profile%2520offline_access%2520baridi_apis%2520portal_services_apis%26code_challenge%3DZBn9Vsrf3xdeerdbG8ddXjgAoRTS_6xFF8TXF6Z--dU%26code_challenge_method%3DS256) \\\\n\\\\n2. Go to **\\\\\"My Addresses\\\\\"** section on the main page and click **\\\\\"View all\\\\\"**,\\\\n\\\\n3. Select your **\\\\\"National Address\\\\\"** from the list,\\\\n\\\\n4. At the top left, click on **\\\\\"More options\\\\\"** and select **\\\\\"View Proof Address\\\\\"**,\\\\n\\\\n5. The **Proof number** (رقم الإثبات) is displayed at the top-left corner of the document.\",\"fields\":{\"number\":\"National ID number\",\"additionalNumber\":\"Proof Number\"}},\"chl_gov_run\":{\"name\":\"RUN (RUT) number\",\"instructions\":\"You can find the RUN printed on the Identity card (Cédula de Identidad). RUN number is a unique personal identifier that consists of 8 digits followed by a verification digit, which can be a number from 0-9 or the letter \\\\\"K\\\\\".\",\"fields\":{\"number\":\"RUN (RUT)\"}},\"sgp_gov_singpass\":{\"name\":\"Singpass\",\"instructions\":\"You’ll be redirected to the official Singpass site to log in and share your verified Myinfo details securely. Your information is protected and will only be used for verification.\",\"fields\":{\"uinfin\":\"NRIC/FIN\",\"name\":\"Name\",\"sex\":\"Sex\",\"dob\":\"Date of Birth\",\"nationality\":\"Nationality\",\"address\":\"Registered Address\",\"passport_number\":\"Passport number\",\"passport_expiry_date\":\"Passport expiry date\",\"pass_type\":\"Pass type\",\"pass_status\":\"Pass status\",\"pass_expiry_date\":\"Pass expiry date\",\"mobile_number\":\"Mobile number\",\"email\":\"Email\"}},\"tha_gov_id_dopa\":{\"name\":\"National ID card\",\"instructions\":\"You can find the National ID card number printed on front side of the physical document, and laser code located on the back side. National ID card number is a unique document identifier that consists of 13 digits. Laser code consist of 2 letters followed by 10 digits.\",\"fields\":{\"number\":\"National ID card number\",\"firstNam