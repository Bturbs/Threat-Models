rch\",\n        \"noResults\" : \"Nothing found\",\n        \"selectNItems\" : \"Select {count} option | Select {count} options\",\n        \"resultsCount\" : \"Found {count} of {total} option | Found {count} of {total} options\",\n        \"andNItemsMore\" : \"Use search to find more items\",\n        \"clearSearchAriaLabel\" : \"Clear search\"\n      },\n      \"sdkTabs\" : {\n        \"ariaLabel\" : \"Tabs\"\n      },\n      \"prompt\" : {\n        \"cancelButtonLabel\" : \"Cancel\",\n        \"deleteButtonLabel\" : \"Delete\"\n      },\n      \"globalError\" : {\n        \"initErrorTitle\" : \"Verification expired\",\n        \"initError\" : \"Contact {clientContact} to start new verification\",\n        \"initErrorFallback\" : \"Contact our support to start new verification\",\n        \"selfHostedInitErrorTitle\" : \"Verification expired\",\n        \"selfHostedInitError\" : \"Contact {clientContact} to start new verification\",\n        \"selfHostedInitErrorFallback\" : \"Contact our support to start new verification\",\n        \"navigationErrorTitle\" : \"Navigation error\",\n        \"navigationError\" : \"Sorry, something went wrong with navigation. Please contact our support team.\",\n        \"unknownErrorTitle\" : \"Something went wrong\",\n        \"unknownError\" : \"Try again or use a different device\",\n        \"originErrorTitle\" : \"Unknown url\",\n        \"originError\" : \"Initialization failed due to an unknown URL. Please contact our support team.\",\n        \"reloadButtonLabel\" : \"Try again\",\n        \"networkError\" : \"Check your internet connection and try again\",\n        \"networkErrorTitle\" : \"You're offline\",\n        \"error403\" : \"Access denied\",\n        \"error403Text\" : \"You don't have permission to access this page. Please contact our support team.\",\n        \"captchaLoadError\" : \"Could not connect to the reCAPTCHA service.\\n\\nPlease check your internet connection and reload to get a reCAPTCHA challenge.\",\n        \"requestTimeoutError\" : \"Request timed out. Please check your internet connection and try again.\"\n      },\n      \"errorScreen\" : {\n        \"goBackButtonLabel\" : \"Go back\",\n        \"unknownError\" : {\n          \"title\" : \"Something went wrong\",\n          \"instruction\" : \"Try again or use a different device\"\n        }\n      },\n      \"permissionsScreen\" : {\n        \"allow\" : {\n          \"geolocation\" : {\n            \"title\" : \"Provide your address information\",\n            \"main\" : \"We require you to enable your location so that we can confirm your residence address automatically\",\n            \"enableButtonLabel\" : \"Enable location\"\n          },\n          \"onlyCamera\" : {\n            \"title\" : \"Allow camera access\",\n            \"main\" : \"To continue the verification, we need access to your device’s camera.\",\n            \"extraDesktop\" : \"Give your browser a permission to use your camera by clicking the \\\"Allow\\\" button in the window in upper left corner or use your mobile device to pass the verification.\",\n            \"extraMobile\" : \"When prompted, you need to allow camera access to continue.\"\n          },\n          \"cameraAndMicrophone\" : {\n            \"title\" : \"Allow camera and microphone access\",\n            \"main\" : \"To continue the verification, we need access to your device’s camera and microphone.\",\n            \"extraDesktop\" : \"Give your browser a permission to use your camera and microphone by clicking the \\\"Allow\\\" button in the window in upper left corner or use your mobile device to pass the verification.\",\n            \"extraMobile\" : \"When prompted, you need to allow camera and microphone access to continue.\"\n          },\n          \"continueButtonLabel\" : \"Continue\"\n        },\n        \"notAllowed\" : {\n          \"geolocationVpn\" : {\n            \"title\" : \"Turn off VPN or Location Services\",\n            \"main\" : \"A VPN or similar software might be affecting your geolocation. To verify your location accurately, please turn off any VPN or similar services\",\n            \"retryButtonLabel\" : \"I’ve turned off all services\"\n          },\n          \"incompatible\" : {\n            \"ios\" : \"You must use Safari on iOS. iOS does not support camera access in other browsers.\",\n            \"miui\" : \"Mi Browser has compatibility issues. Use another browser like Google Chrome or try on a different device.\",\n            \"facebook\" : \"Facebook App has compatibility issues. Use another browser like Google Chrome or try on a different device.\"\n          },\n          \"continueButtonLabel\" : \"Continue\",\n          \"confirmAlert\" : {\n            \"toastSubtitle\" : \"Follow the instructions on the screen to set up permissions.\",\n            \"toastTitle\" : {\n              \"camera\" : \"Allow access to your camera and try again\",\n              \"cameraAndMicrophone\" : \"Allow access to your camera and microphone and try again\",\n              \"location\" : \"Allow access to your location and try again\"\n            }\n          },\n          \"instructions\" : {\n            \"stepMediaAriaLabel\" : \"Step {stepNumber}\",\n            \"camera\" : {\n              \"title\" : \"Give browser permission to use your camera:\",\n              \"titleApp\" : \"Give app permission to use your camera:\",\n              \"cases\" : {\n                \"iosSafariWebview\" : [ \"Go to device Settings→Apps\", \"Find the app you’re using now\", \"Switch the Camera settings to On\", \"Return here and try the camera again\" ],\n                \"iosSafariFullpage\" : [ \"Go to device Settings→Apps→Safari\", \"Scroll down to Settings for Websites\", \"Tap the Camera and select Allow\", \"Return here and try the camera again\" ],\n                \"iosChromeFullpage\" : [ \"Go to device Settings→Apps→Chrome\", \"Switch the Camera settings to On\", \"Return here and try the camera again\" ],\n                \"iosOtherFullpage\" : [ \"Go to device Settings→Apps\", \"Find the app you’re using now\", \"Switch the Camera settings to On\", \"Return here and try the camera again\" ],\n                \"macSafariFullpage\" : [ \"Go to the website address bar and click the site information icon on the left\", \"Open Website Settings\", \"Go to Camera and select Allow\", \"Return here and try the camera again\" ],\n                \"macChromeFullpage\" : [ \"Go to the website address bar and click the site information icon on the left\", \"Find Camera and switch its settings to On\", \"Return here and try the camera again\" ],\n                \"androidChromeWebview\" : [ \"Go to device Settings→Chrome\", \"Scroll to Permissions, open it, and find Camera\", \"Select Allow only while using the app. Go back and do the same for the Microphone\", \"Return here and try again\" ],\n                \"androidChromeFullpage\" : [ \"Go to the website address bar and tap the site information icon on the left\", \"Open Permissions\", \"Switch the Camera settings to On\", \"Return here and try the camera again\" ],\n                \"androidOtherWebview\" : [ \"Go to device Settings\", \"Find the app you’re using now\", \"Scroll down to Permissions and open it\", \"Find Camera and select Allow only while using the app\", \"Return here and try the camera again\" ],\n                \"androidOtherFullpage\" : [ \"Go to the website address bar and tap the site information icon on the left\", \"Find Permissions→Camera and select Allow\", \"Return here and try the camera again\" ],\n                \"windowsChromeFullpage\" : [ \"Go to the website address bar and click the site information icon on the left\", \"Find Camera and switch its settings to On\", \"Return here and try the camera again\" ],\n                \"windowsOtherFullpage\" : [ \"Go to the browser menu (three horizontal lines) or click the icon on the left of the address bar\", \"Find Permissions→Camera and select Allow\", \"Return here and try the camera again\" ],\n                \"macOtherFullpage\" : [ \"Go to the browser menu (three horizontal lines) or click the icon on the left of the address bar\", \"Find Permissions→Camera and select Allow\", \"Return here and try the camera again\" ]\n              }\n            },\n            \"cameraAndMicrophone\" : {\n              \"title\" : \"Give browser permission to use your camera and microphone:\",\n              \"titleApp\" : \"Give app permission to use your camera and microphone:\",\n              \"cases\" : {\n                \"iosSafariWebview\" : [ \"Go to device Settings→Apps\", \"Find the app you’re using now\", \"Switch the Microphone and Camera settings to On\", \"Return here and try again\" ],\n                \"iosSafariFullpage\" : [ \"Go to device Settings→Apps→Safari\", \"Scroll down to Settings for Websites\", \"Tap Camera and select Allow\", \"Go back and do the same for the Microphone\", \"Return here and try again\" ],\n                \"iosChromeFullpage\" : [ \"Go to device Settings→Apps→Chrome\", \"Switch the Microphone and Camera settings to On\", \"Return here and try again\" ],\n                \"iosOtherFullpage\" : [ \"Go to device Settings→Apps\", \"Find the app you’re using now\", \"Switch the Microphone and Camera settings to On\", \"Return here and try again\" ],\n                \"macSafariFullpage\" : [ \"Go to the website address bar and click the site information icon on the left\", \"Open Website Settings\", \"Go to Camera and select Allow. Then, do the same for the Microphone\", \"Return here and try again\" ],\n                \"macChromeFullpage\" : [ \"Go to the website address bar and click the site information icon on the left\", \"Find the Camera and Microphone, then switch their settings to On\", \"Return here and try again\" ],\n                \"androidChromeWebview\" : [ \"Go to device Settings→Chrome\", \"Scroll to Permissions, open it, and find Camera\", \"Select Allow only while using the app. Go back and do the same for the Microphone\", \"Return here and try again\" ],\n                \"androidChromeFullpage\" : [ \"Go to the website address bar and tap the site information icon on the left\", \"Open Permissions\", \"Switch the Camera and Microphone settings to On\", \"Return here and try again\" ],\n                \"androidOtherWebview\" : [ \"Go to device Settings\", \"Find the app you’re using now\", \"Scroll to Permissions, open it, and find Camera\", \"Select Allow only while using the app. Go back and do the same for the Microphone\", \"Return here and try again\" ],\n                \"androidOtherFullpage\" : [ \"Go to the browser menu (three horizontal lines) or tap the icon on the left of the address bar\", \"Find Permissions→Camera and select Allow\", \"Do the same for the Microphone\", \"Return here and try again\" ],\n                \"windowsChromeFullpage\" : [ \"Go to the website address bar and click the site information icon on the left\", \"Find the Camera and Microphone, then switch their settings to On\", \"Return here and try again\" ],\n                \"windowsOtherFullpage\" : [ \"Go to the browser menu (three horizontal lines) or click the icon on the left of the address bar\", \"Find Permissions→Camera and select Allow\", \"Do the same for the Microphone\", \"Return here and try again\" ],\n                \"macOtherFullpage\" : [ \"Go to the browser menu (three horizontal lines) or click the icon on the left of the address bar\", \"Find Permissions→Camera and select Allow\", \"Do the same for the Microphone\", \"Return here and try again\" ]\n              }\n            },\n            \"location\" : {\n              \"title\" : \"Give browser permission to use your location:\",\n              \"titleApp\" : \"Give app permission to use your location:\",\n              \"cases\" : {\n                \"iosSafariWebview\" : [ \"Go to device Settings→Apps\", \"Find the app you’re using now\", \"Go to Location and select While Using the App\", \"Return here and try again\" ],\n                \"iosSafariFullpage\" : [ \"Go to device Settings→Apps→Safari\", \"Scroll down to Settings for Websites\", \"Tap Location and select Allow\", \"Return here and try again\" ],\n                \"iosChromeFullpage\" : [ \"Go to device Settings→Apps→Chrome\", \"Open Location\", \"Select While Using the App\", \"Return here and try again\" ],\n                \"iosOtherFullpage\" : [ \"Go to device Settings→Apps\", \"Find the app you’re using now\", \"Go to Location and select While Using the App\", \"Return here and try again\" ],\n                \"macSafariFullpage\" : [ \"Go to the website address bar and click the site information icon on the left\", \"Open Website Settings\", \"Go to Location and select Allow\", \"Return here and try again\" ],\n                \"macChromeFullpage\" : [ \"Go to the website address bar and click the site information icon on the left\", \"Find Location and switch its settings to On\", \"Return here and try again\" ],\n                \"androidChromeWebview\" : [ \"Go to device Settings→Chrome\", \"Scroll to Permissions, open it, and find Location\", \"Select Allow only while using the app\", \"Return here and try again\" ],\n                \"androidChromeFullpage\" : [ \"Go to the website address bar and tap the site information icon on the left\", \"Open Permissions\", \"Switch the Location settings to On\", \"Return here and try again\" ],\n                \"androidOtherWebview\" : [ \"Go to device Settings\", \"Find the app you’re using now\", \"Scroll to Permissions, open it, and find Location\", \"Select Allow only while using the app\", \"Return here and try again\" ],\n                \"androidOtherFullpage\" : [ \"Go to the browser menu (three horizontal lines) or tap the icon on the left of the address bar\", \"Find Permissions→Location and select Allow\", \"Return here and try again\" ],\n                \"windo