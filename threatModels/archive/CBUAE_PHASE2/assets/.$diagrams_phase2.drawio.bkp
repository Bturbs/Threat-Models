        <mxCell id="3p2xxRXgxORGXaqv88Nc-18" value="&lt;div&gt;&lt;b&gt;Threat Elevation of Privileges&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Policy enforcement &lt;br&gt;PEP on service should not be optional&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;opacity=60;horizontal=1;" parent="4WZXP__eG7i2tE0GjdjS-21" vertex="1">
