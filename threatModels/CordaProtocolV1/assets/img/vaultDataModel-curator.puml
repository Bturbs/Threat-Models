@startuml
' REVIEWED_MAIN_2026_05_18: aligned to RBAC fast-forward 63739244; authority via RBAC program.

' left to right direction
scale max 3200 width
skinparam wrapWidth 220
allowmixing


!include common-styles.puml

!include onchain_data_module.puml


' ========================================
' Settlement Instructions (RBAC-gated)
' ========================================

package "Settlement Instructions (RBAC-gated)" <<Rectangle>> {
    INSTRUCTION SettleInvestment <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/settle_investment.rs]] {
        --
        Settles a pending large investment proposal.
        Mints vTokens to investor at settlement NAV
        while validating available aToken backing.
        **Authorization:** Authority (via RBAC)
        **Critical:** whitelist entry required
    }

    INSTRUCTION RejectInvestment <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/reject_investment.rs]] {
        --
        Rejects pending proposal,
        refunds USDC to investor,
        and marks proposal as rejected.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION SettleRedemption <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/redemptions/settle_redemption.rs]] {
        --
        Settles pending redemption:
        computes payout from NAV,
        burns escrowed vTokens,
        and transfers USDC to investor.
        **Authorization:** Authority (via RBAC)
    }

    INSTRUCTION TransferToTokenizer <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/investments/transfer_to_tokenizer.rs]] {
        --
        Transfer USDC from vault to
        external tokenizer destination.
        Sets proposal status = Accepted.
        Idempotent for Accepted proposals.
        **Authorization:** Authority (via RBAC)
    }

    ' DEPRECATED: auto-invest order feature removed in vault-modularization

    ' Layout hints: stack settlement instructions vertically
    SettleInvestment -[hidden]right-> RejectInvestment
    RejectInvestment -[hidden]right-> SettleRedemption
    SettleRedemption -[hidden]right-> TransferToTokenizer
}

' Force instructions LEFT of Solana state
"Settlement Instructions (RBAC-gated)" -[hidden]down-> "Solana On-Chain Accounts"


' ========================================
' Relationships: Instructions → State (Settlement)
' ========================================

SettleInvestment --> InvestmentProposal : W (settle)
SettleInvestment --> Vault : W
SettleInvestment --> VTokenMint : W (mint)
SettleInvestment --> InvestorVTokenAccount : W (mint)
SettleInvestment --> VaultATokenAccount : R (backing)

RejectInvestment --> InvestmentProposal : W (reject)
RejectInvestment --> InvestorUSDCAccount : W (refund)
RejectInvestment --> VaultUSDCAccount : W (debit)

SettleRedemption --> RedemptionProposal : W (settle)
SettleRedemption --> Vault : W
SettleRedemption --> VTokenMint : W (burn escrow)
SettleRedemption --> InvestorUSDCAccount : W (credit)
SettleRedemption --> VaultUSDCAccount : W (debit)

TransferToTokenizer --> InvestmentProposal : W (accept)
TransferToTokenizer --> VaultUSDCAccount : W (transfer)

' ========================================
' Relationships: Programs → State (ownership)
' ========================================

VaultProgram --> Vault : owns
VaultProgram --> VaultWhitelistEntry : manages
VaultProgram --> InvestmentProposal : manages
VaultProgram --> RedemptionProposal : manages
LiquidityProgramRemoved --> LiquidityPoolRemoved : archived reference

' ========================================
' Relationships: State → Token Accounts
' ========================================

Vault --> VTokenMint : mint_authority

InvestorVTokenAccount --> VTokenMint : mint
InvestorUSDCAccount --> USDCMint : mint


@enduml
