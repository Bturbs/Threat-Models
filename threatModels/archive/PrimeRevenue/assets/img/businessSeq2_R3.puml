@startuml businessSeq2_R3
' ...existing code... (file previously empty) ...

' ' Styling similar to business-style sequence diagrams
' skinparam sequenceMessageBackgroundColor #E8F0FE
' skinparam sequenceActorBackgroundColor #F7F9FF
' skinparam sequenceLifeLineBorderColor #2B6CB0
' skinparam sequenceLifeLineBackgroundColor #FFFFFF
' skinparam sequenceParticipantPadding 12
' skinparam titleBorderRoundCorner 15

title PrimeRevenue — ENI Tokenization & Investor Rolling Purchase (Use Case 1)

' Replace flat participants with boxed, colored groups (matching style of businessSeq1.puml)
box "Supplier" #pink
  actor "Supplier" as SUPPLIER
end box

box "Buyer" #lightyellow
  actor "Buyer / Buyer Bank" as BUYER
end box

box "Investor" #lightgreen
  actor "Investor" as INVESTOR
  ' optional wallet participant if desired:
  participant "Investor\nR3Prime Wallet" as INVESTOR_WALLET
end box

box "PrimeRevenue\nPlatform" #lightblue
  participant "PrimeRevenue\nPlatform" as PR
  participant "PrimeRevenue\nTreasury" as TREASURY
end box

box "R3 / Solana" #lightgrey
  participant "R3 ENI\nRegistry" as ENI_REG
  participant "Solana Vault\n(initial holder)" as VAULT
end box

box "Payments / Bridge" #wheat
  participant "Stablecoin\nBridge" as SC_BRIDGE
end box

== Step 1: Invoice batching & ENI creation ==
PR -> PR : Batch invoices (by buyer + maturity)\nGenerate ENI reference (ENI_ID)\nPrepare ENI payload
activate PR
PR -> ENI_REG : Submit ENI payload (identifiers, terms, jurisdiction, metadata)
note right of ENI_REG : Validate payload\nStore ENI metadata (off-chain vs on-chain split)
ENI_REG -> PR : Acknowledge (ENI_ID) / store ref
deactivate PR

note over PR,ENI_REG : End Step 1 — ENI defined & registered

== Step 2: Mint ENI as SPL token and initial status ==
' PR -> ENI_REG : Request minting of ENI token (SPL)
activate ENI_REG
ENI_REG -> VAULT : Mint SPL token (ENI_TOKEN) -> set holder VAULT\nSet status: Issued
note right of VAULT : Vault holds token as initial holder\nSupplier remains legal owner (off-chain record)
' ENI_REG -> PR : Mint event recorded (UTC timestamp + cryptographic hash)
deactivate ENI_REG

== Step 3: Investor rolling / subscription and purchase ==
loop Rolling purchases (automated subscription)
    INVESTOR -> PR : Subscribe / set filters (credit, yield, tenure)\nFund R3Prime wallet (stablecoins)
    alt matching ENI available
        INVESTOR -> SC_BRIDGE : Transfer stablecoins to Vault (via bridge)
        activate SC_BRIDGE
        SC_BRIDGE -> VAULT : Deposit stablecoins to Vault (segregated)
        VAULT -> TREASURY : Direct stablecoins to PrimeRevenue treasury wallet
        ' SC_BRIDGE -> TREASURY : Instruct transfer to PrimeRevenue treasury
        note right of TREASURY : TREASURY receives stablecoin or fiat\n(Conversion may occur later)
        deactivate SC_BRIDGE

        VAULT -> ENI_REG : Transfer ownership of ENI_TOKEN -> Investor (Holder in Due Course)
        activate ENI_REG
        ENI_REG -> ENI_REG : Update status Issued -> Transferred\nRecord purchase event (UTC timestamp + cryptographic hash)
        ENI_REG -> INVESTOR : Confirm token transfer
        deactivate ENI_REG

        VAULT -> TREASURY : Forward stablecoins to PrimeRevenue treasury wallet
        note right of TREASURY : Record funding event, Update status from 'Issued' to 'Transferred'
        VAULT -> ENI_REG : Record purchase event\n UTC timestamp \n cryptographic hash
    else no match
        note over INVESTOR : Wait for next available ENI
    end
end

== Step 4: Treasury funding & supplier disbursement ==
group Funding & Disbursement (T+1)
    TREASURY -> PR : Notify funds received
    activate PR
    alt stablecoin -> fiat conversion required
        PR -> "Fiat On/Off-ramp\nProvider" as ONRAMP : Convert stablecoin -> FIAT USD
        ONRAMP -> PR : FIAT credited
    end
    PR -> SUPPLIER : Disburse FIAT to Supplier (T+1 settlement)
    note right of PR : Record funding and disbursement events in ENI registry
    PR -> ENI_REG : Record disbursement event (hash + timestamp)
    deactivate PR
end

== Step 5: Maturity & final settlement ==
note over BUYER,PR : At maturity date
BUYER -> PR : Buyer repays face amount (off-chain bank transfer)
activate PR
PR -> TREASURY : Receive maturity funds (FIAT)
PR -> ENI_REG : Update ENI status Transferred -> Settled\nRecord settlement event (timestamp + hash)
ENI_REG -> VAULT : Notify settled state
deactivate PR

' group R3 disburses to current holder
'     ENI_REG -> VAULT : Instruct vault to release proceeds to current holder (Investor)
'     VAULT -> TREASURY : (if funds routed on-chain) transfer stablecoins -> Investor or via bridge
'     note right of INVESTOR : Investor receives maturity payment
' end

' == Notes & audit ==
' note left of ENI_REG
'   All critical events recorded:\n- Mint event\n- Purchase transfer\n- Funding/disbursement event\n- Settlement event\nEach with UTC timestamp and cryptographic hash for auditability.
' end note

' footer
'   ENI lifecycle: Issued -> Transferred -> Settled\nDiagram: Use Case 1 — single investor rolling purchases (MVP)
' endfooter

@enduml