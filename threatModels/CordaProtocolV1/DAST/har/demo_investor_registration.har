,27:`Хабаровский Край`,19:`Хакасия Республика`,86:`Ханты-Мансийский Автономный округ - Югра Автономный округ`,74:`Челябинская Область`,20:`Чеченская Республика`,21:`Чувашская Республика - Чувашия`,87:`Чукотский Автономный округ`,88:`Эвенкийский Автономный округ`,89:`Ямало-Ненецкий Автономный округ`,76:`Ярославская Область`,90:`Запорожская область`,93:`Донецкая Народная Республика`,94:`Луганская Народная Республика`,95:`Херсонская область`},CAN:{ON:`Ontario`,QC:`Quebec`,NS:`Nova Scotia`,NB:`New Brunswick`,MB:`Manitoba`,BC:`British Columbia`,PE:`Prince Edward Island`,SK:`Saskatchewan`,AB:`Alberta`,NL:`Newfoundland and Labrador`,NT:`Northwest Territories`,NU:`Nunavut`,YT:`Yukon`}},customPhrases:{SELFIE:`I am not a robot`,VIDEO_SELFIE:`I am not a deepfake`,PAYMENT_SELFIE:`This payment method is mine`},countryDependingFields:{MYS:{tin:`NRIC`},JPN:{tin:`My number`},HKG:{tin:`HKID`,company:{registrationNumber:{label:`BRN number`,caption:`BRN number registered at Companies Registry Information System (ICRIS)`}}},BRA:{tin:`CPF`,company:{registrationNumber:{label:`CNPJ number`,caption:`CNPJ number registered at Ministry of Finance`}}},COL:{tin:`NUIP`,company:{registrationNumber:{label:`NIT number`,caption:`NIT number registered at Sistema de Información y Reporte Empresarial`}}},CHL:{tin:`RUN/RUT`},ARG:{number:`DNI`},USA:{tin:`Social security number (SSN)`,company:{registrationNumber:{label:`File Number`,caption:`Can be found on your registration documents you receive from the registrar such as account reminders`},taxId:{label:`EIN`,caption:`Federal tax identification number`}}},GBR:{tin:`National Insurance Number (NINO)`,company:{registrationNumber:{label:`CRN`,caption:`Registration number, 8 digits or 2 letters + 6 digits`},taxId:{label:`UTR`,caption:`Unique Taxpayer Reference, 10-digit number`}}},MEX:{tin:`RFC`,number:`CURP`},NGA:{tin:`BVN`,company:{registrationNumber:{label:`Company Registration Number`,caption:`Conjointly spelled 2-letter prefix (RC/BN/IT/LP) and 6-8 digits`}}},IDN:{tin:`NIK`},IND:{tin:`PAN`,company:{registrationNumber:{label:`Corporate Identification Number - CIN (for companies) or Udyam Registration Number (for MSMEs)`,caption:`CIN: 21-characters alphanumeric code, format: U12345DL2010PTC123456. Udyam: 16-characters code, format: UDYAM-XX-00-0000000`},taxId:{label:`Permanent Account Number (PAN)`}}},SWE:{tin:`Personal number`},DNK:{tin:`CPR`},FIN:{tin:`Personal identity code`},NOR:{tin:`National Identity Number/D-number`},ITA:{tin:`Tax ID`,company:{registrationNumber:{label:`REA number`,caption:`REA number registered at Chambers of Commerce National Business Register`}}},ESP:{tin:`NIF/NIE`},CAN:{tin:`SIN`,company:{registrationNumber:{label:`Corporation Number`,caption:`Company ID, 7-digit number without letter prefixes ON, BC, A`},taxId:{label:`Business Number (BN)`,caption:`9-digit number, received from Canada Revenue Agency (CRA)`}}},CHN:{tin:`Resident Identity Card Number`},SGP:{tin:`NRIC`},FRO:{tin:`P-number`},ISL:{tin:`Identification number`},LIE:{tin:`PEID number`},SMR:{tin:`SSI number`},TUR:{number:`T.C. Kimlik No`},THA:{number:`Thai ID number`},PHL:{number:`SSS number`},KEN:{number:`National ID number`},NZL:{tin:`IRD number`,number:`Driver license number`},ZAF:{number:`National ID number`,company:{registrationNumber:{label:`CIPC number`,caption:`CIPC number registered at Companies and Intellectual Property Commission (CIPC)`}}},PER:{number:`DNI`},POL:{tin:`PESEL`,number:`PESEL`,company:{registrationNumber:{label:`KRS number`,caption:`KRS number registered at Ministry of Development (MR) – Central Registration and Information on Business (CEIDG)`}}},GHA:{number:`Voter ID number`},CRI:{number:`National ID number`},AUS:{company:{registrationNumber:{label:`ACN number`,caption:`ACN number registered at Securities and Investments Commission (ASIC)`}}},NLD:{tin:`BSN`,company:{registrationNumber:{label:`KVK number`,caption:`KVK number registered at Kamer van Koophandel (KvK)`}}},FRA:{tin:`Tax ID`,company:{registrationNumber:{label:`SIREN number`,caption:`SIREN number registered at Infogreffe`}}},DEU:{tin:`Tax ID`,company:{registrationNumber:{label:`Handelsregister number`,caption:`Handelsregister number registered at Handelsregister - Commercial Register`}}},ARE:{company:{registrationNumber:{label:`Business license number`,caption:`License number registered at National Economic Register`}}},AUT:{tin:`Tax ID`},BEL:{tin:`National number`},BGR:{tin:`EGN`},HRV:{tin:`OIB`},CYP:{tin:`AFT`},CZE:{tin:`Personal number`},EST:{tin:`Personal identification code`},GRC:{tin:`AFM`},HUN:{tin:`Tax ID`},IRL:{tin:`PPS number`},LVA:{tin:`Personal number`},LTU:{tin:`Personal number`},LUX:{tin:`National identification number`},MLT:{tin:`Tax ID`},PRT:{tin:`NIF`},ROU:{tin:`CNP`},SVK:{tin:`Personal/Identity number`},SVN:{tin:`Tax ID`},ISR:{tin:`Teudat zehut`},KOR:{tin:`Resident registration number`},UGA:{tin:`Tax ID`},GGY:{tin:`Social security number`},IMN:{tin:`TRN`},URY:{tin:`RUT`}},customFields:{},ekyc:JSON.parse(`{\"sources\":{\"deu_gov_eid\":{\"name\":\"eID\",\"instructions\":\"To complete the verification, please have your eID Card and Personal Identification Number (PIN) ready.\"},\"nga_gov_bvn\":{\"name\":\"Bank verification number (BVN)\",\"instructions\":\"Your BVN is issued by the banking institution of your choice. BVN is a unique personal identification number that consists of 11 digits.\"},\"nga_gov_nin\":{\"name\":\"National identification number (NIN)\",\"instructions\":\"You can find the NIN printed on the National ID card (NIN Slip) or Driver's license document. NIN is a unique personal identification number that consists of 11 digits.\",\"fields\":{\"number\":\"NIN\"},\"placeholders\":{\"number\":\"12345678901\"}},\"nga_gov_nin_slip\":{\"name\":\"National identification number (NIN)\",\"instructions\":\"You can find the NIN printed on the National ID card (NIN Slip) or Driver's license document. NIN is a unique personal identification number that consists of 11 digits.\",\"fields\":{\"number\":\"NIN\"},\"placeholders\":{\"number\":\"12345678901\"}},\"nga_gov_nin_phone\":{\"name\":\"Phone number\",\"instructions\":\"Enter the Phone number associated with your National Identification Number (NIN) on the NINAuth application.\",\"fields\":{\"phone\":\"Phone number\"}},\"ken_gov_passport_docfree\":{\"name\":\"Passport number\",\"instructions\":\"You can find the Passport number printed on the physical document. Passport number is a unique document identifier that consists of 8 digits and letters.\",\"fields\":{\"number\":\"Passport number\"}},\"nga_gov_dl_docfree\":{\"name\":\"Driver's license number\",\"instructions\":\"You can find the Driver's license number printed on the physical document. Driver's license number is a unique document identifier that consists of 12 letters and digits.\",\"fields\":{\"number\":\"Driver licence number\"}},\"ken_gov_id_docfree\":{\"name\":\"National ID card number\",\"instructions\":\"You can find the National ID card number printed on the physical document. National ID card number is a unique document identifier that consists of 6 to 9 digits and should not be confused with its serial number.\",\"fields\":{\"number\":\"National ID card number\"}},\"zaf_gov_id_docfree\":{\"name\":\"National ID card\",\"instructions\":\"You can find the National ID card number printed on the physical document. National ID card number is a unique document identifier that consists of 13 digits.\",\"fields\":{\"number\":\"National ID card number\"},\"errors\":{\"9100\":\"Incorrect data entered or less than 18 years old\"}},\"fin_bankid_ftn\":{\"name\":\"Finland FTN Verification\",\"instructions\":\"Please select a preferred banking platform to verify your information through a standard login process.\"},\"zaf_gov_id_cache\":{\"name\":\"National ID card\",\"instructions\":\"You can find the National ID card number printed on the physical document. National ID card number is a unique document identifier that consists of 13 digits.\",