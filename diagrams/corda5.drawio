        <mxCell id="4gJDzPwMsVbXqHGC160j-24" value="PKCS Session objects: short lived keys in HSM:&lt;br&gt;&lt;ul&gt;&lt;li&gt;https://crypto.stackexchange.com/questions/60759/how-should-short-term-keys-keys-stored-in-ram-or-volatile-memory-be-described&lt;/li&gt;&lt;li&gt;http://docs.oasis-open.org/pkcs11/pkcs11-base/v2.40/os/pkcs11-base-v2.40-os.html#_Toc416959742&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=16;fontColor=#000000;fillColor=#e3c800;strokeColor=#B09500;align=left;" parent="HOtoMd6kcSFVbsdaHCLa-25" vertex="1">
