        <mxCell id="qHVov0-bhh_Yzi4WCpuj-38" value="RFI" parent="0" />
        <mxCell id="qHVov0-bhh_Yzi4WCpuj-39" value="Is this promotional, only in R3?&lt;div&gt;see question later...&lt;/div&gt;" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#e1d5e7;strokeColor=#9673a6;position2=0;opacity=70;" vertex="1" parent="qHVov0-bhh_Yzi4WCpuj-38">
          <mxGeometry x="868" y="274" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="qHVov0-bhh_Yzi4WCpuj-41" value="AuthNZ? scp with pinned certs?&lt;br&gt;key/cert storage?&lt;div&gt;compiled artifact, e.g. docker images are sent and stored finally in Nexus via Client Jenkins&lt;/div&gt;" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#e1d5e7;strokeColor=#9673a6;position2=0.47;opacity=70;" vertex="1" parent="qHVov0-bhh_Yzi4WCpuj-38">
          <mxGeometry x="317" y="907" width="285" height="89" as="geometry" />
        </mxCell>
        <mxCell id="qHVov0-bhh_Yzi4WCpuj-43" value="AuthNZ: out of scope... client infra , pls confirm" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#e1d5e7;strokeColor=#9673a6;position2=0.47;opacity=70;" vertex="1" parent="qHVov0-bhh_Yzi4WCpuj-38">
          <mxGeometry x="743" y="878" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="qHVov0-bhh_Yzi4WCpuj-45" value="RFI, how this is promoted? PR?&lt;br&gt;AuthNZ" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#e1d5e7;strokeColor=#9673a6;position2=0.47;opacity=70;" vertex="1" parent="qHVov0-bhh_Yzi4WCpuj-38">
          <mxGeometry x="651" y="1495" width="241" height="86" as="geometry" />
        </mxCell>
        <mxCell id="qHVov0-bhh_Yzi4WCpuj-46" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;sync via GlobalScape?&lt;br&gt;how environment &quot;PROD&quot; is selected&lt;br&gt;&lt;i&gt;&quot;&lt;span style=&quot;color: rgb(31, 35, 40); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, &amp;quot;Noto Sans&amp;quot;, Helvetica, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;; text-align: start;&quot;&gt;Once synchronization is complete, a pull request can be generated against the client’s version control, initiating the standard deployment process.&quot;&lt;/span&gt;&lt;/i&gt;&lt;/font&gt;" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#e1d5e7;strokeColor=#9673a6;position2=0.47;opacity=70;" vertex="1" parent="qHVov0-bhh_Yzi4WCpuj-38">
          <mxGeometry x="735" y="2090" width="273" height="159" as="geometry" />
        </mxCell>
        <mxCell id="qHVov0-bhh_Yzi4WCpuj-47" value="is there really no link between pre-prod a prod in client side?" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#e1d5e7;strokeColor=#9673a6;position2=0.47;opacity=70;" vertex="1" parent="qHVov0-bhh_Yzi4WCpuj-38">
          <mxGeometry x="651" y="2348" width="241" height="86" as="geometry" />
        </mxCell>
        <mxCell id="qHVov0-bhh_Yzi4WCpuj-48" value="is this true for both: environment and solution deployment?" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#e1d5e7;strokeColor=#9673a6;position2=0.47;opacity=70;" vertex="1" parent="qHVov0-bhh_Yzi4WCpuj-38">
          <mxGeometry x="83" y="1488" width="241" height="86" as="geometry" />
        </mxCell>
        <mxCell id="qHVov0-bhh_Yzi4WCpuj-49" value="How hashicorp valut inject credentials&lt;br&gt;PKI root certs, keys, DB cred etc...&lt;br&gt;hashicorp cred storage?" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#e1d5e7;strokeColor=#9673a6;position2=0.47;opacity=70;" vertex="1" parent="qHVov0-bhh_Yzi4WCpuj-38">
