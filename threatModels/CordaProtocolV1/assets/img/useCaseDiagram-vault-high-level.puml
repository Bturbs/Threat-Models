@startuml
' REVIEWED_MAIN_2026_05_13: aligned to current merged code; large-investment retained pending simplification merge.
title Corda Protocol V1 — Vault Use Cases (High Level)

left to right direction

skinparam usecase {
    BackgroundColor<<vault>> LightYellow
    BackgroundColor<<liquidity>> LightCyan
    BackgroundColor<<acl>> LightCoral
    BackgroundColor<<compliance>> #FFE0B2
    BackgroundColor<<tokenizer>> LightSalmon
    BackgroundColor<<platform>> #E8EAF6
    BorderColor Black
    ArrowColor #333333
    Style Shadowing
}

skinparam rectangle {
    BorderColor #555555
    BackgroundColor #FAFAFA
    RoundCorner 10
}

' ========================================
' Actor color definitions
' ========================================
!define COLOR_ADMIN    #1B5E20
!define COLOR_CURATOR  #0da130
!define COLOR_INVESTOR #030303
!define COLOR_MANAGER  #E65100
!define COLOR_TOKENIZER #B71C1C
!define COLOR_COMPLIANCE #00695C

' ========================================
' Actors
' ========================================

actor "Admin\n(Deployer)" as admin #C8E6C9
actor "Curator" as curator #BBDEFB
actor "Investor /\nAllocator" as investor #E1BEE7
actor "Liquidity\nManager" as manager #FFE0B2
actor "Tokenizer\n(Issuer)" as tokenizer #FFCDD2
actor "Compliance\nOfficer" as compliance #B2DFDB

' ========================================
' Vault On-Chain Program
' ========================================
rectangle "Vault Program (Solana)" {

    usecase "Deploy & Initialize\nVault Contracts" as UC_Deploy <<vault>>
    usecase "Manage Vault\nConfiguration & Lifecycle" as UC_Config <<vault>>
    usecase "Settle & Approve\nInvestments" as UC_Settle <<vault>>
    usecase "Process\nRedemptions" as UC_Redeem <<vault>>
    usecase "Manage NAV" as UC_NAV <<vault>>
    usecase "Invest USDC\ninto Vault" as UC_Invest <<vault>>
    usecase "Redeem vTokens\nfor USDC" as UC_RedeemInvestor <<vault>>
    usecase "Accrue & Collect Fees\n(permissionless)" as UC_AccrueFees <<vault>>
}

' ========================================
' Access Control & Compliance
' ========================================
rectangle "Access Control & Compliance (AML / KYC)" {

    usecase "Manage Investor\nWhitelist (KYC gate)" as UC_Whitelist <<acl>>
    usecase "Freeze / Thaw\nInvestor Accounts" as UC_FreezeThaw <<acl>>
    usecase "Monitor Transactions\n(AML compliance)" as UC_Monitor <<compliance>>
    usecase "Verify KYC/AML\nEligibility" as UC_KYC <<compliance>>
}

' ========================================
' Liquidity Pool
' ========================================
rectangle "Liquidity Pool" {

    usecase "Manage Pool\nInventory & Config" as UC_Pool <<liquidity>>
    usecase "Rebalance Pool\nvs Vault" as UC_Rebalance <<liquidity>>
    usecase "Swap USDC ↔ vTokens\n(instant liquidity)" as UC_Swap <<liquidity>>
}

' ========================================
' Tokenizer
' ========================================
rectangle "Tokenizer (Asset Issuer)" {
    usecase "Deposit aTokens\n(underlying assets)" as UC_DepositATokens <<tokenizer>>
    usecase "Burn Freed aTokens\n& Deposit USDC" as UC_BurnATokens <<tokenizer>>
    usecase "Acquire Underlying\nAssets (off-chain)" as UC_AcquireAssets <<tokenizer>>
}



' ========================================
' Connections
' ========================================

' --- Admin (green) ---
admin -[COLOR_ADMIN]-> UC_Deploy
admin -[COLOR_ADMIN]-> UC_Config
admin -[COLOR_ADMIN]-> UC_Whitelist
admin -[COLOR_ADMIN]-> UC_FreezeThaw

' --- Curator (blue) ---
curator -[COLOR_CURATOR]-> UC_Settle
curator -[COLOR_CURATOR]-> UC_Redeem
curator -[COLOR_CURATOR]-> UC_NAV

' --- Investor (purple) ---
investor -[COLOR_INVESTOR]-> UC_Invest
investor -[COLOR_INVESTOR]-> UC_RedeemInvestor
investor -[COLOR_INVESTOR]-> UC_Swap
investor -[COLOR_INVESTOR]-> UC_AccrueFees

' --- Liquidity Manager (orange) ---
manager -[COLOR_MANAGER]-> UC_Pool
manager -[COLOR_MANAGER]-> UC_Rebalance

' --- Tokenizer (red) ---
tokenizer -[COLOR_TOKENIZER]-> UC_DepositATokens
tokenizer -[COLOR_TOKENIZER]-> UC_BurnATokens
tokenizer -[COLOR_TOKENIZER]-> UC_AcquireAssets

' --- Compliance Officer (teal) ---
compliance -[COLOR_COMPLIANCE]-> UC_KYC
compliance -[COLOR_COMPLIANCE]-> UC_Monitor
compliance -[COLOR_COMPLIANCE]-> UC_Whitelist

' ========================================
' Key Dependencies
' ========================================

UC_Settle ..> UC_NAV : <<uses>>\nnet NAV for pricing
UC_Rebalance ..> UC_Settle : <<triggers>>\nasync settlement
UC_KYC ..> UC_Whitelist : <<include>>\non pass
UC_BurnATokens ..> UC_RedeemInvestor : <<supports>>\naToken recycling

' ========================================
' Legend
' ========================================

legend right
    |<#C8E6C9>  | **Admin (Deployer)** |
    |<#BBDEFB>  | **Curator** |
    |<#E1BEE7>  | **Investor / Allocator** |
    |<#FFE0B2>  | **Liquidity Manager** |
    |<#FFCDD2>  | **Tokenizer (Issuer)** |
    |<#B2DFDB>  | **Compliance Officer** |
end legend

@enduml
