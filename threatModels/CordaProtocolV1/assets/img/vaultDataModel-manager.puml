@startuml vaultDataModelManager
' REVIEWED_MAIN_2026_05_13: aligned to current merged code; large-investment retained pending simplification merge.
' LEGACY_NOTE_2026_05_13: this diagram may include historical ACL/receipt/tokenizer details pending upstream simplification merge; validate against current code before implementation decisions.

left to right direction
scale max 3200 width
skinparam wrapWidth 220
allowmixing

!define INSTRUCTION class
!define EVENT class
!define ACCOUNT class
!define PROGRAM class
!define ACTOR class
!define PDA class

hide circles
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor<<Account>> LightBlue
    BackgroundColor<<AssociatedTokenAccount>> LightCyan
    BackgroundColor<<Instruction>> LightYellow
    BackgroundColor<<Event>> LightGreen
    BackgroundColor<<PDA>> LightCoral
    BackgroundColor<<Program>> LightSalmon
    BackgroundColor<<wallet>> LightGray
    BorderColor Black
}

skinparam package {
    BackgroundColor #f9f9f9
    BorderColor #666666
}

' ========================================
' Actor & Wallet
' ========================================

actor "Manager" as ActorManager

ActorManager -[hidden]right-> ManagerWallet

ActorManager --> ManagerWallet : owns

ACTOR ManagerWallet <<wallet>> {
    + pubkey: Pubkey
    + privateKey: privateKey
    --
    **Owner:** System Program
    **Note:**
    Manages liquidity pool deposits,
    withdrawals, and rebalancing.
}

' ========================================
' Price / Incident Controls
' ========================================

ManagerWallet -[hidden]right-> "Price / Incident Controls"

package "Price / Incident Controls" <<Rectangle>> {
    INSTRUCTION FetchPrice <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/oracle_wrapper/src/instructions/get_price.rs]] {
        --
        Reads the configured feed via
        Oracle Wrapper.
        Rejects stale or mismatched
        feed accounts.
    }

    INSTRUCTION EngageEmergencyStop <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/config/emergency_stop.rs]] {
        --
        Freezes vault activity via the
        emergency-stop flag.
        **Authorization:** Admin or Compliance Authority
    }

    INSTRUCTION LiftEmergencyStop <<Instruction>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/instructions/config/lift_emergency_stop.rs]] {
        --
        Clears the emergency-stop flag
        after investigation.
        **Authorization:** Admin only
    }

    ' Layout hints: stack controls horizontally
    FetchPrice -[hidden]right-> EngageEmergencyStop
    EngageEmergencyStop -[hidden]right-> LiftEmergencyStop
}

' Force instructions LEFT of Solana state
"Price / Incident Controls" -[hidden]down-> "Solana On-Chain Accounts"

' ========================================
' Solana On-Chain Accounts
' ========================================

package "Solana On-Chain Accounts" {

    package "Deployed Programs" {

        PROGRAM VaultProgram <<Program>> [[https://github.com/corda/corda-protocol-mvp/tree/main/programs/vault]] {
            + ID: EMDZftqHQgUkj2WB5zGDsGdShWu2GKG8qkhq8AwwSGxa
            --
            **Core Functions:**
            - Investment proposals
            - Redemption proposals
            - Settlement with whitelist checks
            - Oracle-wrapper-backed pricing and settlement fees
            - Whitelist management
            - Pause/resume and emergency stop
        }

        PROGRAM OracleWrapperProgram <<Program>> [[https://github.com/corda/corda-protocol-mvp/tree/main/programs/oracle_wrapper]] {
            + ID: HExrWEj2rBHut6KJjsRSmP1WxWA1BtVRmSf3FmPcJcob
            --
            **Purpose:**
            Wraps the configured price feed.
            Exposes `fetch_price` with feed,
            decimals, and staleness checks.
        }

        PROGRAM VaultAclGate <<Program>> [[https://github.com/corda/corda-protocol-mvp/tree/main/programs/vault-acl-gate]] {
            + ID: CPACLKiGDA9wD5LqoTuoxKiFdtToDAB6WpEEjUVZtb8v
            --
            **Purpose:**
            Token ACL callback handler.
            Validates whitelist during
            freeze/thaw operations.
            Checks FLAG_ACCOUNT ownership.
        }

        PROGRAM LiquidityProgramRemoved <<Program>> {
            + ID: CPLQjvNfmVigH2DzkEc17dk8qA8Vf3AEhWA1jiYA6Krd (legacy)
            --
            **Purpose:**
            Removed liquidity program.
            Kept as legacy reference only.
            Removed in commit a85d60c5.
        }

    }

    "Deployed Programs" -[hidden]right-> "Vault Program State"

    package "Vault Program State" {

    PDA Vault <<PDA>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/state/vault.rs]] {
        + vault_id: u64
        + pending_deposit_usdc: u64
        + pending_offboarded_usdc: u64
        + vtoken_to_redeem: u64
        + min_investment: u64
        + last_inbound_*: last-tx markers
        + last_outbound_*: last-tx markers
        + outstanding_inbound_*: monitoring
        + outstanding_outbound_*: monitoring
        + entry_fee_bps: u16
        + exit_fee_bps: u16
        + bump: u8
        + deposits_paused: u8
        + redemptions_paused: u8
        + emergency_stop: u8
        + authority: Pubkey
        + compliance_authority: Pubkey
        + usdc_mint: Pubkey
        + vtoken_mint: Pubkey
        + usdc_vault: Pubkey
        + vtoken_vault: Pubkey
        + fee_recipient: Pubkey
        + offboard_destination: Pubkey
        + oracle_wrapper_program: Pubkey
        + vtoken_oracle_wrapper_config: Pubkey
        + vtoken_price_feed: Pubkey
        --
        **Seed:** [b"vault", usdc_mint]
        **Owner:** VaultProgram
    }

    PDA VaultWhitelistEntry <<PDA>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/state/whitelist.rs]] {
        + mint: Pubkey
        + owner: Pubkey
        + whitelisted: bool
        + bump: u8
        --
        **Seed:** [b"vault_whitelist_entry", vtoken_mint, owner]
        **Owner:** VaultProgram
        **Note:** Controls vToken recipient access.
        Closed via exit() on removal.
    }

    PDA InvestmentProposal <<PDA>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/state/investment_proposal.rs]] {
        + bump: u8
        + vault: Pubkey
        + investor: Pubkey
        + usdc_amount: u64
        + created_at: i64
        + updated_at: i64
        + status: ProposalStatus
        + proposal_id: u64
        + netted_usdc: u64
        + _reserved: Vec<u8>
        --
        **Seed:** [b"investment_proposal", vault, investor, proposal_id]
        **Status:** Pending → Accepted/Rejected → Settled/Cancelled/Expired
        **Owner:** VaultProgram
        **Note:** Requires curator approval
    }

    PDA RedemptionProposal <<PDA>> [[https://github.com/corda/corda-protocol-mvp/blob/main/programs/vault/src/state/redemption_proposal.rs]] {
        + bump: u8
        + vault: Pubkey
        + investor: Pubkey
        + vtoken_amount: u64
        + expected_usdc_amount: u64
        + created_at: i64
        + updated_at: i64
        + status: ProposalStatus
        + proposal_id: u64
        + matched_vtokens: u64
        + _reserved: Vec<u8>
        --
        **Seed:** [b"redemption_proposal", vault, investor, proposal_id]
        **Status:** Pending → Cancelled/Settled
        **Owner:** VaultProgram
        **Note:** vTokens escrowed at creation; settled or cancelled later
    }

    ' DEPRECATED: auto-invest order removed in vault-modularization
    ' PDA AutoInvestOrder <<PDA>> {
    '     + bump: u8
    '     + vault: Pubkey
    '     + order_id: u64
    '     + total_usdc_amount: u64
    '     + created_at: i64
    '     + updated_at: i64
    '     + status: OrderStatus
    '     + receipts: Vec<Pubkey> (max 64)
    '     --
    '     **Seed:** [b"auto_order", vault, order_id]
    '     **Status:** Sent → Settled / Cancelled
    '     **Owner:** VaultProgram
    '     **Note:** Batches multiple receipts
    ' }
    }

    "Vault Program State" -[hidden]right-> "ACL Gate State"
    package "ACL Gate State" {
    PDA MintConfig <<PDA>> {
        --
        **Seed:** [b"MINT_CONFIG", vtoken_mint]
        **Owner:** Token ACL Program
    }

    PDA FlagAccount <<PDA>> {
        --
        **Seed:** [FLAG_ACCOUNT_SEED, token_account]
        **Owner:** Token ACL Program
        **Note:** data[0] == 1 when flag set
    }

    PDA ThawExtraMetas <<PDA>> {
        --
        **Seed:** [THAW_EXTRA_ACCOUNT_METAS_SEED, mint]
        **Owner:** ACL Gate Program
    }

    PDA FreezeExtraMetas <<PDA>> {
        --
        **Seed:** [FREEZE_EXTRA_ACCOUNT_METAS_SEED, mint]
        **Owner:** ACL Gate Program
    }
    }

    "ACL Gate State" -[hidden]right-> "Liquidity Pool State (Removed)"
    package "Liquidity Pool State (Removed)" {
    PDA LiquidityPoolRemoved <<PDA>> {
        --
        **Status:** Removed in commit a85d60c5
        **Legacy Seed:** [b"pool", ...]
        **Legacy Owner:** LiquidityProgram
    }

    }

    "Liquidity Pool State (Removed)" -[hidden]right-> "Token-2022 Mints & Accounts"
    package "Token-2022 Mints & Accounts" {

    ACCOUNT VTokenMint <<Account>> [[https://spl.solana.com/token-2022]] {
        + mint_authority: Vault PDA
        + freeze_authority: Vault PDA
        --
        **Extensions:**
        - Transfer Hook (ACL Gate)
        - DefaultAccountState (Frozen)
        - Metadata Extension
        **Note:** Token-2022 with ACL
    }

    ACCOUNT ATokenMint <<Account>> {
        --
        **Purpose:**
        External fund or reference asset.
        Not modeled as a vault-owned token account
        in the current proposal-based flow.
    }

    ACCOUNT USDCMint <<Account>> {
        --
        **Purpose:**
        Stablecoin used for investments
        and redemptions.
    }

    VTokenMint -[hidden]down-> ATokenMint
    ATokenMint -[hidden]down-> USDCMint

    ACCOUNT InvestorVTokenAccount <<AssociatedTokenAccount>> {
        + owner: InvestorWallet
        + mint: VTokenMint
        --
        **Note:**
        Subject to ACL freeze/thaw
        based on whitelist status.
        Default frozen.
    }

    ACCOUNT InvestorUSDCAccount <<AssociatedTokenAccount>> {
        + owner: InvestorWallet
        + mint: USDCMint
        --
        **Purpose:**
        Source for investments,
        destination for redemptions.
    }

    InvestorVTokenAccount -[hidden]down-> InvestorUSDCAccount
    InvestorUSDCAccount -[hidden]down-> VaultUSDCAccount

    ACCOUNT VaultUSDCAccount <<AssociatedTokenAccount>> {
        + owner: Vault PDA
        + mint: USDCMint
        --
        **Purpose:**
        Holds vault USDC deposits.
        MemoTransfer extension.
    }

    ACCOUNT VaultATokenAccount <<AssociatedTokenAccount>> {
        + owner: Vault PDA
        + mint: ATokenMint
        --
        **Purpose:**
        Holds underlying aTokens.
        MemoTransfer extension.
    }
    }

}

' ========================================
' Relationships: Instructions → State (Manager / NAV / Fee)
' ========================================

FetchPrice --> OracleWrapperProgram : R (feed)
EngageEmergencyStop --> Vault : W (emergency_stop = 1)
LiftEmergencyStop --> Vault : W (emergency_stop = 0)

' ========================================
' Relationships: Programs → State (ownership)
' ========================================

VaultAclGate --> VaultWhitelistEntry : validates during\nfreeze/thaw
LiquidityProgramRemoved --> LiquidityPoolRemoved : archived reference

' ========================================
' Relationships: State → Token Accounts
' ========================================

Vault --> VTokenMint : mint_authority
InvestorVTokenAccount --> VTokenMint : mint
InvestorUSDCAccount --> USDCMint : mint

@enduml
