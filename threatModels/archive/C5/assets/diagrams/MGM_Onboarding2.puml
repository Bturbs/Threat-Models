@startuml
title CorDapp Lifecycle
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

actor "Application Publisher/\nLibrary Developer" as APP_PUB order 10 #LightGray 
actor "System/Infra\n Operator" as INFRA_OP order 20 #LightGreen 
actor "Network\n Operator" as NET_OP order 30 #LightGreen 
actor "CorDapp\n User" as CORDAPP_USER order 35 #LightGray
actor "VNode\n Operator" as VNODE_OP order 40 #LightPink 
actor "Cluster\n Operator" as CLUSTER_OP order 50 #LightPink 

participant "\nMGM\n Cluster\n" as MGM order 70 #LightGreen 
participant "\nMember\n Cluster\n" as MEMBER order 70 #LightCoral 
participant "\nNotary\n Cluster\n" as NOTARY order 80 #LightGreen
participant "\nPeer\n Cluster\n" as PEER order 90 #red
skinparam sequenceMessageAlign center


hide footbox
hide unlinked

group Setup Cluster-TLS
NET_OP ->  MGM: PUT certificate.pem $API_URL/certifucates/cluster/p2p-tls
activate MGM 
MGM --> NET_OP: return
deactivate MGM
end
==  MGM Onboarding ==

group MGM Onboarding
NET_OP -> NET_OP: Create an MGM GroupPolicy.json
NET_OP -> NET_OP: Package MGM GroupPolicy.json file\n into an MGM CPI
|||
|||
NET_OP ->  MGM: Upload the CPI to your cluster
activate MGM 
MGM --> NET_OP: return CPI ID
deactivate MGM

|||
NET_OP ->  MGM: CPI get status API
activate MGM 
MGM --> NET_OP: cpiFileChecksum
deactivate MGM
|||
NET_OP ->  MGM: Create a virtual node in your cluster for the MGM(cpiFileChecksum, x500Name)
activate MGM 
MGM --> NET_OP: return: holding identity ID
deactivate MGM
|||
NET_OP ->  MGM: Assign required HSMs for the MGM 
activate MGM 
MGM --> NET_OP: SESSION KEY ID
deactivate MGM
|||
NET_OP ->  MGM: Create required keys, and optionally import required certificates
activate MGM 
MGM --> NET_OP: ECDH KEY ID
deactivate MGM
|||
NET_OP ->  MGM: Use the register endpoint to finalise the MGM setup so that it is ready to accept members
activate MGM 
MGM --> NET_OP:  
deactivate MGM
|||
NET_OP ->  NET_OP: Build registration context
|||
NET_OP ->  MGM: Register MGM membership/$MGM_HOLDING_ID(action=requestJoin, REGISTRATION_CONTEXT)
activate MGM 
MGM --> NET_OP: return SUBMITTED
deactivate MGM 
|||
NET_OP ->  MGM: Configure P2P TLS cert(SESSION KEY ID)
activate MGM 
MGM --> NET_OP: return
deactivate MGM 
|||
NET_OP ->  MGM: export group policy for group 
activate MGM 
MGM --> NET_OP: return GroupPolicy.json
deactivate MGM 
end
@enduml