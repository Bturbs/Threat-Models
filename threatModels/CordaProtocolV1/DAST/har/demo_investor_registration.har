tion\",\"placeholder\":\"Select the jurisdiction of incorporation\"},\"ARE\":{\"label\":\"Emirate of incorporation\",\"placeholder\":\"Select the emirate of incorporation\"}},\"searchErrorHint\":\"This field cannot be empty\",\"searchButtonLabel\":\"Find company\",\"searchAnotherCompanyButtonLabel\":\"Search another company\",\"searchResultsTitle\":\"Select your company\",\"searchResultsErrorTitle\":\"Error\",\"searchResultsSubtitle\":\"Search results for \\\\\"{name}\\\\\"\",\"searchResultsFooter\":\"Didn't find your company? {button}\",\"searchResultsFooterButton\":\"Enter company data manually\",\"searchResultsNoResults\":\"No results found\",\"searchResultsNoResultsButtonLabel\":\"Enter company data manually\",\"searchResultsNoResultsHint\":\"We couldn't find companies related to your search. Try another search or enter company data manually.\",\"searchResultsNext\":\"Select company\",\"enterManually\":{\"title\":\"Company information\",\"subtitle\":\"Please provide more details about your company\",\"notice\":\"Couldn't fetch the company data from the corporate registry. Please provide the required information manually.\",\"next\":\"Save and continue\"},\"alternativeNamesAddButtonLabel\":\"Add another\"},\"docapture\":{\"errorScreenFileUpload\":\"Upload document\",\"errorTitle\":\"Camera error\",\"errorSubtitle\":\"Try again or use a different device\"},\"seamlessDocapture\":{\"footerText\":\"Document must be in the frame and clearly visible\",\"footerSelfieTitle\":\"Selfie\",\"footerSelfieText\":\"Your face should be in the frame and clearly visible\",\"nextSideHint\":\"Turn the document over\",\"tiltHint\":\"Slowly tilt it back and forth to highlight the holograms\",\"selfieHint\":\"Now make a selfie\",\"switchModeHint\":\"Auto-capture is taking longer than usual. You can take the photo manually.\",\"switchModeAfterCaptureFailedHint\":\"Auto-capture didn’t work. Tap the round button to take a photo manually\",\"scanningHint\":\"Scanning... hold still\",\"capturedDoc\":\"Document captured!\",\"capturedFront\":\"Front side captured!\",\"capturedBack\":\"Back side captured!\",\"capturedSelfie\":\"Selfie captured!\",\"hintAriaLabel\":\"Capture hint\",\"captureFrame\":\"Capture frame\",\"videoRecord\":{\"alert\":\"A video will be recorded while going through this step. Please hold your ID in your hand and slowly tilt it forward and sideways when prompted\",\"uploadTitle\":\"Uploading recorded video...\",\"uploadSubtitle\":\"Do not close this page until the upload is complete\",\"retryButtonLabel\":\"Try again\",\"errors\":{\"upload\":{\"title\":\"Video upload error\",\"subtitle\":\"An error occurred while loading the video, please try again or use a different device\"},\"too_long\":{\"title\":\"Video is too long\",\"subtitle\":\"The uploaded video exceeds the required maximum video length. Please try recording a shorter video.\"},\"too_low\":{\"title\":\"Video quality too low\",\"subtitle\":\"The video quality does not meet the verification requirements. Please try using a device with a higher quality camera.\"},\"unknown\":{\"title\":\"Video recording failed\",\"subtitle\":\"Something went wrong while recording the video, please try again.\"}}},\"alignmentMessage\":{\"tooSmallDesktop\":\"Move your document closer to the camera. We’ll capture automatically when it’s clear.\",\"tooSmallMobile\":\"Move your camera closer. We’ll capture automatically when it’s clear.\",\"tooBigDesktop\":\"Move your document back slightly. We’ll capture automatically when it’s in focus.\",\"tooBigMobile\":\"Move your camera back slightly. We’ll capture automatically when it’s in focus.\"}},\"common\":{\"isDoubleSideDoc\":\"My document is double-sided\",\"popupBlockedToastTitle\":\"Can't open new window\",\"popupBlockedToastSubtitle\":\"Allow pop-ups in your browser and try again\"},\"applicantData\":{\"title\":\"Personal information\",\"subtitle\":\"Enter your details accurately to continue.\",\"continueButtonLabel\":\"Continue\"},\"questionnaire\":{\"continueButtonLabel\":\"Continue\",\"previewMockData\":{\"title\":\"Settlement Account Details\",\"desc\":\"Please answer a few questions\",\"sectionName\":\"Account Details\",\"sectionDesc\":\"This is all about account details. Use this space to explain to your user exactly what they needs to fill in.\",\"field1\":\"Enter your legal name\",\"field2\":\"ID number\",\"field3\":\"Date of birth\"},\"validationErrorTitle\":\"Some steps had errors\",\"validationErrorText\":\"Please correct them to complete verification\",\"uploadFileLabel\":\"Upload file\"},\"email\":{\"title\":\"Email verification\",\"caption\":\"Enter your email address to receive a verification code\",\"inputPlaceholder\":\"Enter your email address\",\"sendVerificationCodeButtonLabel\":\"Send verification code\",\"codeCaption\":\"Enter the verification code we sent to {email}\",\"resendCodeCaption\":\"Resend code in {time}\",\"resendCodeButtonLabel\":\"Resend a verification code\",\"differentEmailButtonLabel\":\"Try a different email address\",\"didntReceiveCode\":\"Didn't receive the code?\",\"lockedEmailFlow\":{\"title\":\"Check your email\",\"subtitle\":\"If this email is incorrect, please contact support\",\"caption\":\"We’ll send a verification code to this email\",\"codeTitle\":\"We’ve sent you a code\",\"codeCaption\":\"Please enter the code sent to {email}\"},\"reown\":{\"loginButtonLabel\":\"Connect wallet\",\"signMessage\":\"Please sign with your account\",\"success\":\"Your wallet has been successfully connected\",\"failed\":\"Failed to connect your wallet\"},\"errors\":{\"invalidCode\":\"The code you entered is incorrect. Please try again\",\"codeEntries\":{\"title\":\"Too many incorrect code entries\",\"subtitle\":\"Please verify your email or try a different one\"},\"emailEntries\":{\"title\":\"Too many email entry attempts\",\"subtitle\":\"Please try again in a minute\"},\"emptyEmail\":\"Please enter your email address\",\"invalidEmail\":\"The email address you entered is invalid.\\\\nPlease try again\"}},\"esign\":{\"title\":\"Document signing\",\"subTitleStart\":\"Confirm the following to request your digital certificate and continue with document signing\",\"subTitleProvidedData\":\"Please review and, if necessary, edit the information extracted from the identity document in the required fields\",\"titleProvidedData\":\"Help us confirm your data\",\"subTitleDocs\":\"Tick the required box and continue with OTP authentication to finish signing. A unique code will be sent to you via SMS.\",\"otpTitle\":\"One-time password (OTP)\",\"otpCodeCaption\":\"Enter the OTP sent to\\\\n{otp} via SMS\",\"resendCodeCaption\":\"Resend password in {time}\",\"resendCodeButtonLabel\":\"Resend OTP\",\"invalidCode\":\"The OTP you entered is incorrect\",\"continueButtonLabel\":\"Continue\",\"finishSigningButtonLabel\":\"Finish signing\",\"pageToBeSigned\":\"Page to be signed: {page}\",\"pagesToBeSigned\":\"Pages to be signed: {pages}\"},\"phone\":{\"title\":\"Phone verification\",\"caption\":\"Enter your phone number to receive a verification code\",\"sendVerificationCodeButtonLabel\":\"Send verification code\",\"codeCaption\":\"Enter the verification code we sent to {phone}\",\"sandboxCodeAlert\":\"Sandbox mode: Enter 111111\",\"resendCodeCaption\":\"Resend code in {time}\",\"resendCodeButtonLabel\":\"Resend a verification code\",\"differentPhoneButtonLabel\":\"Try a different phone number\",\"didntReceiveCode\":\"Didn't receive the code?\",\"codeInputAriaLabel\":\"Verification code digit {index}\",\"lockedNumberFlow\":{\"title\":\"Check your phone number\",\"subtitle\":\"If this number is incorrect, please contact support\",\"caption\":\"We’ll send a verification code to this number\",\"codeTitle\":\"We’ve sent you a code\",\"codeCaption\":\"Please enter the code sent to {phone}\"},\"errors\":{\"invalidCode\":\"The code you entered is incorrect. Please try again\",\"codeEntries\":{\"title\":\"Too many incorrect code entries\",\"subtitle\":\"Please verify your phone number or try a different one\"},\"phoneEntries\":{\"title\":\"Too many phone number entry attempts\",\"subtitle\":\"Please try again in a minute\"},\"invalidPhone\":\"Invalid phone number, try again\"}},\"ekyc\":{\"definitionTitle\":\"Select your verification country and method\",\"title\":\"Provide your data\",\"country\":\"Country\",\"appDataTitle\":\"Help us confirm your data\",\"appDataSubtitle\":\"Please fill in the required fields to complete the identification process\",\"noConfirm\":{\"instructions\":\"Enter your ID\",\"submitData\":\"Submit data\",\"sending\":\"Sending your data...\",\"confirmInstructions\":\"Confirm your details to continue verification.\",\"confirmActionIn\":\"\",\"confirmAction\":\"Confirm\"},\"otp\":{\"instructions\":\"Enter your ID to receive a verification code\",\"submitData\":\"Send verification code\",\"sending\":\"Sending your data. Wait...\",\"confirmInstructions\":\"Enter the verification code\",\"confirmActionIn\":\"Resend code in {timer}\",\"confirmAction\":\"Resend verification code\",\"statusRetry\":\"The code you entered is incorrect. Please try again\",\"statusRejected\":\"Please try again to receive a new code\"},\"oAuth\":{\"instructions\":\"Login to verify\",\"submitData\":\"Login\",\"sending\":\"Redirecting...\",\"confirmInstructions\":\"Login in redirected page\",\"confirmActionIn\":\"Redirecting in {seconds}\",\"confirmActionInstructions\":\"If you are not redirected automatically\\\\n{link}\",\"confirmAction\":\"Click here\",\"statusRetry\":\"The action was not successful. Please try again\"},\"eID\":{\"instructions\":\"Follow the instructions on the next screen to complete verification with your electronic ID.\",\"submitData\":\"Continue\",\"sending\":\"Submitting…\",\"confirmInstructions\":\"Complete the authentication using your electronic ID.\",\"confirmActionIn\":\"Redirecting in {seconds}\",\"confirmAction\":\"Continue\"},\"options\":{\"instructions\":\"Please fill in the required fields to complete the identification process\",\"submitData\":\"Login\",\"sending\":\"Redirecting...\",\"confirmInstructions\":\"Please fill in the required fields to complete the identification process\",\"confirmActionIn\":\"Redirecting in {seconds}\",\"confirmActionInstructions\":\"If you are not redirected automatically\",\"confirmAction\":\"Login\",\"statusRetry\":\"The action was not successful. Please try again\"},\"sources\":{\"intl_crd_pennydrop\":{\"title\":\"Select your banking platform\",\"instructions\":\"Please select a preferred banking platform to verify your information by making a quick nominal payment. Payment processing may take up to a day, depending on your bank. It will be refunded to you within 48 hours.\",\"confirmAction\":\"Proceed\"},\"eu_crd_ob\":{\"title\":\"Select your banking platform\",\"instructions\":\"Please select a preferred banking platform to verify your information through a standard login process.\",\"confirmAction\":\"Proceed\"},\"gbr_crd_bank\":{\"title\":\"Select your banking platform\",\"instructions\":\"Please select a preferred banking platform to verify your information through a standard login process.\",\"confirmAction\":\"Continue\"},\"fin_bankid_ftn\":{\"title\":\"Select your banking platform\",\"instructions\":\"Please select a preferred banking platform to verify your information through a standard login process.\",\"confirmAction\":\"Continue\"},\"dnk_bankid_mitid\":{\"title\":\"Log in to the platform\"},\"ind_gov_aadhaar_digi\":{\"title\":\"Log in to the platform\"},\"sgp_gov_singpass\":{\"title\":\"Verify your identity with Singpass\",\"instructions\":\"Carefully review the information and continue if it is stated accurately.\\\\nIf you wish to upload an identity document instead, please click ‘Cancel’ and we will redirect you automatically.\"}},\"status\":{\"retry\":\"Something went wrong. Please try again\",\"rejected\":\"We cannot verify you. Please check correctness of provided data and try again\"},\"skip\":\"Verify documents instead\",\"cancel\":\"Cancel\",\"continue\":\"Continue\"},\"welcome\":{\"title\":\"Let's get you verified\",\"reusableTitle\":\"Complete your verification\",\"fullyReusableTitle\":\"You're all set to continue\",\"titleCompany\":\"Let’s verify your company\",\"subtitle\":\"Follow the simple steps below\",\"reusableSubtitle\":\"We’ll reuse your previously submitted data to speed things up. You only need to complete the remaining step(s) below:\",\"fullyReusableSubtitle\":\"We’ll reuse your previously submitted data to speed things\\xA0up.\",\"subtitleKycAsPartOfKyb\":\"You’re being verified as part of {companyName}\",\"subtitleKybAsPartOfKyb\":\"This company is being verified as part of the process for {companyName}\",\"startVerificationButtonLabel\":\"Start verification\",\"startVerificationButtonLabelMobile\":\"Start verification on phone\",\"listAriaLabel\":\"Steps\",\"listAriaLabelReusable\":\"Reusable steps\",\"listAriaLabelNonReusable\":\"Non-reusable steps\",\"reusedSteps\":\"What we'll reuse\",\"remainingSteps\":\"Remaining steps\",\"stepIndex\":\"Step {index}\",\"stepStatuses\":{\"accepted\":\"Accepted\",\"readyToSubmit\":\"Ready to submit\",\"rejected\":\"Rejected\",\"reused\":\"Submitted\"},\"stepRequired\":\"Required\",\"continueOnThisDeviceButtonLabel\":\"Continue on this device\",\"connectWalletButtonLabel\":\"Connect wallet\",\"signViaExternalWalletButtonLabel\":\"Sign via external wallet\",\"satoshiTestButtonLabel\":\"Ownership verification transaction\",\"selfDeclaration\":\"Self-declaration\",\"continueButtonLabel\":\"Continue\"},\"agreement\":{\"modalAriaTitle\":\"Agreements\",\"modalTitle\":\"Consent to start verification\",\"modalAgreeButtonLabel\":\"Agree and continue\",\"title\":\"Data and Privacy\",\"residentTitle\":\"Confirm your country of residence\",\"text\":\"Before you continue, you must consent to the processing of your personal data, as described in the {link}\"},\"reusableKycAgreement\":{\"title\":\"Request to transfer your data\",\"subTitle\":\"You previously verified with **{partner}**. To speed up your verification with **{client}**, request **{partner}** to transfer your verification data.\",\"reusableDocs\":{\"title\":\"The following will be transferred:\",\"IDENTITY\":\"Identity documents\",\"PROOF_OF_RESIDENCE\":\"Proof of address documents\",\"EMAIL\":\"Email\",\"PHONE\":\"Phone number\",\"EMAIL_AND_PHONE\":\"Email and phone number\",\"APPLICANT_DATA\":\"Information you provided about yourself during verification with\\xA0{partner}\",\"SELFIE\":\"Selfie\"}},\"liveness\":{\"switchCameraButtonAriaLabel\":\"Switch camera\",\"title\":\"Get your camera ready\",\"continueButtonLabel\":\"Continue\",\"tipsSuccess\":[\"Find a well lit place\",\"Ensure your face is within the frame\"],\"tipsError\":[\"Don't wear hats, glasses and masks\"],\"guides\":{\"title\":\"How to pass the selfie check\",\"subtitle\":\"We are always ready to help! There are some solutions to pass the liveness check with ease.\",\"goodLightingTitle\":\"Good lighting\",\"goodLightingText\":\"Help us to recognize your data better, pass the check in a well lit room.\",\"facePositioningTitle\":\"Correct facial positioning\",\"facePositioningText\":\"Don't be too close or too far away from the camera. Position your face so that it is clearly visible and correctly fit inside the frame.\",\"unnaturalLookTitle\":\"Natural look\",\"unnaturalLookText1\":\"Pass the check without changing your appearance.\",\"unnaturalLookText2\":\"Don't wear masks, glasses, and hats when passing the liveness check.\"},\"guidelinesButtonLabel\":\"View our guidelines\",\"completedSplashTitle\":\"Liveness Check passed successfully\",\"tryAgainButtonLabel\":\"Try again\",\"errors\":{\"loading\":{\"title\":\"Loading error\",\"message\":\"We could not complete the check. Please try again or use a different device.\"},\"internet\":{\"title\":\"You're offline\",\"message\":\"Check your internet connection and try again\"},\"token\":{\"title\":\"Verification expired\",\"message\":\"Contact our support to start new verification.\"},\"notSupported\":{\"title\":\"Your browser is not supported\",\"message\":\"Try a different browser or device\"},\"tooLow\":{\"title\":\"Video quality too low\",\"message\":\"The video quality does not meet the verification requirements. Please try using a device with a higher quality camera.\"},\"cameraLost\":{\"title\":\"Camera error\",\"message\":\"Try again or use a different device\"},\"unknown\":{\"title\":\"Something went wrong\",\"message\":\"Try again or use a different device\"}},\"checkResults\":{\"ALLOW_CONTINUING\":\"Your data has been submitted.\",\"FAILURE\":\"We need to scan your face one more time to complete the check.\"},\"alignmentMessage\":{\"rotate\":\"Move your head slowly to complete the circle\",\"lookStraight\":\"Look straight into the camera. Scanning...\",\"loading\":\"Connecting your camera...\",\"notAligned\":\"Fit your face into the frame\",\"wasAligned\":\"Return your face to the frame\",\"rotated\":\"Look straight into the camera\",\"tooSmall\":\"Face too far. Please, move closer to the camera.\",\"tooBig\":\"Face too close. Please, move away from the camera.\",\"wait\":\"Hold still\",\"analyzingData\":\"Almost there. Checking...\",\"success\":\"You're all set\",\"alignmentDirectionHelpMessage\":{\"right\":\"Move your head to the right\",\"left\":\"Move your head to the left\",\"up\":\"Move your head up\",\"down\":\"Move your head down\"}}},\"shortVideo\":{\"title\":\"Let's make a short video\",\"stepName\":\"Short video\",\"guidelinesButtonLabel\":\"View our guidelines\",\"continueButtonLabel\":\"Continue\",\"tips\":{\"title\":\"Make sure\",\"success\":[\"You’re in a well lit room\",\"There are no other people in the room\",\"Your device’s camera is uncovered and working\",\"Your device’s microphone is working\"],\"error\":[\"You’re not using any mask or software to change your face\"]},\"guides\":{\"title\":\"How to pass the short video check\",\"subtitle\":\"We are always ready to help! Here are some tips to pass the short video check with ease.\",\"environmentTitle\":\"Prepare Your Environment\",\"environmentTips\":[\"Check your microphone and camera before you start recording the video\",\"Find a quiet, well-lit room with minimal background noise\",\"Ensure the camera is positioned properly, capturing your face clearly\"],\"instructionsTitle\":\"Follow Instructions Carefully\",\"instructionsTips\":[\"Speak clearly and confidently, ensuring each word is audible\"],\"speakingTitle\":\"Speak Naturally\",\"speakingTips\":[\"Avoid rushing through the phrase, speak at a moderate pace\",\"Enunciate each word clearly, but don't overemphasize pronunciation\"],\"checkTitle\":\"Double-Check Before Submitting\",\"checkTips\":[\"Review your recording to ensure it meets the requirements\",\"Verify that the phrase/numbers are pronounced accurately and clearly\"]},\"capture\":{\"subtitleDigits\":\"Say digits out loud and press stop when you’re done.\",\"subtitleWords\":\"Say the phrase out loud and press stop when you’re done.\",\"footerText\":\"Keep your full face in the camera view and speak cleary\",\"shutterButtonAriaLabel\":\"Toggle record\"},\"fastfail\":{\"title\":\"Let’s record a video again\",\"loading\":\"Uploading... Keep this tab open until upload is complete\"},\"errors\":{\"too_short\":{\"title\":\"Video is too short\",\"subtitle\":\"The uploaded video does not meet the required minimum video length. Please try recording a longer video.\"},\"too_long\":{\"title\":\"Video is too long\",\"subtitle\":\"The uploaded video exceeds the required maximum video length. Please try recording a shorter video.\"}}},\"webCameraPhoto\":{\"title\":\"Let’s make a selfie\",\"tips\":{\"title\":\"Tips\",\"success\":[\"You're in a well lit room\",\"There are no other people in the room\",\"Ensure your face is within the frame\"],\"error\":[\"You're not using any mask or software to change your face\"]},\"guidelinesButtonLabel\":\"View our guidelines\",\"continueButtonLabel\":\"Continue\",\"fastFail\":{\"alertImage\":\"Image issue\",\"title\":\"Review your photo\",\"text\":\"Make sure your face is fully and clearly visible in the photo.\"},\"camera\":{\"footerText\":\"Your face should be in the frame and clearly visible\"},\"manualCaptureError\":\"Unable to take a photo. Please try again\"},\"videoIdent\":{\"continueButtonLabel\":\"Continue\",\"instructions\":{\"title\":\"Video identification\",\"subTitle\":\"You will have a video call with operator. It won’t take long\"},\"languageSelector\":{\"title\":\"Select the language you speak\"},\"readyForCall\":{\"title\":\"Checking the camera\",\"subTitle\":\"Make sure you’re clearly visible, in a well-lit area, and alone in it\",\"languageTitle\":\"The language you speak\",\"changeButton\":\"Change\",\"startCallButtonLabel\":\"Start Call\"},\"waiting\":{\"title\":\"Waiting for operator...\",\"subTitle\":\"Please wait while we connect you with one of our identification experts. Simply follow their instructions.\"},\"upload\":{\"title\":\"Document upload\",\"subTitle\":\"Select identity document for upload\",\"buttonTitle\":\"Upload {document}\",\"completedTitle\":\"Done\"},\"enterPhone\":{\"title\":\"Phone verification\",\"caption\":\"Enter your phone number to receive a verification code\",\"continueButtonLabel\":\"Continue\",\"errors\":{\"invalidPhone\":\"Invalid phone number, try again\"}},\"phoneVerification\":{\"title\":\"TAN verification\",\"completedTitle\":\"TAN verification passed successfully\",\"invalidCode\":\"The code you entered is incorrect\"},\"endCallPrompt\":{\"title\":\"End call\",\"text\":\"You’re about to exit the verification process. Are you sure you want to exit?\",\"confirmButtonLabel\":\"Confirm\"},\"errors\":{\"unknown\":{\"title\":\"Something went wrong\",\"message\":\"Try again or use a different device\",\"tryAgainButtonLabel\":\"Try again\"}}},\"satoshiTest\":{\"title\":\"Confirm your wallet ownership\",\"subtitle\":\"To verify your wallet, send the amount shown below to the address within 30 minutes\",\"note\":{\"title\":\"Note: Send the microtransaction from the unhosted wallet you want to verify.\",\"caption\":\"Do not use exchanges or custodial wallets. Your wallet will not be verified, and the refund may not reach you, as it will be sent back to the sending address, which may be a shared exchange wallet.\"},\"transferDetails\":\"Transfer details\",\"amount\":\"Amount\",\"walletAddress\":\"Wallet address\",\"qrHint\":\"Scan with your wallet app to send the transaction\",\"submitButtonLabel\":\"Continue\",\"copied\":\"Copied to clipboard\",\"copyFailed\":\"Failed to copy. Please try again.\",\"pending\":{\"title\":\"Verifying transaction\",\"subtitle\":\"Please wait while we verify your transaction. This may take a few minutes.\"},\"errors\":{\"submitFailed\":\"Failed to submit. Please try again.\"},\"disclaimer\":{\"paragraph1\":\"Because you are sending or receiving virtual assets to or from an unhosted wallet, the originating or beneficiary virtual asset service provider is required to verify that you control the relevant unhosted wallet.\",\"paragraph2\":\"On this page, you will complete this verification by sending a pre-defined amount of virtual assets from the unhosted wallet that should be verified to a designated wallet address (sometimes referred to as a \\\\\"Satoshi test\\\\\"). The pre-defined amount of virtual assets used for this verification, less the applicable network fees incurred in connection with the return transfer, will be sent back to your unhosted wallet once the verification has been successfully completed. All network fees are borne by you and are not refunded. No custodial, transfer, or any other services are provided to you as part of this verification.\",\"paragraph3\":\"Your personal data will be processed by Sumsub in accordance with its {privacyNotice}.\",\"paragraph4\":\"By sending the pre-defined amount of virtual assets to the designated wallet address, you acknowledge that you have read, understood, and agree to the above notice.\",\"privacyNoticeLinkLabel\":\"Privacy Notice\",\"privacyNoticeLinkUrl\":\"https://sumsub.com/privacy-notice-service/\"}},\"verificationCompleted\":{\"success\":\"Your profile has been verified\",\"trSdkSuccess\":\"Transaction created\",\"trSdkUpdateSuccess\":\"Transaction data updated\",\"fail\":\"Unfortunately, we couldn’t verify you\",\"paymentMethodFail\":\"Unfortunately, we couldn't verify your payment method\",\"unhostedWalletSuccess\":\"Your wallet has been verified\",\"trSdkFail\":\"Unfortunately, we couldn't create your transaction\",\"trSdkUpdateFail\":\"Unfortunately, we couldn't update your transaction\",\"attestationConsentSuccess\":\"Attestation created successfully\",\"attestationConsentFail\":\"Creation of attestation failed\",\"lineaDescriptionSuccess\":\"You can check it on the {lineaExplorerLinkLabel}\",\"lineaExplorerLinkLabel\":\"explorer\",\"lineaExplorerLinkUrl\":\"https://explorer.ver.ax/linea/attestations/my_attestations\",\"kycInKybCloseButtonText\":\"Go back to the KYB page to complete your company verification\",\"kycInKybCloseButtonLabel\":\"Go to KYB\",\"closePageMessage\":\"You may close this page\"},\"reSubmit\":{\"title\":\"Almost there! Let’s fix a few things\",\"subtitle\":\"Some details couldn’t be verified. Please review and resubmit the required information to complete your verification.\",\"errorStepsHeader\":\"Needs resubmission\",\"inProgressStepsHeader\":\"In progress\",\"successStepsHeader\":\"All good\",\"stepStatus\":\"Resubmit\",\"stepInProgressStatus\":\"Not completed\",\"stepSuccessStatus\":\"Submitted\",\"startButtonLabel\":\"Start resubmission\"},\"POA\":{\"docTypes\":{\"title\":\"Document types\",\"weAccept\":{\"title\":\"We accept\",\"validMonthsTemplate\":\"Not older than {n} month | Not older than {n} months\",\"validMonthsTemplateShort\":\"(last {n} month) | (last {n} months)\",\"firstPopularItemsLabel\":\"{title} {caption}\"},\