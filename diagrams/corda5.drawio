        <mxCell id="-aK4uaNn-9dfgUKRdK5e-14" value="threats" style="" parent="0" visible="0" />
        <mxCell id="-aK4uaNn-9dfgUKRdK5e-15" value="Code signing Certificate pollution 1:&lt;br&gt;-Tampering" style="ellipse;whiteSpace=wrap;html=1;labelBackgroundColor=none;strokeColor=#C73500;strokeWidth=7;fontSize=18;fontColor=#FF3333;fillColor=none;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;" parent="-aK4uaNn-9dfgUKRdK5e-14" vertex="1">
          <mxGeometry x="-447" y="2809" width="355" height="317" as="geometry" />
        </mxCell>
        <mxCell id="-aK4uaNn-9dfgUKRdK5e-16" value="No Key rotation:&lt;br&gt;- DoS&lt;br&gt;- Spoofing (code authenticity)&lt;br&gt;" style="ellipse;whiteSpace=wrap;html=1;labelBackgroundColor=none;strokeColor=#C73500;strokeWidth=7;fontSize=18;fontColor=#FF3333;fillColor=none;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;" parent="-aK4uaNn-9dfgUKRdK5e-14" vertex="1">
          <mxGeometry x="-281" y="3241" width="242" height="235" as="geometry" />
        </mxCell>
        <mxCell id="-aK4uaNn-9dfgUKRdK5e-17" value="Code signing Certificate Polkution 2:&lt;br&gt;No X500 (domain) name to CPI association" style="ellipse;whiteSpace=wrap;html=1;labelBackgroundColor=none;strokeColor=#C73500;strokeWidth=7;fontSize=18;fontColor=#FF3333;fillColor=none;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;" parent="-aK4uaNn-9dfgUKRdK5e-14" vertex="1">
          <mxGeometry x="143" y="3251" width="242" height="235" as="geometry" />
        </mxCell>
        <mxCell id="-aK4uaNn-9dfgUKRdK5e-18" value="Certificate integrity1:&lt;br&gt;&amp;nbsp;Spoofing (mis-authentication) of Cordapp Publisher&lt;br&gt;Missing certificate validation via CA,&lt;br&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;DF_CPK_TRUSTED_CRED may be compromised (out of certificate band transmission)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;labelBackgroundColor=none;strokeColor=#C73500;strokeWidth=7;fontSize=18;fontColor=#FF3333;fillColor=none;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;" parent="-aK4uaNn-9dfgUKRdK5e-14" vertex="1">
          <mxGeometry x="416" y="3247" width="504" height="235" as="geometry" />
        </mxCell>
        <mxCell id="-aK4uaNn-9dfgUKRdK5e-19" value="Code signing Certificate pollution 1.2:&lt;br&gt;App Publisher should verify the code CPK ... not the Cluster to prevent signature pollutions and over complicated schema.&lt;br&gt;Mistrust in App Publisher is not mitigated by design in any case.&lt;br&gt;Disperse ownership/resposbility/repudiation (who fixes failing trust verification?&lt;br&gt;LACK OF TRUST OF PROVIDER" style="ellipse;whiteSpace=wrap;html=1;labelBackgroundColor=none;strokeColor=#C73500;strokeWidth=7;fontSize=18;fontColor=#FF3333;fillColor=none;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;" parent="-aK4uaNn-9dfgUKRdK5e-14" vertex="1">
          <mxGeometry x="-722" y="3153" width="450" height="283" as="geometry" />
        </mxCell>
        <mxCell id="-aK4uaNn-9dfgUKRdK5e-20" value="&lt;font color=&quot;#cc6600&quot;&gt;Not in place&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;labelBackgroundColor=none;strokeColor=#BD7000;strokeWidth=7;fontSize=18;fontColor=#000000;fillColor=none;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;" parent="-aK4uaNn-9dfgUKRdK5e-14" vertex="1">
          <mxGeometry x="-83.25" y="2622" width="307" height="202" as="geometry" />
        </mxCell>
        <mxCell id="rxjeYrFLabJFYVcInfSI-1" value="UNTRSTED PROVIDER:&lt;br&gt;Disperse resposibility&lt;br&gt;Repudiation&lt;br&gt;...&lt;br&gt;FIX: only check CPI signature, trust the provider" style="ellipse;whiteSpace=wrap;html=1;labelBackgroundColor=none;strokeColor=#C73500;strokeWidth=7;fontSize=18;fontColor=#FF3333;fillColor=none;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;" parent="-aK4uaNn-9dfgUKRdK5e-14" vertex="1">
          <mxGeometry x="104" y="4040" width="484" height="165" as="geometry" />
        </mxCell>
