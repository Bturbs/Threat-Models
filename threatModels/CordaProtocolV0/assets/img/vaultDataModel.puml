@startuml

' !pragma layout smetana
' left to right direction
' top to bottom direction

' skinparam ranksep 40
' skinparam nodesep 10

!define INSTRUCTION class
!define EVENT class
!define ACCOUNT class
!define PROGRAM class
!define ACTOR class

hide circles
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor<<Account>> LightBlue
    BackgroundColor<<TokenAccount>> LightCyan
    BackgroundColor<<Instruction>> LightYellow
    BackgroundColor<<Event>> LightGreen
    BackgroundColor<<PDA>> LightCoral
    BackgroundColor<<Program>> LightSalmon
    BackgroundColor<<wallet>> LightGray
    BorderColor Black
}

skinparam package {
    ' BackgroundColor<<DeployerControlled>> LightYellow
    BorderColor<<DeployerControlled>> Red
    FontStyle<<DeployerControlled>> bold
}



ACTOR VaultWallet <<wallet>> {
    + pubkey: Pubkey
    + privateKey: privateKey
    --
    **Owner:** System Program
    **Note:** 
    Its public key is the `upgrade_authority`
    for the `VaultProgram`.
}

ACTOR AdminWallet <<wallet>> {
    + pubkey: Pubkey
    + privateKey: privateKey
    --
    **Owner:** System Program
    **Note:**
    Can withdraw excess tokens.
}

ACTOR UserWallet <<wallet>> {
    + pubkey: Pubkey
    + privateKey: privateKey
    --
    **Owner:** System Program
}



' package "Singed instructions" {

' Instructions - defined BY the program, not IN a namespace
INSTRUCTION Initialize  <<Instruction>> [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/initialize.rs#L28]] {
    + name : String
    + symbol: String
    + uri: String
    --
    Creates VaultState
    Creates ShareMint with metadata
    Initializes token accounts
    
}



INSTRUCTION Deposit <<Instruction>>  [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L180]]{
    + jupiter_swap_data : Vec<u8>
    + usdc_amount: u64
    --
    1. Transfer USDC: User → Vault
    2. Swap USDC → Investment via Jupiter
    3. Mint shares to user (1:1 ratio)
}

INSTRUCTION Redeem <<Instruction>> [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/redeem.rs#L182]] {
    + shares: u64
    + jupiter_swap_data: Vec<u8>
    --
    1. Burn user shares
    2. Swap Investment → USDC via Jupiter
    3. Transfer USDC: Vault → User
}

INSTRUCTION FreezeTokenAccount <<Instruction>> [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/freeze.rs#L7]] {
    --
    Freeze a token account
}

INSTRUCTION UnfreezeAccount <<Instruction>> [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/unfreeze_account.rs#L7]] {
    --
    Unfreeze a token account
}

INSTRUCTION AdminWithdraw <<Instruction>> [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/admin_withdraw.rs#L9]] {
    + amount: u64
    --
    Transfer tokens from vault to admin's account
}

Initialize -[hidden]down-> Deposit
Deposit -[hidden]down-> Redeem
Redeem -[hidden]down-> FreezeTokenAccount
FreezeTokenAccount -[hidden]down-> UnfreezeAccount
UnfreezeAccount -[hidden]down-> AdminWithdraw
' }


' ' Events
' EVENT DepositEvt <<Event>> {
'     + caller: Pubkey
'     + receiver: Pubkey
'     + assets: u64
'     + shares: u64
' }

' EVENT WithdrawEvt <<Event>> {
'     + caller: Pubkey
'     + receiver: Pubkey
'     + owner: Pubkey
'     + assets: u64
'     + shares: u64
' }

    
package SolanaOnChainAccounts {

    PROGRAM JupiterProgram <<Program>> [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/constants.rs#L9]] {
        + program_id: JUP6LkbZbjS1jKKwapdHNy74zcZ3tLUZoi5QNyVTaV4
        --
        **Role:** Decentralized exchange aggregator.
        Provides swap functionality via CPI.
    }

package UserControlled {
    ' These are accounts OWNED by users (outside deployer control)

    ACCOUNT UserUsdcTokenAccount <<TokenAccount>> [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/redeem.rs#L214]] {
        + mint: USDC_MINT
        + authority: UserWallet
        + amount: u64
        --
        **Owner:** Token Program
        **Role:** User's USDC wallet
        Source of deposits
        Receives redemption proceeds
    }

    ACCOUNT UserShareAccount <<TokenAccount>> [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/redeem.rs#L221]] {
        + mint: ShareMint
        + authority: UserWallet
        + amount: u64
        --
        **Owner:** Token-2022 Program
        **Role:** User's share token wallet. The shares held here
        represent a claim on the assets in the vault's treasury.
        Receives minted shares on deposit.
        Source of shares for redemption.
    }
}


package  DeployerControlled {
    
    PROGRAM VaultProgram <<Program>> [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/lib.rs#L11]] {
        + program_id: FgmdwmDfEJnphDzwxEGCcHjmDr3qRpxnmahaS45oAQHH
        + upgrade_authority: Pubkey
        --
        **Role:** Deployed executable account
        Contains compiled program bytecode (lib.rs)
        Owns all PDAs via derivation
        Defines all instructions
        **Security:** `upgrade_authority` pubkey can redeploy code.
    }
    
    package "Vault Controlled" <<VaultControlled>> {
        ' Core State
        ACCOUNT VaultState <<PDA>> [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/state/vault_state.rs#L3]] {
            + token_account_owner_pda_bump: u8
            + admin: Pubkey
            --
            **Owner:** VaultProgram
            **Role:** Stores vault configuration
            PDA owned by VaultProgram
            Controlled by deployer via program
        }

        ' PDAs
        ACCOUNT TokenAccountOwnerPDA <<PDA>> [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/initialize.rs#L33]] {
            --
            **Owner:** VaultProgram
            **Role:** Vault authority PDA
            Program-level signing via invoke_signed()
            Derived from VaultProgram
            --
            **Derivation:**
            seeds: ["token_account_owner_pda"]
            bump: stored in `VaultState`
            --
            **Note:** This is an "empty" account used only for
            signing. It serves two distinct authority roles:
            1. **Token Account Authority:** To spend from vault token accounts.
            2. **Mint Authority:** To mint new tokens from `ShareMint`.
        }

        ' Token Accounts owned by vault
        ACCOUNT VaultUsdcTokenAccount <<TokenAccount>> [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/initialize.rs#L68]] {
            + mint: USDC_MINT
            + authority: TokenAccountOwnerPDA
            + amount: u64
            --
            **Owner:** Token Program
            **Role:** Vault's USDC treasury
            Receives user deposits
            Source for redemptions
        }

        ACCOUNT VaultInvestmentTokenAccount <<TokenAccount>> [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/initialize.rs#L57]] {
            + mint: INVESTMENT_MINT
            + authority: TokenAccountOwnerPDA
            + amount: u64
            --
            **Owner:** Token Program
            **Role:** The vault's central treasury. It holds the
            pooled investment tokens that back all user shares.
            **Note:** Can only hold one type of token, defined
            by the `INVESTMENT_MINT` constant.
            1:1 backing for share tokens
        }

        ' Share mint controlled by vault (mint authority)
        ACCOUNT ShareMint <<PDA>> [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/redeem.rs#L224]] {
            + seeds: ["share_mint"]
            + decimals: 6
            + supply: u64
            + mint_authority: TokenAccountOwnerPDA
            + metadata: TokenMetadata
            --
            **Owner:** VaultProgram
            **Role:** The mint account for the vault's share tokens.
            Its `mint_authority` is the `TokenAccountOwnerPDA`.
            `supply` is managed by the Token-2022 program.
            Minted 1:1 with investment received.
            Burned on redemption.
        }
    }
}
    
VaultProgram ..> VaultState [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/initialize.rs#L26]] : derives & owns PDA
VaultProgram ..> TokenAccountOwnerPDA [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/initialize.rs#L33]] : derives & owns PDA
VaultProgram ..> ShareMint [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/initialize.rs#L37]] : derives & owns PDA
VaultProgram ..> JupiterProgram [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L88]] : CPI (swap)

Initialize ..> VaultState [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/initialize.rs#L173]] : creates
Initialize ..> ShareMint [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/initialize.rs#L105]] : creates

' Deposit ..> DepositEvt : emits
Deposit ..> VaultUsdcTokenAccount [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L46]] : deposits to
Deposit ..> VaultInvestmentTokenAccount [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L88]] : swaps to
Deposit ..> UserShareAccount [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L129]] : mints shares

' Redeem ..> WithdrawEvt : emits
Redeem ..> UserShareAccount [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/redeem.rs#L56]] : burns shares
Redeem ..> VaultInvestmentTokenAccount [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/redeem.rs#L87]] : swaps from
Redeem ..> UserUsdcTokenAccount [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/redeem.rs#L160]] : transfers to

VaultState "1" -- "1" TokenAccountOwnerPDA [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/initialize.rs#L174]] : stores bump
TokenAccountOwnerPDA "1" -- "1" VaultUsdcTokenAccount [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/initialize.rs#L70]] : authority
TokenAccountOwnerPDA "1" -- "1" VaultInvestmentTokenAccount [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/initialize.rs#L59]] : authority
TokenAccountOwnerPDA "1" -- "1" ShareMint [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/initialize.rs#L136]] : mint authority

VaultUsdcTokenAccount "1" -- "n" UserUsdcTokenAccount [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/redeem.rs#L160]] : transfers
VaultInvestmentTokenAccount "1" .. "1" ShareMint [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L125]] : 1:1 ratio
ShareMint "1" -- "n" UserShareAccount [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L129]] : mints to


VaultWallet ..> Initialize [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/initialize.rs#L27]] : signs
UserWallet ..> Deposit [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L210]] : signs
UserWallet ..> Redeem [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/redeem.rs#L245]] : signs
AdminWallet ..> AdminWithdraw [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/admin_withdraw.rs#L50]] : signs
AdminWallet ..> FreezeTokenAccount [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/freeze.rs#L30]] : signs
AdminWallet ..> UnfreezeAccount [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/unfreeze_account.rs#L30]] : signs

VaultWallet ..> VaultProgram : deploy/upgrades

AdminWithdraw ..> VaultInvestmentTokenAccount : transfers from
FreezeTokenAccount ..> UserShareAccount : freezes
UnfreezeAccount ..> UserShareAccount : unfreezes
' note right of Deposit
'   Flow:
'   1. User USDC → Vault USDC
'   2. Jupiter CPI: Vault USDC → Vault Investment
'   3. Mint shares (1:1 with investment received)
' end note

' note right of Redeem
'   Flow:
'   1. Burn user shares
'   2. Jupiter CPI: Vault Investment → Vault USDC
'   3. Vault USDC → User USDC
' end note


@enduml