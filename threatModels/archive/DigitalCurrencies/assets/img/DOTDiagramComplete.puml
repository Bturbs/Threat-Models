@startuml
strict digraph G {

	
        rankdir = LR;
        graph [
            newrank = false,
            nodesep = 1,
            ranksep = 20,
            overlap = false,
            splines = true,
        ]
	node [
		fixedsize = false,
		fontsize = 24,
		height = 1,
		shape = box,
		style = "filled,setlinewidth(2)",
		width = 2.2
	]
		edge [
		labelfontname = "Ubuntu",
		weight = 10,
		style = "filled,setlinewidth(2)"
	]

	subgraph cluster_RPC_Client {
           label = "VNode Operator Client"
           HTTP_AGENT [color="#b0844c"]
   	}

