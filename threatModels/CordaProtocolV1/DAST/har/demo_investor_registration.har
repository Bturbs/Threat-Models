tion.customSubtypes.ARG.Passport\",\n            \"ocrDocumentTypes\" : [ \"arg.passport.type1\" ]\n          } ]\n        },\n        \"RESIDENCE_PERMIT\" : {\n          \"supported\" : true,\n          \"doubleSided\" : true\n        },\n        \"DRIVERS\" : {\n          \"supported\" : true,\n          \"doubleSided\" : false,\n          \"documentReferences\" : [ {\n            \"titleKey\" : \"components.documentDefinition.customSubtypes.ARG.DriversLicense\",\n            \"ocrDocumentTypes\" : [ \"arg.drvlic.type2\", \"arg.drvlic.type1\" ]\n          } ]\n        }\n      },\n      \"GNB\" : {\n        \"ID_CARD\" : {\n          \"supported\" : true,\n          \"doubleSided\" : true\n        },\n        \"PASSPORT\" : {\n          \"supported\" : true,\n          \"doubleSided\" : false\n        },\n        \"RESIDENCE_PERMIT\" : {\n          \"supported\" : true,\n          \"doubleSided\" : true\n        },\n        \"DRIVERS\" : {\n          \"supported\" : true,\n          \"doubleSided\" : false\n        }\n      },\n      \"ARM\" : {\n        \"ID_CARD\" : {\n          \"supported\" : true,\n          \"doubleSided\" : true\n        },\n        \"PASSPORT\" : {\n          \"supported\" : true,\n          \"doubleSided\" : false\n        },\n        \"RESIDENCE_PERMIT\" : {\n          \"supported\" : true,\n          \"doubleSided\" : true\n        },\n        \"DRIVERS\" : {\n          \"supported\" : true,\n          \"doubleSided\" : true\n        }\n      },\n      \"UZB\" : {\n        \"ID_CARD\" : {\n          \"supported\" : true,\n          \"doubleSided\" : true\n        },\n        \"PASSPORT\" : {\n          \"supported\" : true,\n          \"doubleSided\" : false\n        },\n        \"RESIDENCE_PERMIT\" : {\n          \"supported\" : true,\n          \"doubleSided\" : false\n        },\n        \"DRIVERS\" : {\n          \"supported\" : true,\n          \"doubleSided\" : false\n        }\n      },\n      \"BTN\" : {\n        \"ID_CARD\" : {