@startuml
' autonumber

box "Consumer <<Trust Zone>>" #pink

  actor Consumer
  participant "Consumer D.D. App" as App
  participant "UAE Pass mobile App" as UAEPass

end box

box "LFIs <<Trust Zone>>" #LightYellow
  participant "Identity Management \n& Federation Service" as Idm
end box

box "UAE PASS <<Trust Zone>>" #LightGreen
  participant "UAE Pass Service" as UAEService
end box

Consumer -> App: Login
App -> UAEPass: Open UAE Pass page for login
UAEPass -> Idm: Redirect to UAE Pass Login

alt Identifier valid?
    Consumer -> UAEPass: User enters valid identifier
    UAEPass -> UAEPass: 2 digit code generated
    UAEPass -> UAEService: UAE Pass app notification
    Consumer -> UAEService: Confirm code on UAE Pass App

    alt Code valid?
        UAEService -> Idm: Login successful & Send Token
        Idm -> App: Generate JWT token with required claims
        App -> Consumer: Receive JWT token
        App -> Consumer: Login Success

    else Invalid code
        UAEService -> App: Fail Login
        App -> Consumer: Fail Login
    end

else Invalid identifier
    Consumer -> UAEPass: User enters invalid identifier
    UAEService -> UAEPass: Fail Login
    App -> Consumer: Fail Login

    Consumer -> App: Retry Login
    App -> UAEPass: Open UAE Pass page for login again
    Consumer -> UAEPass: Enter valid identifier
    UAEPass -> UAEPass: 2 digit code generated
    UAEPass -> UAEService: UAE Pass app notification
    Consumer -> UAEService: Confirm code with incorrect value

    UAEService -> App: Fail Login
    App -> Consumer: Fail Login
end

@enduml
