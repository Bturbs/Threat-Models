@startuml
title Deposit Sequence — Solana Token Vault

actor "User\n<<signer>>" as User

box "User Owned" #pink
participant "User USDC\n<<account>>" as UserUSDCAccount
participant "User Shares\n<<account>>" as UserShareAccount
end box

box "Vault Owned" #LightBlue
participant "Vault\n<<program>>" as VaultProgram
participant "Token Program\n<<program>>" as TokenProgram
participant "Vault USDC\n<<account>>" as VaultUSDCAccount
participant "Vault Investment\n<<account>>" as VaultInvestmentAccount
end box

box "Jupiter Owned" #LightYellow
participant "Jupiter\n<<aggregator>>" as JupiterAggregator
end box

=== DEPOSIT OPERATION: User deposits USDC for shares ==
User -> VaultProgram : <b>DF_INVOKE_DEPOSIT\n[[https://github.com/corda/solana-token-vault-program/blob/security_review/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L17 process_deposit]]

note over VaultProgram
  CHECK 1: Validate Mints
end note
VaultProgram -> VaultProgram : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L23 check usdc_mint == USDC_MINT]]
VaultProgram -> VaultProgram : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L29 check investment_mint == INVESTMENT_MINT]]
alt Invalid Mints
  VaultProgram --> User : ❌ InvalidInputMint / InvalidOutputMint
end

note over VaultProgram
  CHECK 2: Validate Jupiter Program
end note
VaultProgram -> VaultProgram : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L35 check jupiter_program == JUP_PROGRAM_ID]]
alt Invalid Program
  VaultProgram --> User : ❌ InvalidJupiterProgram
end

note over VaultProgram
  CHECK 3: Non-Zero Amount
end note
VaultProgram -> VaultProgram : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L41 check usdc_amount > 0]]
alt Zero Amount
  VaultProgram --> User : ❌ ZeroAmount
end

note over VaultProgram,VaultUSDCAccount
  STEP 1: Transfer USDC from User to Vault
end note
VaultProgram -> UserUSDCAccount : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L44 transfer_checked]]
UserUSDCAccount -> VaultUSDCAccount : Transfer 100 USDC
note right of UserUSDCAccount
  User Balance: -100 USDC
end note
note right of VaultUSDCAccount
  Vault Balance: +100 USDC
end note

VaultProgram -> VaultUSDCAccount : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L51 reload vault_usdc_token_account]]
VaultProgram -> VaultProgram : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L54 vault_usdc_before = 100]]
VaultProgram -> VaultProgram : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L57 vault_investment_before = 0]]

note over VaultProgram,JupiterAggregator
  STEP 2: Jupiter Swap (USDC → Investment Token)
end note
VaultProgram -> JupiterAggregator : <b>DF_INVOKE_JUPITER \n [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L88 invoke_signed]]
note over JupiterAggregator
  Execute swap on Jupiter DEX
  Route determined by user's jupiter_swap_data
  Slippage protection handled off-chain
end note
JupiterAggregator -> VaultUSDCAccount : <b>DF_JUPITER_RETURN \nDeduct 100 USDC
note right of VaultUSDCAccount
  Vault USDC: 100 → 0
end note
JupiterAggregator -> VaultInvestmentAccount : <b>DF_JUPITER_CREDIT \nCredit 95 Investment tokens
note right of VaultInvestmentAccount
  Vault Investment: 0 → 95\n(5 tokens lost to slippage/fees)
end note
JupiterAggregator --> VaultProgram : <b>DF_JUPITER_COMPLETE\n Swap complete

VaultProgram -> VaultUSDCAccount : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L98 reload vault_usdc_token_account]]
VaultProgram -> VaultInvestmentAccount : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L99 reload vault_investment_token_account]]
VaultProgram -> VaultProgram : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L102 read vault_usdc_after]]
VaultProgram -> VaultProgram : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L103 read vault_investment_after]]

note over VaultProgram
  CHECK 4: Verify USDC Was Spent
end note
VaultProgram -> VaultProgram : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L116 check vault_usdc_after < vault_usdc_before]]
alt USDC Not Spent
  VaultProgram --> User : ❌ UsdcNotSpent
end

note over VaultProgram
  CHECK 5: Verify Investment Received
end note
VaultProgram -> VaultProgram : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L120 check vault_investment_after > vault_investment_before]]
alt Investment Not Received
  VaultProgram --> User : ❌ InvestmentNotReceived
end

note over VaultProgram
  CHECK 6: Calculate Investment with Overflow Protection
end note
VaultProgram -> VaultProgram : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L125 checked_sub]]
VaultProgram -> VaultProgram : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L125 investment_received = 95]]
alt Math Overflow
  VaultProgram --> User : ❌ MathOverflow
end

note over VaultProgram,TokenProgram
  STEP 3: Mint Shares (1:1 Ratio) via SPL Token program
end note
VaultProgram -> TokenProgram : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/instructions/deposit.rs#L131 mint_to(ShareMint, UserShareAccount, amount: 95, PDA signs)]]
TokenProgram -> UserShareAccount : Credit 95 shares
note right of UserShareAccount
  User Shares: +95
end note
TokenProgram --> VaultProgram : Minted successfully

VaultProgram -> VaultProgram : [[https://github.com/corda/solana-token-vault-program/blob/development/protocol-programs/programs/pre-commit-vault/src/events.rs#L4 emit DepositEvt]]

VaultProgram --> User : <b>DF_DEPOSIT_EVENT_COMPLLETE \n ✅ SUCCESS: Deposited 100 USDC → 95 Shares

note over VaultProgram,User
  FINAL STATE
  User USDC: -100
  User Shares: +95
  Vault USDC: 0 (temporary)
  Vault Investment: +95
  ShareMint Total Supply: +95
end note

@enduml
