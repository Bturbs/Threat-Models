        </mxCell>
        <mxCell id="qHVov0-bhh_Yzi4WCpuj-53" value="new repo onboard process? code injection via new repo?" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#e1d5e7;strokeColor=#9673a6;position2=0.47;opacity=70;" vertex="1" parent="qHVov0-bhh_Yzi4WCpuj-38">
