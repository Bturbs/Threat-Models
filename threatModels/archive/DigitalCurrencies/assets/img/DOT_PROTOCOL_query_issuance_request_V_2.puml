@startuml
strict digraph G {

graph [
    newrank = false,
    nodesep = 1.5,
    ranksep = 2,
    overlap = false,
    splines = true,
]
rankdir="TD";
node[ fontsize=14];
fontsize=18;
labeljust="l";

edge[style=invis, fontsize=12];

{ rank=same;
