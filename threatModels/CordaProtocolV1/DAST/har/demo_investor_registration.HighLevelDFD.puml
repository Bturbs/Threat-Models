@startuml
hide footbox
actor "Browser" as BROWSER
box "First-Party Boundary" #D7F3E3
  participant "corda-rr.vercel.app" as S1
end box
note over S1 #E0E0E0
  <b>corda-rr.vercel.app hosts:</b> corda-rr.vercel.app
end note
box "Third-Party Boundary" #F5F5F5
  participant "Google Edge/CDN" as S2
  participant "sumsub.com" as S3
end box
note over S2 #E0E0E0
  <b>Google Edge/CDN hosts:</b> fonts.googleapis.com, fonts.gstatic.com
end note
note over S3 #E0E0E0
  <b>sumsub.com hosts:</b> api.sumsub.com, static.sumsub.com
end note
BROWSER -> S1: Call to corda-rr.vercel.app
BROWSER -> S2: Call to google edge/cdn
BROWSER -> S3: Call to sumsub.com
@enduml
