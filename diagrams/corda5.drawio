        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;sequence&#39;: { &#39;mirrorActors&#39;: true}}}%%\n%%{init: {&#39;theme&#39;: &#39;base&#39;, &#39;themeVariables&#39;: \n{&#39;labelBoxBkgColor&#39;: &#39;lightgrey&#39;,\n&#39;noteTextColor&#39;:&#39;#000&#39;\n &#39;labelBoxBorderColor&#39;: \n&#39;#000000&#39;, &#39;actorBorder&#39;: &#39;#000&#39;, &#39;actorBkg&#39;: &#39;#eef&#39;, \n&#39;activationBorderColor&#39;: &#39;#232F3E&#39;, &#39;activationBkgColor&#39;: &#39;#D86613&#39;,\n&#39;noteBkgColor&#39;: &#39;rgba(255, 153, 0, .)&#39;\n, &#39;noteBorderColor&#39;: &#39;#232F3E&#39;}}}%%\nsequenceDiagram\n    autonumber\n    Actor AppPublisher\n    Actor NetworkOperator\n    Actor ClusterOperator\n    Actor VNode operator\n    participant RPC_WORKER \n    participant FLOW_WORKER\n    participant FLOW_SANDBOX\n    participant DB_WORKER\n    AppPublisher -&gt;&gt;+ NetworkOperator: Send CPB()\n    NetworkOperator -&gt;&gt;+ ClusterOperator: Send CPI()\n    note over AppPublisher, ClusterOperator: out of band\n    ClusterOperator-)+DB_WORKER: Upload CPI()\n    alt VNode API flow call\n\n    VNode operator-&gt;&gt;+RPC_WORKER: Flow (classname, request data {...})\n    RPC_WORKER--)FLOW_WORKER: execureFlow()\n    FLOW_WORKER-&gt;&gt;+FLOW_SANDBOX: Create new SandBox()\n    note over FLOW_WORKER, FLOW_SANDBOX: injects services\n\n    FLOW_WORKER-&gt;&gt;+FLOW_SANDBOX: call(requestBody: RPCRequestData)\n    FLOW_SANDBOX-&gt;&gt;+FLOW_SANDBOX: @InitiatingFlow flow call(request data{...})\n    FLOW_SANDBOX-&gt;&gt;+FLOW_WORKER: call CordaInject service()\n    FLOW_WORKER-&gt;&gt;+FLOW_SANDBOX: ret\n    FLOW_SANDBOX--)FLOW_SANDBOX2: sendMessage(request data taint{...})\n    note over FLOW_SANDBOX2, FLOW_SANDBOX: receives another message (out of rder)\n\n    FLOW_WORKER-&gt;&gt;FLOW_SANDBOX: suspend()\n    FLOW_WORKER-&gt;&gt;DB_WORKER: persistFlow()\n    end\n    alt Flow receives message\n    FLOW_SANDBOX2--)FLOW_WORKER: sendMessage(request data taint{...})\n    note over FLOW_SANDBOX2,FLOW_WORKER:  simplified call (e2e session and other details are not in scope) \n    FLOW_WORKER--)DB_WORKER: Load Flow Code from DB()\n    FLOW_WORKER-&gt;&gt;+FLOW_SANDBOX: Create SandBox from suspended flow()\n    FLOW_SANDBOX-&gt;&gt;+FLOW_SANDBOX: execute Flow @InitiatedBy...()\n                                \n    end\n\n&quot;,&#xa;  &quot;config&quot;: {&#xa;    &quot;theme&quot;: &quot;neutral&quot;,&#xa;    &quot;arrowMarkerAbsolute&quot;: false,&#xa;    &quot;flowchart&quot;: {&#xa;      &quot;htmlLabels&quot;: false&#xa;    },&#xa;    &quot;sequence&quot;: {&#xa;      &quot;diagramMarginX&quot;: 50,&#xa;      &quot;diagramMarginY&quot;: 10,&#xa;      &quot;actorMargin&quot;: 50,&#xa;      &quot;width&quot;: 150,&#xa;      &quot;height&quot;: 65,&#xa;      &quot;boxMargin&quot;: 10,&#xa;      &quot;boxTextMargin&quot;: 5,&#xa;      &quot;noteMargin&quot;: 10,&#xa;      &quot;messageMargin&quot;: 35,&#xa;      &quot;mirrorActors&quot;: true,&#xa;      &quot;bottomMarginAdj&quot;: 1,&#xa;      &quot;useMaxWidth&quot;: true,&#xa;      &quot;rightAngles&quot;: false,&#xa;      &quot;showSequenceNumbers&quot;: false&#xa;    },&#xa;    &quot;gantt&quot;: {&#xa;      &quot;titleTopMargin&quot;: 25,&#xa;      &quot;barHeight&quot;: 20,&#xa;      &quot;barGap&quot;: 4,&#xa;      &quot;topPadding&quot;: 50,&#xa;      &quot;leftPadding&quot;: 75,&#xa;      &quot;gridLineStartPadding&quot;: 35,&#xa;      &quot;fontSize&quot;: 11,&#xa;      &quot;fontFamily&quot;: &quot;\&quot;Open-Sans\&quot;, \&quot;sans-serif\&quot;&quot;,&#xa;      &quot;numberSectionStyles&quot;: 4,&#xa;      &quot;axisFormat&quot;: &quot;%Y-%m-%d&quot;&#xa;    },&#xa;    &quot;securityLevel&quot;: &quot;strict&quot;,&#xa;    &quot;startOnLoad&quot;: false,&#xa;    &quot;themeVariables&quot;: {&#xa;      &quot;primaryColor&quot;: &quot;#eee&quot;,&#xa;      &quot;contrast&quot;: &quot;#707070&quot;,&#xa;      &quot;secondaryColor&quot;: &quot;hsl(0, 0%, 98.9215686275%)&quot;,&#xa;      &quot;background&quot;: &quot;#ffffff&quot;,&#xa;      &quot;tertiaryColor&quot;: &quot;hsl(-160, 0%, 93.3333333333%)&quot;,&#xa;      &quot;primaryBorderColor&quot;: &quot;hsl(0, 0%, 83.3333333333%)&quot;,&#xa;      &quot;secondaryBorderColor&quot;: &quot;hsl(0, 0%, 88.9215686275%)&quot;,&#xa;      &quot;tertiaryBorderColor&quot;: &quot;hsl(-160, 0%, 83.3333333333%)&quot;,&#xa;      &quot;primaryTextColor&quot;: &quot;#111111&quot;,&#xa;      &quot;secondaryTextColor&quot;: &quot;rgb(2.7499999999, 2.7499999999, 2.7499999999)&quot;,&#xa;      &quot;tertiaryTextColor&quot;: &quot;rgb(17.0000000001, 17.0000000001, 17.0000000001)&quot;,&#xa;      &quot;lineColor&quot;: &quot;#666&quot;,&#xa;      &quot;textColor&quot;: &quot;#000000&quot;,&#xa;      &quot;mainBkg&quot;: &quot;#eee&quot;,&#xa;      &quot;secondBkg&quot;: &quot;hsl(0, 0%, 98.9215686275%)&quot;,&#xa;      &quot;border1&quot;: &quot;#999&quot;,&#xa;      &quot;border2&quot;: &quot;#707070&quot;,&#xa;      &quot;note&quot;: &quot;#ffa&quot;,&#xa;      &quot;text&quot;: &quot;#333&quot;,&#xa;      &quot;critical&quot;: &quot;#d42&quot;,&#xa;      &quot;done&quot;: &quot;#bbb&quot;,&#xa;      &quot;arrowheadColor&quot;: &quot;#333333&quot;,&#xa;      &quot;fontFamily&quot;: &quot;\&quot;trebuchet ms\&quot;, verdana, arial, sans-serif&quot;,&#xa;      &quot;fontSize&quot;: &quot;16px&quot;,&#xa;      &quot;THEME_COLOR_LIMIT&quot;: 12,&#xa;      &quot;nodeBkg&quot;: &quot;#eee&quot;,&#xa;      &quot;nodeBorder&quot;: &quot;#999&quot;,&#xa;      &quot;clusterBkg&quot;: &quot;hsl(0, 0%, 98.9215686275%)&quot;,&#xa;      &quot;clusterBorder&quot;: &quot;#707070&quot;,&#xa;      &quot;defaultLinkColor&quot;: &quot;#666&quot;,&#xa;      &quot;titleColor&quot;: &quot;#333&quot;,&#xa;      &quot;edgeLabelBackground&quot;: &quot;white&quot;,&#xa;      &quot;actorBorder&quot;: &quot;hsl(0, 0%, 83%)&quot;,&#xa;      &quot;actorBkg&quot;: &quot;#eee&quot;,&#xa;      &quot;actorTextColor&quot;: &quot;#333&quot;,&#xa;      &quot;actorLineColor&quot;: &quot;#666&quot;,&#xa;      &quot;signalColor&quot;: &quot;#333&quot;,&#xa;      &quot;signalTextColor&quot;: &quot;#333&quot;,&#xa;      &quot;labelBoxBkgColor&quot;: &quot;#eee&quot;,&#xa;      &quot;labelBoxBorderColor&quot;: &quot;hsl(0, 0%, 83%)&quot;,&#xa;      &quot;labelTextColor&quot;: &quot;#333&quot;,&#xa;      &quot;loopTextColor&quot;: &quot;#333&quot;,&#xa;      &quot;noteBorderColor&quot;: &quot;#999&quot;,&#xa;      &quot;noteBkgColor&quot;: &quot;#666&quot;,&#xa;      &quot;noteTextColor&quot;: &quot;#fff&quot;,&#xa;      &quot;activationBorderColor&quot;: &quot;#666&quot;,&#xa;      &quot;activationBkgColor&quot;: &quot;#f4f4f4&quot;,&#xa;      &quot;sequenceNumberColor&quot;: &quot;white&quot;,&#xa;      &quot;sectionBkgColor&quot;: &quot;hsl(0, 0%, 73.9215686275%)&quot;,&#xa;      &quot;altSectionBkgColor&quot;: &quot;white&quot;,&#xa;      &quot;sectionBkgColor2&quot;: &quot;hsl(0, 0%, 73.9215686275%)&quot;,&#xa;      &quot;excludeBkgColor&quot;: &quot;#eeeeee&quot;,&#xa;      &quot;taskBorderColor&quot;: &quot;hsl(0, 0%, 33.9215686275%)&quot;,&#xa;      &quot;taskBkgColor&quot;: &quot;#707070&quot;,&#xa;      &quot;taskTextLightColor&quot;: &quot;white&quot;,&#xa;      &quot;taskTextColor&quot;: &quot;white&quot;,&#xa;      &quot;taskTextDarkColor&quot;: &quot;#333&quot;,&#xa;      &quot;taskTextOutsideColor&quot;: &quot;#333&quot;,&#xa;      &quot;taskTextClickableColor&quot;: &quot;#003163&quot;,&#xa;      &quot;activeTaskBorderColor&quot;: &quot;hsl(0, 0%, 33.9215686275%)&quot;,&#xa;      &quot;activeTaskBkgColor&quot;: &quot;#eee&quot;,&#xa;      &quot;gridColor&quot;: &quot;hsl(0, 0%, 90%)&quot;,&#xa;      &quot;doneTaskBkgColor&quot;: &quot;#bbb&quot;,&#xa;      &quot;doneTaskBorderColor&quot;: &quot;#666&quot;,&#xa;      &quot;critBkgColor&quot;: &quot;#d42&quot;,&#xa;      &quot;critBorderColor&quot;: &quot;hsl(10.9090909091, 73.3333333333%, 40%)&quot;,&#xa;  