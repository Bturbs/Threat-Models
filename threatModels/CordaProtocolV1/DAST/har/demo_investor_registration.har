ument type\",\n        \"changeCountryAndDocType\" : \"Use the {newIdDocType} ({newCountry}), or upload your {oldIdDocType} ({oldCountry}) again?\",\n        \"changeCountryTitle\" : \"Change country\",\n        \"changeCountry\" : \"Use the document ({newCountry}), or upload yours ({oldCountry}) again?\",\n        \"changeDocTypeTitle\" : \"Change document type\",\n        \"changeDocType\" : \"Use this {newIdDocType}, or upload your {oldIdDocType} again?\",\n        \"changeCountryAndDocTypeButtons\" : {\n          \"uploadAgain\" : \"Upload again\",\n          \"continue\" : \"Continue\"\n        }\n      },\n      \"camera\" : {\n        \"photoPage\" : \"Photo page\",\n        \"frontSideTitle\" : \"Front side\",\n        \"backSideTitle\" : \"Back side\",\n        \"uploadButtonLabel\" : \"Upload file\",\n        \"switchButtonLabel\" : \"Switch camera\",\n        \"captureButtonLabel\" : \"Take a photo\",\n        \"cameraFrontLabel\" : \"Front camera {index}\",\n        \"cameraBackLabel\" : \"Back camera {index}\",\n        \"cameraUnknownLabel\" : \"Camera {index}\",\n        \"cameraFrontGroupLabel\" : \"Front\",\n        \"cameraBackGroupLabel\" : \"Back\",\n        \"cameraUnknownGroupLabel\" : \"Other\"\n      },\n      \"frozenSession\" : {\n        \"title\" : \"Your verification is on another device\",\n        \"textWithDevice\" : \"Your verification is in progress on {device}.\",\n        \"caption\" : \"You can finish it here or continue on the other device to complete the process.\",\n        \"captionToOtherDevice\" : \"Continue on that device or switch to another.\",\n        \"continueButtonLabel\" : \"Continue here\",\n        \"continueOnOtherDeviceButtonLabel\" : \"Continue on other device\"\n      },\n      \"continueOnMobile\" : {\n        \"title\" : \"Continue verification on your phone\",\n        \"subtitle\" : \"Scan QR code with your mobile phone camera\",\n        \"copyLinkHeader\" : \"Copy link to open in mobile browser\",\n    