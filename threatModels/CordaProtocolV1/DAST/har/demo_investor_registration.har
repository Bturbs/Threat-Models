itle\" : \"Use a stable Internet connection\"\n          } ]\n        } ]\n      }\n    },\n    \"supportedLanguages\" : {\n      \"en\" : \"English\",\n      \"ru\" : \"Russian\",\n      \"es\" : \"Spanish\",\n      \"et\" : \"Estonian\",\n      \"pt-br\" : \"Portuguese (Brazilian)\",\n      \"zh-tw\" : \"Chinese Traditional\",\n      \"de\" : \"German\",\n      \"pt\" : \"Portuguese\",\n      \"hu\" : \"Hungarian\",\n      \"zh\" : \"Chinese Simplified\",\n      \"th\" : \"Thai\",\n      \"id\" : \"Indonesian\",\n      \"tr\" : \"Turkish\",\n      \"vi\" : \"Vietnamese\",\n      \"ar\" : \"Arabic\",\n      \"hi\" : \"Hindi\",\n      \"ms\" : \"Malay\",\n      \"ur\" : \"Urdu\",\n      \"bn\" : \"Bengali\",\n      \"fl\" : \"Filipino\",\n      \"fr\" : \"French\",\n      \"ja\" : \"Japanese\",\n      \"ko\" : \"Korean\",\n      \"uk\" : \"Ukrainian\",\n      \"ro\" : \"Romanian\",\n      \"cs\" : \"Czech\",\n      \"it\" : \"Italian\",\n      \"nl\" : \"Dutch\",\n      \"pl\" : \"Polish\",\n      \"my\" : \"Burmese\",\n      \"lo\" : \"Lao\",\n      \"km\" : \"Central Khmer\",\n      \"bg\" : \"Bulgarian\",\n      \"el\" : \"Greek\",\n      \"hy\" : \"Armenian\",\n      \"lt\" : \"Lithuanian\",\n      \"sk\" : \"Slovak\",\n      \"da\" : \"Danish\",\n      \"lv\" : \"Latvian\",\n      \"fa\" : \"Farsi\",\n      \"ka\" : \"Georgian\",\n      \"sv\" : \"Swedish\",\n      \"he\" : \"Hebrew\",\n      \"si\" : \"Sinhala\",\n      \"am\" : \"Amharic\",\n      \"no\" : \"Norwegian\",\n      \"sr\" : \"Serbian\",\n      \"sw\" : \"Swahili\",\n      \"zu\" : \"Zulu\",\n      \"ha\" : \"Hausa\",\n      \"az\" : \"Azerbaijani\",\n      \"uz\" : \"Uzbek\",\n      \"hr\" : \"Croatian\",\n      \"kk\" : \"Kazakh\",\n      \"fi\" : \"Finnish\",\n      \"sl\" : \"Slovenian\",\n      \"tg\" : \"Tajik\",\n      \"ca\" : \"Catalan\"\n    },\n    \"restrictions\" : {\n      \"vpn\" : {\n        \"title\" : \"Using a VPN?\",\n        \"subtitle\" : \"It looks like a VPN or similar service is on. Please turn it off and reload the page to continue.\"\n      },\n      \"country\" : {\n        \"title\" : \"Verification isn't available in your country\",\n        \"subtitle\" : \"Verification can't be completed based on your current location\"\n      }\n    },\n    \"liveness\" : {\n      \"suggestions\" : {\n        \"multiplePeople\" : {\n          \"title\" : \"Make sure you’re alone in the frame\",\n          \"tips\" : [ \"Ensure no one else appears in the background\", \"Avoid photos or images of people near the camera\" ]\n        },\n        \"incorrectPosition\" : {\n          \"title\" : \"Adjust your face position\",\n          \"tips\" : [ \"Ensure your face is centered in the frame\", \"Keep your whole head visible\", \"Look straight at the camera\", \"Stay at a comfortable distance\" ]\n        },\n        \"poorLighting\" : {\n          \"title\" : \"Improve your lighting\",\n          \"tips\" : [ \"Use a well-lit room\", \"Avoid bright light behind you\", \"Make sure your face is evenly lit\" ]\n        },\n        \"motionBlur\" : {\n          \"title\" : \"Hold still for a clear image\",\n          \"tips\" : [ \"Keep your head steady\", \"Move slowly when prompted\", \"Make sure your device is stable\" ]\n        },\n        \"inappropriateExpression\" : {\n          \"title\" : \"Keep a neutral expression\",\n          \"tips\" : [ \"Relax your face and keep your eyes open\", \"Avoid smiling, frowning, or talking during the check\" ]\n        },\n        \"faceObstructed\" : {\n          \"title\" : \"Make sure your face is fully visible\",\n          \"tips\" : [ \"Remove any covering from your face\", \"Move your hair away from your eyes\", \"Ensure the camera has an unobstructed view\" ]\n        },\n        \"wearingSunglasses\" : {\n          \"title\" : \"Remove sunglasses\",\n          \"tips\" : [ \"Remove your sunglasses or tinted lenses\", \"Keep your eyes clearly visible\", \"Clear prescription glasses are fine\" ]\n  