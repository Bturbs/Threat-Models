        <mxCell id="qHVov0-bhh_Yzi4WCpuj-55" value="Do we monitor scanners/external tools access? e.g. upgraders, anything having an access key go the repo, esecially 3rd party" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#e1d5e7;strokeColor=#9673a6;position2=0.46;opacity=70;base=25;size=82;position=0.49;" vertex="1" parent="qHVov0-bhh_Yzi4WCpuj-38">
